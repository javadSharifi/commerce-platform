# infrastructure/psychology/Caddyfile
# Reverse Proxy & Edge TLS Configuration for Multi-Tenant Psychology Platform
{
	admin off
	email {$SSL_EMAIL:admin@psychology.local}
}

:80, :443 {
	# ---------------- Security Headers ----------------
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ---------------- Static Assets CDN Caching ----------------
	# Static build assets and bundles are immutable and aggressively cached by CDN / browser
	@static {
		path /_astro/* /assets/* /favicon.ico /robots.txt
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# ---------------- Private & Dynamic No-Store Policy ----------------
	# Private admin data, account, checkout, appointments, streams, and callbacks MUST NOT enter shared/CDN caches
	@private {
		path /admin* /account* /buyer* /appointments* /checkout* /callbacks* /preview* /v1/admin/* /v1/account/* /v1/callbacks* /v1/public/appointments* /public/media/*/stream* /public/media/*/stream-url /public/workshops/registrations/*
	}
	header @private {
		Cache-Control "no-store, no-cache, must-revalidate, private"
		Pragma "no-cache"
	}

	# ---------------- Backend API Routing ----------------
	# Forward API routes, media streams, and payment callbacks directly to Go API server
	# Note: Account frontend pages (/account/*) belong to Astro site, whereas API routes are under /v1/*
	@api {
		path /v1/* /callbacks/* /public/workshops* /public/blog* /public/media* /public/courses* /public/therapists* /public/appointments* /admin/workshops* /admin/blog* /admin/media* /admin/payments* /admin/site* /admin/auth* /admin/courses* /admin/appointments*
	}
	handle @api {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ---------------- Admin Panel Routing ----------------
	# Dedicated admin panel routes: All traffic on panel.* and admin.* domains (excluding @api above) routes to admin panel
	@admin {
		host panel.* admin.*
	}
	handle @admin {
		reverse_proxy admin:4321 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ---------------- Clinic Storefront (Default) ----------------
	# All other storefront requests are handled by Astro SSR site per request Host
	handle {
		reverse_proxy site:4322 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
