# infrastructure/psychology/.env.example
# Production Environment Configuration Template

# ---------------- PostgreSQL Database ----------------
# Separate admin credentials for migration/backups
POSTGRES_DB=psychology_prod
POSTGRES_USER=psychology_admin
DB_ADMIN_PASSWORD=change_this_to_a_strong_random_admin_password_123

# Application-level user with restricted privileges and forced RLS
APP_DB_USER=app_user
DB_APP_PASSWORD=change_this_to_a_strong_random_app_password_456
DATABASE_URL=postgres://app_user:change_this_to_a_strong_random_app_password_456@postgres:5432/psychology_prod?sslmode=disable

# ---------------- Application Ports & Hosts ----------------
PORT=8080
# Server-side API URL for SSR containers
INTERNAL_API_URL=http://api:8080
# Client-side API URL (empty string for relative path /v1 via Caddy reverse proxy)
PUBLIC_API_URL=
ADMIN_PORT=4321
SITE_PORT=4322

# ---------------- S3 / Parspack Storage Credentials ----------------
# Private bucket on Parspack (or ArvanCloud S3) with separate access credentials
PARSPACK_S3_ENDPOINT=https://s3.ir-tbz-sh1.arvanstorage.ir
PARSPACK_S3_BUCKET=psychology-media-production
PARSPACK_REGION=ir-tbz-sh1
PARSPACK_ACCESS_KEY=your_parspack_or_s3_access_key_here
PARSPACK_SECRET_KEY=your_parspack_or_s3_secret_key_here

# ---------------- ZarinPal Payment Gateway ----------------
# Dedicated merchant ID for pilot clinics
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false

# ---------------- Security & Auth ----------------
# High-entropy random secret for session cookies and CSRF validation
SESSION_SECRET=generate_64_character_hex_or_base64_secret_here

# ---------------- Caddy Edge & TLS ----------------
SSL_EMAIL=ops@clinic-domain.ir
