{
  "name": "psychology-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:psychology-site": "pnpm --filter psychology-site dev",
    "dev:psychology-admin": "pnpm --filter psychology-admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:psychology": "pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.12.1"
}
