---
import AdminLayout from '../layouts/AdminLayout.astro';
import type { TenantMetricsReport } from '@psychology/api-client';
import { Button } from '@psychology/ui';

const fallbackMetrics: TenantMetricsReport = {
  tenant_id: 'default',
  generated_at: new Date().toISOString(),
  workshops: {
    total_workshops: 2,
    published_workshops: 2,
    draft_workshops: 0,
    closed_workshops: 0,
    cancelled_workshops: 0,
    total_registrations: 28,
    confirmed_registrations: 25,
    pending_registrations: 2,
    cancelled_registrations: 1,
  },
  booking: {
    active_therapists: 2,
    total_slots: 36,
    available_slots: 14,
    booked_slots: 18,
    held_slots: 4,
    total_appointments: 22,
    confirmed_appointments: 18,
    pending_appointments: 3,
    completed_appointments: 15,
    cancelled_appointments: 1,
  },
  courses: {
    total_courses: 2,
    published_courses: 2,
    draft_courses: 0,
    archived_courses: 0,
    total_lessons: 12,
    total_entitlements: 34,
    active_entitlements: 33,
    revoked_entitlements: 1,
    pending_entitlements: 0,
  },
  financial: {
    total_purchases: 59,
    completed_purchases: 56,
    pending_purchases: 2,
    failed_purchases: 1,
    refund_required_purchases: 0,
    refunded_purchases: 1,
    gross_revenue_rials: 295000000,
    total_refunded_rials: 5000000,
    net_revenue_rials: 290000000,
    workshop_revenue_rials: 125000000,
    course_revenue_rials: 170000000,
  },
  payment_attempts: {
    total_attempts: 62,
    initiated_attempts: 62,
    verified_attempts: 56,
    failed_attempts: 6,
  },
  media: {
    total_assets: 14,
    total_bytes: 1610612736, // ~1.5 GiB
    storage_quota_bytes: 10737418240, // 10 GiB
    usage_percentage_permille: 150,
    usage_percentage: 15,
    public_bytes: 104857600,
    course_private_bytes: 1505755136,
    video_count: 8,
    audio_count: 4,
    image_count: 2,
  },
};

let metrics: TenantMetricsReport = fallbackMetrics;

const apiBaseUrl = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const sessionToken = Astro.cookies.get('session_token')?.value;
const host = Astro.request.headers.get('host') || 'localhost:3001';

if (sessionToken) {
  try {
    const res = await fetch(`${apiBaseUrl}/v1/admin/reports/metrics`, {
      headers: {
        Host: host,
        Cookie: `session_token=${sessionToken}`,
        'X-Tenant-ID': Astro.cookies.get('tenant_id')?.value || '',
      },
    });
    if (res.ok) {
      metrics = await res.json();
    }
  } catch {
    // Keep fallback metrics for preview
  }
}

function formatPriceToman(priceRials: number) {
  const toman = Math.floor(priceRials / 10);
  return `${toman.toLocaleString('fa-IR')} تومان`;
}

function formatBytes(bytes: number) {
  if (bytes === 0) return '۰ بایت';
  const k = 1024;
  const sizes = ['بایت', 'کیلوبایت', 'مگابایت', 'گیگابایت'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  const val = Math.round((bytes / Math.pow(k, i)) * 10) / 10;
  return `${val.toLocaleString('fa-IR')} ${sizes[i]}`;
}
---

<AdminLayout title="داشبورد و شاخص‌های کلینیک" currentNav="dashboard">
  <!-- هدر آمار مالی و شاخص‌های کلان -->
  <div class="mb-8">
    <div class="flex justify-between items-center mb-4 flex-wrap gap-2">
      <h2 class="text-xl font-bold text-base-content">
        شاخص‌های کلان کلینیک (غیرشخصی)
      </h2>
      <span class="badge badge-ghost badge-sm text-xs text-base-content/70">
        محافظت کامل از داده‌های فردی و پزشکی (Zero PII)
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- فروش خالص -->
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-success rounded-box p-5 shadow-xs">
        <div class="text-xs text-base-content/70 mb-1">درآمد خالص کلینیک</div>
        <div class="text-2xl font-bold text-base-content">
          {formatPriceToman(metrics.financial.net_revenue_rials)}
        </div>
        <div class="text-xs text-base-content/60 mt-1.5">
          پس از کسر {formatPriceToman(metrics.financial.total_refunded_rials)} استرداد
        </div>
      </div>

      <!-- تفکیک فروش کارگاه و دوره -->
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-primary rounded-box p-5 shadow-xs">
        <div class="text-xs text-base-content/70 mb-1">فروش کارگاه‌ها و دوره‌ها</div>
        <div class="text-sm font-bold text-primary">
          کارگاه: {formatPriceToman(metrics.financial.workshop_revenue_rials)}
        </div>
        <div class="text-sm font-bold text-secondary mt-1">
          دوره: {formatPriceToman(metrics.financial.course_revenue_rials)}
        </div>
      </div>

      <!-- نوبت‌های حضوری -->
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-secondary rounded-box p-5 shadow-xs">
        <div class="text-xs text-base-content/70 mb-1">نوبت‌های حضوری</div>
        <div class="text-2xl font-bold text-base-content">
          {metrics.booking.confirmed_appointments.toLocaleString('fa-IR')} نوبت تأییدشده
        </div>
        <div class="text-xs text-base-content/60 mt-1.5">
          {metrics.booking.active_therapists.toLocaleString('fa-IR')} درمانگر فعال · {metrics.booking.available_slots.toLocaleString('fa-IR')} سانس آزاد
        </div>
      </div>

      <!-- مصرف رسانه و فضای ابری -->
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-warning rounded-box p-5 shadow-xs">
        <div class="flex justify-between items-baseline mb-1">
          <span class="text-xs text-base-content/70">سهمیه رسانه و فایل</span>
          <span class="text-xs font-bold text-warning">
            {metrics.media.usage_percentage.toLocaleString('fa-IR')}٪ مصرف‌شده
          </span>
        </div>
        <div class="text-xl font-bold text-base-content">
          {formatBytes(metrics.media.total_bytes)}
        </div>
        <!-- Progress bar -->
        <progress
          class="progress progress-warning w-full mt-2"
          value={metrics.media.usage_percentage}
          max="100"
        ></progress>
        <div class="text-xs text-base-content/60 mt-1">
          سقف مجاز: {formatBytes(metrics.media.storage_quota_bytes)}
        </div>
      </div>
    </div>
  </div>

  <!-- کارت‌های تفصیلی و وضعیت شاخص‌ها -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- وضعیت کارگاه‌ها و آموزش -->
    <div class="card bg-base-100 border border-base-200 rounded-box p-6 shadow-xs">
      <h3 class="text-base font-bold text-base-content mb-4 pb-2 border-b border-base-200">
        کارگاه‌های حضوری و دوره‌های ضبط‌شده
      </h3>
      <div class="flex flex-col gap-3 text-sm">
        <div class="flex justify-between">
          <span class="text-base-content/70">کل کارگاه‌ها (منتشرشده / پیش‌نویس):</span>
          <span class="font-bold text-base-content">
            {metrics.workshops.total_workshops.toLocaleString('fa-IR')} ({metrics.workshops.published_workshops.toLocaleString('fa-IR')} / {metrics.workshops.draft_workshops.toLocaleString('fa-IR')})
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">کل ثبت‌نام‌کنندگان کارگاه:</span>
          <span class="font-bold text-base-content">
            {metrics.workshops.total_registrations.toLocaleString('fa-IR')} نفر ({metrics.workshops.confirmed_registrations.toLocaleString('fa-IR')} قطعی)
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">کل دوره‌های آموزشی:</span>
          <span class="font-bold text-base-content">
            {metrics.courses.total_courses.toLocaleString('fa-IR')} دوره ({metrics.courses.total_lessons.toLocaleString('fa-IR')} جلسه فعال)
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">دانشجویان دارای دسترسی به دوره:</span>
          <span class="font-bold text-base-content">
            {metrics.courses.active_entitlements.toLocaleString('fa-IR')} نفر ({metrics.courses.revoked_entitlements.toLocaleString('fa-IR')} لغو دسترسی)
          </span>
        </div>
      </div>
    </div>

    <!-- وضعیت پرداخت و نوبت‌دهی -->
    <div class="card bg-base-100 border border-base-200 rounded-box p-6 shadow-xs">
      <h3 class="text-base font-bold text-base-content mb-4 pb-2 border-b border-base-200">
        عملکرد درگاه و نوبت‌دهی روان‌درمانی
      </h3>
      <div class="flex flex-col gap-3 text-sm">
        <div class="flex justify-between">
          <span class="text-base-content/70">کل تلاش‌های پرداخت به درگاه:</span>
          <span class="font-bold text-base-content">
            {metrics.payment_attempts.total_attempts.toLocaleString('fa-IR')} مرتبه ({metrics.payment_attempts.verified_attempts.toLocaleString('fa-IR')} موفق · {metrics.payment_attempts.failed_attempts.toLocaleString('fa-IR')} ناموفق)
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">تراکنش‌های نیازمند بازپرداخت:</span>
          <span class={`font-bold ${metrics.financial.refund_required_purchases > 0 ? 'text-error' : 'text-success'}`}>
            {metrics.financial.refund_required_purchases.toLocaleString('fa-IR')} سفارش
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">جلسات مشاوره تکمیل‌شده:</span>
          <span class="font-bold text-base-content">
            {metrics.booking.completed_appointments.toLocaleString('fa-IR')} جلسه
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">نوبت‌های لغوشده کلینیک:</span>
          <span class="font-bold text-base-content/70">
            {metrics.booking.cancelled_appointments.toLocaleString('fa-IR')} نوبت
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- دسترسی‌های سریع -->
  <div class="card bg-base-100 border border-base-200 rounded-box p-6 shadow-xs">
    <h2 class="text-base font-bold text-base-content mb-4">
      دسترسی‌های سریع به بخش‌های پنل
    </h2>
    <div class="flex gap-3 flex-wrap">
      <a href="/workshops">
        <Button variant="secondary" size="sm">مدیریت کارگاه‌ها ←</Button>
      </a>
      <a href="/appointments">
        <Button variant="secondary" size="sm">تقویم و نوبت‌ها ←</Button>
      </a>
      <a href="/courses">
        <Button variant="secondary" size="sm">دوره‌ها و جلسات ضبط‌شده ←</Button>
      </a>
      <a href="/payments">
        <Button variant="secondary" size="sm">تراکنش‌ها و استرداد وجه ←</Button>
      </a>
      <a href="/settings">
        <Button variant="primary" size="sm">تنظیمات و دامنه مطب ←</Button>
      </a>
    </div>
  </div>
</AdminLayout>
