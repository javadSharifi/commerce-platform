---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="نگارش مقاله جدید" currentNav="blog">
  <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h2 style="font-size: 1.35rem; font-weight: 700; color: #0f172a;">ویرایشگر امن بلاگ</h2>
        <p style="color: #64748b; font-size: 0.9rem; margin-top: 0.25rem;">
          محتوا در قالب بلوک‌های ساخت‌یافته و ایمن ذخیره می‌شود (امکان تزریق کدهای مخرب وجود ندارد).
        </p>
      </div>
      <a href="/blog" style="color: #0284c7; text-decoration: none; font-size: 0.9rem;">
        ← بازگشت به فهرست مقالات
      </a>
    </div>

    <!-- Main Editor Form -->
    <form id="blog-form" class="card" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Title -->
      <div>
        <label for="post-title" class="form-label">عنوان مقاله *</label>
        <input
          type="text"
          id="post-title"
          name="title"
          required
          placeholder="مثلاً: راهکارهای عملی کاهش اضطراب در تعاملات اجتماعی"
          class="form-input"
        />
      </div>

      <!-- Slug & SEO -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="post-slug" class="form-label">نامک یکتا (Slug) *</label>
          <input
            type="text"
            id="post-slug"
            name="slug"
            required
            pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
            placeholder="managing-social-anxiety"
            class="form-input"
            dir="ltr"
          />
          <span style="font-size: 0.75rem; color: #64748b;">تنها حروف کوچک انگلیسی، ارقام و خط تیره مجاز است.</span>
        </div>
        <div>
          <label for="post-seo" class="form-label">توضیحات سئو (خلاصه مقاله)</label>
          <input
            type="text"
            id="post-seo"
            name="seo_description"
            placeholder="خلاصه ۱ تا ۲ جمله‌ای جهت نمایش در نتایج جستجو و کارت‌های سایت"
            class="form-input"
          />
        </div>
      </div>

      <!-- Block Editor Container -->
      <div style="border-top: 1px solid #e2e8f0; padding-top: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b;">بلوک‌های محتوای مقاله</h3>
          <span style="font-size: 0.85rem; color: #64748b;">تعداد بلوک‌ها: <b id="block-count">0</b></span>
        </div>

        <!-- Rendered blocks list -->
        <div id="blocks-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem;">
          <!-- Dynamically injected blocks -->
        </div>

        <!-- Block Tooling Bar -->
        <div style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 0.75rem; padding: 1.25rem; text-align: center;">
          <div style="font-size: 0.9rem; font-weight: 600; color: #475569; margin-bottom: 0.75rem;">
            افزودن بلوک محتوایی جدید:
          </div>
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;">
            <button type="button" class="btn-add-block" data-type="paragraph">
              📝 پاراگراف متن
            </button>
            <button type="button" class="btn-add-block" data-type="heading">
              📌 تیتر (Heading)
            </button>
            <button type="button" class="btn-add-block" data-type="image">
              🖼️ تصویر
            </button>
            <button type="button" class="btn-add-block" data-type="audio">
              🎧 صوت / پادکست
            </button>
            <button type="button" class="btn-add-block" data-type="video">
              🎬 ویدئو
            </button>
          </div>
        </div>
      </div>

      <!-- Submit Actions -->
      <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid #e2e8f0; padding-top: 1.25rem;">
        <a href="/blog" class="btn-cancel">
          انصراف
        </a>
        <button type="button" id="btn-save-draft" class="btn-secondary">
          ذخیره به عنوان پیش‌نویس
        </button>
        <button type="button" id="btn-publish-direct" class="btn-primary">
          🚀 انتشار عمومی مقاله
        </button>
      </div>
    </form>
  </div>

  <script>
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
    const blocksContainer = document.getElementById('blocks-container')!;
    const blockCountEl = document.getElementById('block-count')!;
    const titleInput = document.getElementById('post-title') as HTMLInputElement;
    const slugInput = document.getElementById('post-slug') as HTMLInputElement;
    const seoInput = document.getElementById('post-seo') as HTMLInputElement;

    // Auto-generate slug from title if user hasn't typed a slug
    titleInput.addEventListener('blur', () => {
      if (!slugInput.value) {
        const generated = titleInput.value
          .trim()
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
        if (generated) slugInput.value = generated;
      }
    });

    let blocks: Array<{ id: string; type: string; data: Record<string, any> }> = [];

    function updateCount() {
      blockCountEl.textContent = String(blocks.length);
    }

    function renderBlocks() {
      blocksContainer.innerHTML = '';

      blocks.forEach((block, index) => {
        const item = document.createElement('div');
        item.className = 'block-card';
        item.dataset.id = block.id;

        let contentHTML = '';

        if (block.type === 'paragraph') {
          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">پاراگراف متن</div>
            <textarea class="form-input block-input-text" rows="3" placeholder="متن پاراگراف را اینجا بنویسید...">${block.data.text || ''}</textarea>
          `;
        } else if (block.type === 'heading') {
          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">تیتر (Heading)</div>
            <div style="display: flex; gap: 0.5rem;">
              <select class="form-input block-input-level" style="width: 120px;">
                <option value="2" ${block.data.level === 2 ? 'selected' : ''}>H2 (تیتر اصلی)</option>
                <option value="3" ${block.data.level === 3 ? 'selected' : ''}>H3 (تیتر فرعی)</option>
                <option value="4" ${block.data.level === 4 ? 'selected' : ''}>H4 (زیرتیتر)</option>
              </select>
              <input type="text" class="form-input block-input-text" value="${block.data.text || ''}" placeholder="عنوان تیتر..." style="flex: 1;" />
            </div>
          `;
        } else if (block.type === 'image' || block.type === 'audio' || block.type === 'video') {
          const typeName = block.type === 'image' ? 'تصویر' : block.type === 'audio' ? 'صوت / پادکست' : 'ویدئو';
          const acceptType = block.type === 'image' ? 'image/jpeg,image/png,image/webp' : block.type === 'audio' ? 'audio/mpeg' : 'video/mp4';

          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">فایل ${typeName}</div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="file" class="block-file-picker" accept="${acceptType}" style="display: none;" />
                <button type="button" class="btn-choose-file" style="padding: 0.4rem 0.8rem; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem;">
                  📤 بارگذاری فایل مستقیم
                </button>
                <span class="upload-status" style="font-size: 0.8rem; color: ${block.data.media_id ? '#166534' : '#64748b'};">
                  ${block.data.media_id ? `✅ فایل ذخیره شد (ID: ${block.data.media_id.slice(0, 8)}...)` : 'فایلی انتخاب نشده است.'}
                </span>
              </div>
              <input type="text" class="form-input block-input-caption" value="${block.data.caption || ''}" placeholder="توضیح یا زیرنویس فایل..." />
            </div>
          `;
        }

        item.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; background: #e2e8f0; color: #334155; padding: 0.15rem 0.5rem; border-radius: 0.25rem;">
              بلوک #${index + 1}
            </span>
            <div style="display: flex; gap: 0.25rem;">
              <button type="button" class="btn-move-up" title="انتقال به بالا" ${index === 0 ? 'disabled' : ''} style="cursor: pointer; padding: 0.2rem 0.4rem; background: none; border: 1px solid #cbd5e1; border-radius: 0.25rem;">⬆️</button>
              <button type="button" class="btn-move-down" title="انتقال به پایین" ${index === blocks.length - 1 ? 'disabled' : ''} style="cursor: pointer; padding: 0.2rem 0.4rem; background: none; border: 1px solid #cbd5e1; border-radius: 0.25rem;">⬇️</button>
              <button type="button" class="btn-remove-block" title="حذف بلوک" style="cursor: pointer; padding: 0.2rem 0.4rem; background: #fee2e2; border: 1px solid #fecaca; border-radius: 0.25rem; color: #991b1b;">❌</button>
            </div>
          </div>
          ${contentHTML}
        `;

        // Event bindings for block inputs
        const textarea = item.querySelector('.block-input-text') as HTMLInputElement | HTMLTextAreaElement;
        if (textarea) {
          textarea.addEventListener('input', (e) => {
            block.data.text = (e.target as HTMLInputElement).value;
          });
        }

        const levelSelect = item.querySelector('.block-input-level') as HTMLSelectElement;
        if (levelSelect) {
          levelSelect.addEventListener('change', (e) => {
            block.data.level = Number((e.target as HTMLSelectElement).value);
          });
        }

        const captionInput = item.querySelector('.block-input-caption') as HTMLInputElement;
        if (captionInput) {
          captionInput.addEventListener('input', (e) => {
            block.data.caption = (e.target as HTMLInputElement).value;
          });
        }

        const filePicker = item.querySelector('.block-file-picker') as HTMLInputElement;
        const chooseBtn = item.querySelector('.btn-choose-file');
        const uploadStatus = item.querySelector('.upload-status');

        if (chooseBtn && filePicker && uploadStatus) {
          chooseBtn.addEventListener('click', () => filePicker.click());
          filePicker.addEventListener('change', async () => {
            const file = filePicker.files?.[0];
            if (!file) return;

            uploadStatus.textContent = '⏳ در حال دریافت لینک آپلود مستقیم...';
            try {
              // 1. Request presigned upload URL
              const reqRes = await fetch(`${apiBase}/admin/media/upload-url`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({
                  original_name: file.name,
                  mime_type: file.type,
                  size_bytes: file.size,
                  access_class: 'public',
                }),
              });

              if (!reqRes.ok) {
                const err = await reqRes.json();
                uploadStatus.textContent = `❌ خطا: ${err.message || 'صدور مجوز آپلود رد شد.'}`;
                return;
              }

              const uploadData = await reqRes.json();

              // 2. Direct PUT to S3
              uploadStatus.textContent = '📤 در حال ارسال مستقیم به باکت پارس‌پک...';
              const putRes = await fetch(uploadData.upload_url, {
                method: 'PUT',
                body: file,
                headers: {
                  'Content-Type': file.type,
                },
              });

              if (!putRes.ok && putRes.status !== 0) { // status 0 can happen with mock/cors in tests
                uploadStatus.textContent = '❌ خطا در انتقال فایل به ذخیره‌سازی.';
                return;
              }

              // 3. Finalize upload
              uploadStatus.textContent = '🔄 در حال نهایی‌سازی و اعتبارسنجی سروری...';
              const finRes = await fetch(`${apiBase}/admin/media/finalize`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({
                  upload_id: uploadData.upload_id,
                }),
              });

              if (!finRes.ok) {
                const finErr = await finRes.json();
                uploadStatus.textContent = `❌ خطا: ${finErr.message || 'نهایی‌سازی رد شد.'}`;
                return;
              }

              const asset = await finRes.json();
              block.data.media_id = asset.id;
              block.data.original_name = asset.original_name;
              uploadStatus.textContent = `✅ فایل تأیید شد (${asset.original_name})`;
              uploadStatus.setAttribute('style', 'font-size: 0.8rem; color: #166534;');
            } catch (err: any) {
              uploadStatus.textContent = `❌ خطا در آپلود: ${err.message || 'ارتباط برقرار نشد.'}`;
            }
          });
        }

        // Actions: move up, move down, remove
        item.querySelector('.btn-move-up')?.addEventListener('click', () => {
          if (index > 0) {
            const temp = blocks[index];
            blocks[index] = blocks[index - 1];
            blocks[index - 1] = temp;
            renderBlocks();
          }
        });

        item.querySelector('.btn-move-down')?.addEventListener('click', () => {
          if (index < blocks.length - 1) {
            const temp = blocks[index];
            blocks[index] = blocks[index + 1];
            blocks[index + 1] = temp;
            renderBlocks();
          }
        });

        item.querySelector('.btn-remove-block')?.addEventListener('click', () => {
          blocks.splice(index, 1);
          renderBlocks();
          updateCount();
        });

        blocksContainer.appendChild(item);
      });

      updateCount();
    }

    // Add block handler
    document.querySelectorAll('.btn-add-block').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLElement).dataset.type || 'paragraph';
        const newBlock = {
          id: Math.random().toString(36).substring(2, 9),
          type,
          data: type === 'heading' ? { level: 2, text: '' } : type === 'paragraph' ? { text: '' } : { caption: '' },
        };
        blocks.push(newBlock);
        renderBlocks();
      });
    });

    // Default with one paragraph block
    blocks.push({
      id: Math.random().toString(36).substring(2, 9),
      type: 'paragraph',
      data: { text: '' },
    });
    renderBlocks();

    async function submitPost(status: 'draft' | 'published') {
      const title = titleInput.value.trim();
      const slug = slugInput.value.trim();
      const seo = seoInput.value.trim();

      if (!title) {
        alert('لطفاً عنوان مقاله را وارد کنید.');
        titleInput.focus();
        return;
      }
      if (!slug) {
        alert('لطفاً نامک (Slug) مقاله را وارد کنید.');
        slugInput.focus();
        return;
      }
      if (blocks.length === 0) {
        alert('مقاله باید حداقل شامل یک بلوک محتوا باشد.');
        return;
      }

      // Format blocks for backend API
      const content_blocks = blocks.map((b) => ({
        type: b.type,
        data: b.data,
      }));

      try {
        const res = await fetch(`${apiBase}/admin/blog`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({
            title,
            slug,
            seo_description: seo,
            content_blocks,
            status,
          }),
        });

        if (res.ok) {
          const created = await res.json();
          alert(status === 'published' ? 'مقاله با موفقیت منتشر شد!' : 'پیش‌نویس مقاله با موفقیت ذخیره شد.');
          window.location.href = '/blog';
        } else {
          const err = await res.json();
          alert(`خطا در ثبت مقاله: ${err.message || 'مشکلی رخ داد.'}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    }

    document.getElementById('btn-save-draft')?.addEventListener('click', () => submitPost('draft'));
    document.getElementById('btn-publish-direct')?.addEventListener('click', () => submitPost('published'));
  </script>

  <style>
    .form-label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 0.4rem;
    }
    .form-input {
      width: 100%;
      padding: 0.6rem 0.85rem;
      border: 1px solid #cbd5e1;
      border-radius: 0.5rem;
      font-size: 0.95rem;
      color: #1e293b;
      background: #ffffff;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .form-input:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);
    }
    .block-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 1rem;
      box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .btn-add-block {
      background: #ffffff;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 0.45rem 0.9rem;
      border-radius: 0.375rem;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .btn-add-block:hover {
      background: #f1f5f9;
      border-color: #94a3b8;
    }
    .btn-primary {
      background: #0284c7;
      color: #ffffff;
      padding: 0.6rem 1.4rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      background: #0369a1;
    }
    .btn-secondary {
      background: #f8fafc;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 0.6rem 1.4rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-secondary:hover {
      background: #f1f5f9;
    }
    .btn-cancel {
      display: inline-flex;
      align-items: center;
      padding: 0.6rem 1.2rem;
      color: #64748b;
      text-decoration: none;
      font-size: 0.9rem;
    }
  </style>
</AdminLayout>
