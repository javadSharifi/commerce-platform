---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BlogMetadataFields from '../../components/BlogMetadataFields.astro';
const tenantId = Astro.locals.activeTenant?.id || Astro.cookies.get('tenant_id')?.value || '';
---

<AdminLayout title="نگارش مقاله جدید" currentNav="blog">
  <div class="max-w-4xl mx-auto flex flex-col gap-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-base-content">ویرایشگر امن بلاگ</h2>
        <p class="text-xs text-base-content/70 mt-1">
          محتوا در قالب بلوک‌های ساخت‌یافته و ایمن ذخیره می‌شود (امکان تزریق کدهای مخرب وجود ندارد).
        </p>
      </div>
      <a href="/blog" class="btn btn-ghost btn-xs text-base-content/60">
        ← بازگشت به فهرست مقالات
      </a>
    </div>

    <!-- Main Editor Form -->
    <form id="blog-form" data-tenant-id={tenantId} class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 shadow-xs flex flex-col gap-6">
      <!-- Title -->
      <div>
        <label for="post-title" class="block text-xs font-semibold text-base-content/80 mb-1">
          عنوان مقاله <span class="text-error">*</span>
        </label>
        <input
          type="text"
          id="post-title"
          name="title"
          required
          placeholder="مثلاً: راهکارهای عملی کاهش اضطراب در تعاملات اجتماعی"
          class="input input-bordered input-sm w-full font-bold text-sm"
        />
      </div>

      <!-- Slug & SEO -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="post-slug" class="block text-xs font-semibold text-base-content/80 mb-1">
            نامک یکتا (Slug) <span class="text-error">*</span>
          </label>
          <input
            type="text"
            id="post-slug"
            name="slug"
            required
            pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
            placeholder="managing-social-anxiety"
            class="input input-bordered input-sm w-full font-mono text-xs"
            dir="ltr"
          />
          <span class="text-[11px] text-base-content/60 mt-1 block">تنها حروف کوچک انگلیسی، ارقام و خط تیره مجاز است.</span>
        </div>
        <div>
          <label for="post-seo" class="block text-xs font-semibold text-base-content/80 mb-1">توضیحات سئو (خلاصه مقاله)</label>
          <input
            type="text"
            id="post-seo"
            name="seo_description"
            placeholder="خلاصه ۱ تا ۲ جمله‌ای جهت نمایش در نتایج جستجو و کارت‌های سایت"
            class="input input-bordered input-sm w-full text-xs"
          />
        </div>
      </div>

      <BlogMetadataFields />

      <!-- Block Editor Container -->
      <div class="border-t border-base-200 pt-5">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-sm font-bold text-base-content">بلوک‌های محتوای مقاله</h3>
          <span class="text-xs text-base-content/70">تعداد بلوک‌ها: <b id="block-count">0</b></span>
        </div>

        <!-- Rendered blocks list -->
        <div id="blocks-container" class="flex flex-col gap-4 mb-5">
          <!-- Dynamically injected blocks -->
        </div>

        <!-- Block Tooling Bar -->
        <div class="bg-base-200/50 border-2 border-dashed border-base-300 rounded-box p-5 text-center">
          <div class="text-xs font-semibold text-base-content/70 mb-3">
            افزودن بلوک محتوایی جدید:
          </div>
          <div class="flex flex-wrap justify-center gap-2">
            <button type="button" class="btn btn-ghost btn-xs border border-base-300 font-medium btn-add-block" data-type="paragraph">
              📝 پاراگراف متن
            </button>
            <button type="button" class="btn btn-ghost btn-xs border border-base-300 font-medium btn-add-block" data-type="heading">
              📌 تیتر (Heading)
            </button>
            <button type="button" class="btn btn-ghost btn-xs border border-base-300 font-medium btn-add-block" data-type="image">
              🖼️ تصویر
            </button>
            <button type="button" class="btn btn-ghost btn-xs border border-base-300 font-medium btn-add-block" data-type="audio">
              🎧 صوت / پادکست
            </button>
            <button type="button" class="btn btn-ghost btn-xs border border-base-300 font-medium btn-add-block" data-type="video">
              🎬 ویدئو
            </button>
          </div>
        </div>
      </div>

      <!-- Submit Actions -->
      <div class="flex justify-between items-center border-t border-base-200 pt-5 flex-wrap gap-4">
        <a href="/blog" class="btn btn-ghost btn-sm font-medium">
          انصراف
        </a>
        <div class="flex gap-2">
          <button type="button" id="btn-save-draft" class="btn btn-outline btn-sm font-medium">
            📁 ذخیره به عنوان پیش‌نویس
          </button>
          <button type="button" id="btn-publish-direct" class="btn btn-primary btn-sm font-medium">
            🚀 انتشار مستقیم در سایت
          </button>
        </div>
      </div>
    </form>
  </div>

  <script>
    const apiBase = import.meta.env.PUBLIC_API_URL || '';
    const blogForm = document.getElementById('blog-form') as HTMLFormElement;
    const activeTenantId = blogForm.dataset.tenantId ?? '';
    const blocksContainer = document.getElementById('blocks-container');
    const blockCountEl = document.getElementById('block-count');
    const titleInput = document.getElementById('post-title') as HTMLInputElement;
    const slugInput = document.getElementById('post-slug') as HTMLInputElement;
    const seoInput = document.getElementById('post-seo') as HTMLInputElement;

    interface ContentBlock {
      id: string;
      type: string;
      data: Record<string, any>;
    }

    let blocks: ContentBlock[] = [];

    // Auto slug generator from title
    titleInput?.addEventListener('blur', () => {
      if (!slugInput.value) {
        slugInput.value = titleInput.value
          .trim()
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
    });

    function updateCount() {
      if (blockCountEl) blockCountEl.textContent = String(blocks.length);
    }

    function renderBlocks() {
      if (!blocksContainer) return;
      blocksContainer.replaceChildren();

      blocks.forEach((block, index) => {
        const item = document.createElement('div');
        item.className = 'card bg-base-200/40 border border-base-200 rounded-box p-4 shadow-xs';
        item.dataset.id = block.id;

        const headerDiv = document.createElement('div');
        headerDiv.className = 'flex justify-between items-center mb-2';

        const badge = document.createElement('span');
        badge.className = 'badge badge-ghost badge-xs font-medium';
        badge.textContent = `بلوک #${index + 1}`;
        headerDiv.appendChild(badge);

        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'flex gap-1';

        const btnUp = document.createElement('button');
        btnUp.type = 'button';
        btnUp.className = 'btn-move-up btn btn-ghost btn-xs';
        btnUp.title = 'انتقال به بالا';
        btnUp.textContent = '⬆️';
        if (index === 0) btnUp.disabled = true;
        btnUp.addEventListener('click', () => {
          if (index > 0) {
            const temp = blocks[index];
            blocks[index] = blocks[index - 1];
            blocks[index - 1] = temp;
            renderBlocks();
          }
        });
        actionsDiv.appendChild(btnUp);

        const btnDown = document.createElement('button');
        btnDown.type = 'button';
        btnDown.className = 'btn-move-down btn btn-ghost btn-xs';
        btnDown.title = 'انتقال به پایین';
        btnDown.textContent = '⬇️';
        if (index === blocks.length - 1) btnDown.disabled = true;
        btnDown.addEventListener('click', () => {
          if (index < blocks.length - 1) {
            const temp = blocks[index];
            blocks[index] = blocks[index + 1];
            blocks[index + 1] = temp;
            renderBlocks();
          }
        });
        actionsDiv.appendChild(btnDown);

        const btnRemove = document.createElement('button');
        btnRemove.type = 'button';
        btnRemove.className = 'btn-remove-block btn btn-error btn-ghost btn-xs text-error';
        btnRemove.title = 'حذف بلوک';
        btnRemove.textContent = '❌';
        btnRemove.addEventListener('click', () => {
          blocks.splice(index, 1);
          renderBlocks();
          updateCount();
        });
        actionsDiv.appendChild(btnRemove);

        headerDiv.appendChild(actionsDiv);
        item.appendChild(headerDiv);

        if (block.type === 'paragraph') {
          const typeLabel = document.createElement('div');
          typeLabel.className = 'text-xs font-semibold text-primary mb-1';
          typeLabel.textContent = 'پاراگراف متن';
          item.appendChild(typeLabel);

          const textarea = document.createElement('textarea');
          textarea.className = 'textarea textarea-bordered textarea-sm w-full block-input-text';
          textarea.rows = 3;
          textarea.placeholder = 'متن پاراگراف را اینجا بنویسید...';
          textarea.value = block.data.text || '';
          textarea.addEventListener('input', (e) => {
            block.data.text = (e.target as HTMLTextAreaElement).value;
          });
          item.appendChild(textarea);
        } else if (block.type === 'heading') {
          const typeLabel = document.createElement('div');
          typeLabel.className = 'text-xs font-semibold text-primary mb-1';
          typeLabel.textContent = 'تیتر (Heading)';
          item.appendChild(typeLabel);

          const flexDiv = document.createElement('div');
          flexDiv.className = 'flex gap-2';

          const select = document.createElement('select');
          select.className = 'select select-bordered select-sm w-36 block-input-level';
          [2, 3, 4].forEach((lvl) => {
            const opt = document.createElement('option');
            opt.value = String(lvl);
            opt.textContent = lvl === 2 ? 'H2 (تیتر اصلی)' : lvl === 3 ? 'H3 (تیتر فرعی)' : 'H4 (زیرتیتر)';
            if ((block.data.level || 2) === lvl) opt.selected = true;
            select.appendChild(opt);
          });
          select.addEventListener('change', (e) => {
            block.data.level = Number((e.target as HTMLSelectElement).value);
          });
          flexDiv.appendChild(select);

          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'input input-bordered input-sm flex-1 block-input-text font-bold';
          input.placeholder = 'عنوان تیتر...';
          input.value = block.data.text || '';
          input.addEventListener('input', (e) => {
            block.data.text = (e.target as HTMLInputElement).value;
          });
          flexDiv.appendChild(input);

          item.appendChild(flexDiv);
        } else if (block.type === 'image' || block.type === 'audio' || block.type === 'video') {
          const typeName = block.type === 'image' ? 'تصویر' : block.type === 'audio' ? 'صوت / پادکست' : 'ویدئو';
          const acceptType = block.type === 'image' ? 'image/jpeg,image/png,image/webp' : block.type === 'audio' ? 'audio/mpeg' : 'video/mp4';

          const typeLabel = document.createElement('div');
          typeLabel.className = 'text-xs font-semibold text-primary mb-1';
          typeLabel.textContent = `فایل ${typeName}`;
          item.appendChild(typeLabel);

          const colDiv = document.createElement('div');
          colDiv.className = 'flex flex-col gap-2';

          const rowDiv = document.createElement('div');
          rowDiv.className = 'flex gap-2 items-center';

          const filePicker = document.createElement('input');
          filePicker.type = 'file';
          filePicker.className = 'block-file-picker';
          filePicker.accept = acceptType;
          filePicker.style.display = 'none';
          rowDiv.appendChild(filePicker);

          const chooseBtn = document.createElement('button');
          chooseBtn.type = 'button';
          chooseBtn.className = 'btn btn-outline btn-primary btn-xs btn-choose-file';
          chooseBtn.textContent = '📤 بارگذاری فایل جدید';
          chooseBtn.addEventListener('click', () => filePicker.click());
          rowDiv.appendChild(chooseBtn);

          const uploadStatus = document.createElement('span');
          uploadStatus.className = `upload-status text-xs ${block.data.media_id ? 'text-success font-medium' : 'text-base-content/60'}`;
          uploadStatus.textContent = block.data.media_id ? `✅ فایل متصل است (ID: ${block.data.media_id.slice(0, 8)}...)` : 'فایلی انتخاب نشده است.';
          rowDiv.appendChild(uploadStatus);

          colDiv.appendChild(rowDiv);

          filePicker.addEventListener('change', async () => {
            const file = filePicker.files?.[0];
            if (!file) return;

            uploadStatus.textContent = '⏳ در حال دریافت لینک آپلود مستقیم...';
            try {
              const reqRes = await fetch(`${apiBase}/v1/admin/media/upload-url`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                  'X-Tenant-ID': activeTenantId,
                },
                body: JSON.stringify({
                  original_name: file.name,
                  mime_type: file.type,
                  size_bytes: file.size,
                  access_class: 'public',
                }),
              });

              if (!reqRes.ok) {
                const err = await reqRes.json();
                uploadStatus.textContent = `❌ خطا: ${err.message || 'صدور مجوز آپلود رد شد.'}`;
                return;
              }

              const uploadData = await reqRes.json();
              uploadStatus.textContent = '📤 در حال ارسال فایل...';
              await fetch(uploadData.upload_url, {
                method: 'PUT',
                body: file,
                headers: { 'Content-Type': file.type },
              });

              uploadStatus.textContent = '🔄 در حال نهایی‌سازی...';
              const finRes = await fetch(`${apiBase}/v1/admin/media/finalize`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                  'X-Tenant-ID': activeTenantId,
                },
                body: JSON.stringify({ upload_id: uploadData.upload_id }),
              });

              if (!finRes.ok) {
                uploadStatus.textContent = '❌ خطا در نهایی‌سازی.';
                return;
              }

              const asset = await finRes.json();
              block.data.media_id = asset.id;
              uploadStatus.textContent = `✅ فایل ذخیره شد (${asset.original_name})`;
              uploadStatus.className = 'upload-status text-xs text-success font-medium';
            } catch (err) {
              console.error('Upload error in new blog post:', err);
              uploadStatus.textContent = '❌ خطا در آپلود فایل.';
            }
          });

          const captionInput = document.createElement('input');
          captionInput.type = 'text';
          captionInput.className = 'input input-bordered input-sm w-full block-input-caption text-xs';
          captionInput.placeholder = 'توضیح یا زیرنویس فایل...';
          captionInput.value = block.data.caption || '';
          captionInput.addEventListener('input', (e) => {
            block.data.caption = (e.target as HTMLInputElement).value;
          });
          colDiv.appendChild(captionInput);

          item.appendChild(colDiv);
        }

        blocksContainer.appendChild(item);
      });

      updateCount();
    }

    // Add block listeners
    document.querySelectorAll('.btn-add-block').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLElement).dataset.type || 'paragraph';
        const newBlock: ContentBlock = {
          id: Math.random().toString(36).substring(2, 9),
          type,
          data: type === 'heading' ? { level: 2, text: '' } : type === 'paragraph' ? { text: '' } : { caption: '' },
        };
        blocks.push(newBlock);
        renderBlocks();
      });
    });

    // Default with one paragraph block
    blocks.push({
      id: Math.random().toString(36).substring(2, 9),
      type: 'paragraph',
      data: { text: '' },
    });
    renderBlocks();

    async function submitPost(status: 'draft' | 'published') {
      const title = titleInput.value.trim();
      const slug = slugInput.value.trim();
      const seo = seoInput.value.trim();

      if (!title) {
        alert('لطفاً عنوان مقاله را وارد کنید.');
        titleInput.focus();
        return;
      }
      if (!slug) {
        alert('لطفاً نامک (Slug) مقاله را وارد کنید.');
        slugInput.focus();
        return;
      }
      if (blocks.length === 0) {
        alert('مقاله باید حداقل شامل یک بلوک محتوا باشد.');
        return;
      }

      // Format blocks for backend API
      const content_blocks = blocks.map((b) => ({
        type: b.type,
        data: b.data,
      }));

      const fields = new FormData(blogForm);
      try {
        const res = await fetch(`${apiBase}/v1/admin/blog`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-Tenant-ID': activeTenantId,
          },
          body: JSON.stringify({
            title,
            slug,
            seo_description: seo,
            author_name: fields.get('author_name'),
            category: fields.get('category'),
            is_featured: fields.has('is_featured'),
            cover_media_id: String(fields.get('cover_media_id') ?? '').trim(),
            content_blocks,
            status,
          }),
        });

        if (res.ok) {
          await res.json();
          alert(status === 'published' ? 'مقاله با موفقیت منتشر شد!' : 'پیش‌نویس مقاله با موفقیت ذخیره شد.');
          window.location.href = '/blog';
        } else {
          const err = await res.json();
          alert(`خطا در ثبت مقاله: ${err.message || 'مشکلی رخ داد.'}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    }

    document.getElementById('btn-save-draft')?.addEventListener('click', () => submitPost('draft'));
    document.getElementById('btn-publish-direct')?.addEventListener('click', () => submitPost('published'));
  </script>
</AdminLayout>
