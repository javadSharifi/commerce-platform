---
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { AdminBlogPostItem, BlogPostStatus } from '@psychology/api-client';

const statusFilter = Astro.url.searchParams.get('status') as BlogPostStatus | null;
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';

// Fallback demo posts for dev/preview
const fallbackPosts: AdminBlogPostItem[] = [
  {
    id: 'b1111111-1111-1111-1111-111111111111',
    title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
    slug: 'self-awareness-and-emotional-regulation',
    status: 'published',
    published_at: '2026-11-15T10:00:00Z',
    created_at: '2026-11-14T08:00:00Z',
  },
  {
    id: 'b2222222-2222-2222-2222-222222222222',
    title: 'چگونه اضطراب عملکرد را در موقعیت‌های حساس مدیریت کنیم؟',
    slug: 'managing-performance-anxiety',
    status: 'published',
    published_at: '2026-11-18T14:30:00Z',
    created_at: '2026-11-17T11:00:00Z',
  },
  {
    id: 'b3333333-3333-3333-3333-333333333333',
    title: 'راهنمای عملی خواب سالم و کاهش نشخوار فکری شبانه',
    slug: 'sleep-hygiene-and-rumination',
    status: 'draft',
    published_at: null,
    created_at: '2026-11-20T16:20:00Z',
  },
];

let posts = fallbackPosts;

try {
  const res = await fetch(`${apiBase}/admin/blog`, {
    headers: {
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      posts = data;
    }
  }
} catch {
  // Graceful fallback to preview data
}

if (statusFilter) {
  posts = posts.filter((p) => p.status === statusFilter);
}

function formatDatePersian(dateStr?: string | null) {
  if (!dateStr) return '—';
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'Asia/Tehran',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function getStatusBadge(status: BlogPostStatus) {
  switch (status) {
    case 'published':
      return { text: 'منتشرشده', badgeClass: 'badge-success' };
    case 'draft':
      return { text: 'پیش‌نویس', badgeClass: 'badge-ghost' };
    default:
      return { text: status, badgeClass: 'badge-ghost' };
  }
}
---

<AdminLayout title="مدیریت مقالات و بلاگ" currentNav="blog">
  <div class="flex flex-col gap-6">
    <!-- Top Action Bar -->
    <div class="flex justify-between items-center flex-wrap gap-4">
      <div class="tabs tabs-boxed bg-base-100 p-1 border border-base-200 rounded-lg w-fit">
        <a
          href="/blog"
          class={`tab text-xs sm:text-sm font-medium ${!statusFilter ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          همه ({fallbackPosts.length})
        </a>
        <a
          href="/blog?status=published"
          class={`tab text-xs sm:text-sm font-medium ${statusFilter === 'published' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          منتشرشده
        </a>
        <a
          href="/blog?status=draft"
          class={`tab text-xs sm:text-sm font-medium ${statusFilter === 'draft' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          پیش‌نویس
        </a>
      </div>

      <div class="flex gap-2">
        <a href="/media" class="btn btn-ghost btn-sm text-base-content/80 font-medium">
          📁 کتابخانه رسانه‌ها
        </a>
        <a href="/blog/new" class="btn btn-primary btn-sm rounded-lg font-medium">
          ✍️ نوشتن مقاله جدید
        </a>
      </div>
    </div>

    <!-- Posts Table -->
    <div class="card bg-base-100 border border-base-200 rounded-box shadow-xs overflow-x-auto">
      <table class="table table-zebra w-full text-start text-xs">
        <thead>
          <tr class="bg-base-200/50 text-base-content/70">
            <th>عنوان مقاله</th>
            <th>نامک (Slug)</th>
            <th>وضعیت</th>
            <th>تاریخ انتشار</th>
            <th>تاریخ ایجاد</th>
            <th class="text-center">عملیات</th>
          </tr>
        </thead>
        <tbody>
          {posts.length === 0 ? (
            <tr>
              <td colspan="6" class="py-8 text-center text-base-content/60">
                مقاله‌ای با این مشخصات یافت نشد.
              </td>
            </tr>
          ) : (
            posts.map((post) => {
              const badge = getStatusBadge(post.status);
              return (
                <tr class="hover">
                  <td class="font-bold text-base-content text-sm">
                    <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors">
                      {post.title}
                    </a>
                  </td>
                  <td class="font-mono text-base-content/70" dir="ltr">
                    {post.slug}
                  </td>
                  <td>
                    <span class={`badge ${badge.badgeClass} badge-sm font-medium`}>
                      {badge.text}
                    </span>
                  </td>
                  <td class="text-base-content/70">
                    {formatDatePersian(post.published_at)}
                  </td>
                  <td class="text-base-content/70">
                    {formatDatePersian(post.created_at)}
                  </td>
                  <td class="text-center">
                    <div class="flex gap-1 justify-center items-center">
                      <a
                        href={`/blog/${post.id}`}
                        class="btn btn-ghost btn-xs text-primary font-medium"
                      >
                        ویرایش
                      </a>
                      {post.status === 'published' ? (
                        <button
                          class="action-btn-unpublish btn btn-warning btn-xs font-medium"
                          data-id={post.id}
                        >
                          لغو انتشار
                        </button>
                      ) : (
                        <button
                          class="action-btn-publish btn btn-success btn-xs font-medium"
                          data-id={post.id}
                        >
                          انتشار
                        </button>
                      )}
                      <button
                        class="action-btn-delete btn btn-error btn-outline btn-xs font-medium"
                        data-id={post.id}
                        data-title={post.title}
                      >
                        حذف
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    document.querySelectorAll('.action-btn-publish').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        try {
          const res = await fetch(`/admin/blog/${id}/publish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          if (res.ok) {
            alert('مقاله با موفقیت منتشر شد و بلافاصله به سایت عمومی و سایت‌مپ اضافه گردید.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در انتشار: ' + (err.message || 'خطا'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });

    document.querySelectorAll('.action-btn-unpublish').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        try {
          const res = await fetch(`/admin/blog/${id}/unpublish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          if (res.ok) {
            alert('مقاله از حالت انتشار خارج شد و از سایت عمومی و سایت‌مپ حذف گردید.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در لغو انتشار: ' + (err.message || 'خطا'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });

    document.querySelectorAll('.action-btn-delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const title = target.dataset.title;
        if (!confirm(`آیا از حذف مقاله "${title}" اطمینان دارید؟`)) return;

        try {
          const res = await fetch(`/admin/blog/${id}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
          });
          if (res.ok) {
            alert('مقاله حذف شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در حذف: ' + (err.message || 'خطا'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });
  </script>
</AdminLayout>
