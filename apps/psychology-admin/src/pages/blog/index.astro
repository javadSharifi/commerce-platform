---
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { AdminBlogPostItem, BlogPostStatus } from '@psychology/api-client';

const statusFilter = Astro.url.searchParams.get('status') as BlogPostStatus | null;
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';

// Fallback demo posts for dev/preview
const fallbackPosts: AdminBlogPostItem[] = [
  {
    id: 'b1111111-1111-1111-1111-111111111111',
    title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
    slug: 'self-awareness-and-emotional-regulation',
    status: 'published',
    published_at: '2026-11-15T10:00:00Z',
    created_at: '2026-11-14T08:00:00Z',
  },
  {
    id: 'b2222222-2222-2222-2222-222222222222',
    title: 'چگونه اضطراب عملکرد را در موقعیت‌های حساس مدیریت کنیم؟',
    slug: 'managing-performance-anxiety',
    status: 'published',
    published_at: '2026-11-18T14:30:00Z',
    created_at: '2026-11-17T11:00:00Z',
  },
  {
    id: 'b3333333-3333-3333-3333-333333333333',
    title: 'راهنمای عملی خواب سالم و کاهش نشخوار فکری شبانه',
    slug: 'sleep-hygiene-and-rumination',
    status: 'draft',
    published_at: null,
    created_at: '2026-11-20T16:20:00Z',
  },
];

let posts = fallbackPosts;

try {
  const res = await fetch(`${apiBase}/admin/blog`, {
    headers: {
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      posts = data;
    }
  }
} catch {
  // Graceful fallback to preview data
}

if (statusFilter) {
  posts = posts.filter((p) => p.status === statusFilter);
}

function formatDatePersian(dateStr?: string | null) {
  if (!dateStr) return '—';
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'Asia/Tehran',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function getStatusBadge(status: BlogPostStatus) {
  switch (status) {
    case 'published':
      return { text: 'منتشرشده', bg: '#dcfce7', color: '#166534', border: '#bbf7d0' };
    case 'draft':
      return { text: 'پیش‌نویس', bg: '#f1f5f9', color: '#475569', border: '#cbd5e1' };
    default:
      return { text: status, bg: '#f3f4f6', color: '#374151', border: '#e5e7eb' };
  }
}
---

<AdminLayout title="مدیریت مقالات و بلاگ" currentNav="blog">
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span style="font-weight: 600; font-size: 0.95rem; color: #475569;">فیلتر وضعیت:</span>
        <a
          href="/blog"
          class={`filter-pill ${!statusFilter ? 'active' : ''}`}
        >
          همه ({fallbackPosts.length})
        </a>
        <a
          href="/blog?status=published"
          class={`filter-pill ${statusFilter === 'published' ? 'active' : ''}`}
        >
          منتشرشده
        </a>
        <a
          href="/blog?status=draft"
          class={`filter-pill ${statusFilter === 'draft' ? 'active' : ''}`}
        >
          پیش‌نویس
        </a>
      </div>

      <div style="display: flex; gap: 0.75rem;">
        <a href="/media" class="btn-secondary">
          📁 کتابخانه رسانه‌ها
        </a>
        <a href="/blog/new" class="btn-primary">
          ✍️ نوشتن مقاله جدید
        </a>
      </div>
    </div>

    <!-- Posts Table -->
    <div class="card" style="padding: 0; overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: right; font-size: 0.9rem;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569;">
            <th style="padding: 1rem 1.25rem;">عنوان مقاله</th>
            <th style="padding: 1rem 1.25rem;">نامک (Slug)</th>
            <th style="padding: 1rem 1.25rem;">وضعیت</th>
            <th style="padding: 1rem 1.25rem;">تاریخ انتشار</th>
            <th style="padding: 1rem 1.25rem;">تاریخ ایجاد</th>
            <th style="padding: 1rem 1.25rem; text-align: center;">عملیات</th>
          </tr>
        </thead>
        <tbody>
          {posts.length === 0 ? (
            <tr>
              <td colspan="6" style="padding: 3rem; text-align: center; color: #94a3b8;">
                مقاله‌ای با این مشخصات یافت نشد.
              </td>
            </tr>
          ) : (
            posts.map((post) => {
              const badge = getStatusBadge(post.status);
              return (
                <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;">
                  <td style="padding: 1rem 1.25rem; font-weight: 600; color: #0f172a;">
                    <a href={`/blog/${post.id}`} style="color: inherit; text-decoration: none;">
                      {post.title}
                    </a>
                  </td>
                  <td style="padding: 1rem 1.25rem; font-family: monospace; color: #64748b; font-size: 0.85rem;">
                    {post.slug}
                  </td>
                  <td style="padding: 1rem 1.25rem;">
                    <span
                      style={`display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: ${badge.bg}; color: ${badge.color}; border: 1px solid ${badge.border};`}
                    >
                      {badge.text}
                    </span>
                  </td>
                  <td style="padding: 1rem 1.25rem; color: #475569;">
                    {formatDatePersian(post.published_at)}
                  </td>
                  <td style="padding: 1rem 1.25rem; color: #64748b;">
                    {formatDatePersian(post.created_at)}
                  </td>
                  <td style="padding: 1rem 1.25rem; text-align: center;">
                    <div style="display: flex; gap: 0.4rem; justify-content: center;">
                      <a
                        href={`/blog/${post.id}`}
                        style="padding: 0.3rem 0.6rem; background: #e0f2fe; color: #0369a1; border-radius: 0.375rem; text-decoration: none; font-size: 0.8rem;"
                      >
                        ویرایش
                      </a>
                      {post.status === 'published' ? (
                        <button
                          class="action-btn-unpublish"
                          data-id={post.id}
                          style="padding: 0.3rem 0.6rem; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem;"
                        >
                          لغو انتشار
                        </button>
                      ) : (
                        <button
                          class="action-btn-publish"
                          data-id={post.id}
                          style="padding: 0.3rem 0.6rem; background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem;"
                        >
                          انتشار
                        </button>
                      )}
                      <button
                        class="action-btn-delete"
                        data-id={post.id}
                        data-title={post.title}
                        style="padding: 0.3rem 0.6rem; background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem;"
                      >
                        حذف
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';

    // Publish
    document.querySelectorAll('.action-btn-publish').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!confirm('آیا از انتشار این مقاله اطمینان دارید؟ پس از انتشار، در سایت عمومی کلینیک قابل مشاهده خواهد بود.')) return;

        try {
          const res = await fetch(`${apiBase}/admin/blog/${id}/publish`, {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Content-Type': 'application/json',
            },
          });
          if (res.ok) {
            alert('مقاله با موفقیت منتشر شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert(`خطا در انتشار مقاله: ${err.message || 'مشکلی رخ داد.'}`);
          }
        } catch {
          alert('خطا در برقراری ارتباط با سرور.');
        }
      });
    });

    // Unpublish
    document.querySelectorAll('.action-btn-unpublish').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!confirm('آیا از لغو انتشار اطمینان دارید؟ مقاله بلافاصله از سایت عمومی و sitemap خارج خواهد شد.')) return;

        try {
          const res = await fetch(`${apiBase}/admin/blog/${id}/unpublish`, {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Content-Type': 'application/json',
            },
          });
          if (res.ok) {
            alert('انتشار مقاله با موفقیت لغو و به وضعیت پیش‌نویس منتقل شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert(`خطا در لغو انتشار: ${err.message || 'مشکلی رخ داد.'}`);
          }
        } catch {
          alert('خطا در برقراری ارتباط با سرور.');
        }
      });
    });

    // Delete
    document.querySelectorAll('.action-btn-delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const title = target.dataset.title;
        if (!confirm(`آیا از حذف کامل مقاله "${title}" اطمینان دارید؟ این عملیات غیرقابل بازگشت است.`)) return;

        try {
          const res = await fetch(`${apiBase}/admin/blog/${id}`, {
            method: 'DELETE',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Content-Type': 'application/json',
            },
          });
          if (res.ok) {
            alert('مقاله حذف شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert(`خطا در حذف مقاله: ${err.message || 'مشکلی رخ داد.'}`);
          }
        } catch {
          alert('خطا در برقراری ارتباط با سرور.');
        }
      });
    });
  </script>

  <style>
    .filter-pill {
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      text-decoration: none;
      color: #64748b;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      transition: all 0.15s ease;
    }
    .filter-pill:hover {
      background: #f1f5f9;
      color: #1e293b;
    }
    .filter-pill.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
      font-weight: 600;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #0284c7;
      color: #ffffff;
      padding: 0.55rem 1.25rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .btn-primary:hover {
      background: #0369a1;
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #ffffff;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 0.55rem 1.25rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .btn-secondary:hover {
      background: #f8fafc;
    }
  </style>
</AdminLayout>
