---
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { AdminBlogPostDetail } from '@psychology/api-client';

const { id } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';

// Fallback demo post for dev/preview
const fallbackPost: AdminBlogPostDetail = {
  id: id || 'b1111111-1111-1111-1111-111111111111',
  title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
  slug: 'self-awareness-and-emotional-regulation',
  seo_description: 'بررسی راهکارهای علمی و روان‌شناختی جهت تقویت خودآگاهی و بهبود مهارت‌های ارتباطی در زندگی روزمره.',
  status: 'published',
  published_at: '2026-11-15T10:00:00Z',
  created_at: '2026-11-14T08:00:00Z',
  updated_at: '2026-11-15T10:00:00Z',
  content_blocks: [
    {
      type: 'heading',
      data: { level: 2, text: 'مقدمه‌ای بر هوش هیجانی و ارتباط سالم' },
    },
    {
      type: 'paragraph',
      data: {
        text: 'روابط بین‌فردی ستون فقرات کیفیت زندگی روانی انسان‌ها را تشکیل می‌دهند. پژوهش‌های متعدد نشان می‌دهند که توانایی درک و نام‌گذاری هیجانات خود، اولین گام در تنظیم پاسخ‌های هیجانی است.',
      },
    },
    {
      type: 'audio',
      data: {
        media_id: 'm1111111-1111-1111-1111-111111111111',
        caption: 'پادکست آموزشی تنظیم هیجان',
      },
    },
  ],
};

let post = fallbackPost;

try {
  const res = await fetch(`${apiBase}/admin/blog/${id}`, {
    headers: {
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    post = await res.json();
  }
} catch {
  // Fallback to demo post
}
---

<AdminLayout title={`ویرایش: ${post.title}`} currentNav="blog">
  <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span
          style={`display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; background: ${post.status === 'published' ? '#dcfce7' : '#f1f5f9'}; color: ${post.status === 'published' ? '#166534' : '#475569'}; border: 1px solid ${post.status === 'published' ? '#bbf7d0' : '#cbd5e1'};`}
        >
          {post.status === 'published' ? '🟢 وضعیت: منتشرشده' : '⚪ وضعیت: پیش‌نویس'}
        </span>
        {post.status === 'published' && (
          <a
            href={`http://localhost:3000/blog/${post.slug}`}
            target="_blank"
            style="color: #0284c7; font-size: 0.85rem; text-decoration: none;"
          >
            🔗 مشاهده در سایت عمومی ↗
          </a>
        )}
      </div>

      <div style="display: flex; gap: 0.5rem;">
        {post.status === 'published' ? (
          <button id="btn-unpublish" class="btn-warning">
            لغو انتشار (انتقال به پیش‌نویس)
          </button>
        ) : (
          <button id="btn-publish" class="btn-success">
            🚀 انتشار مقاله
          </button>
        )}
        <button id="btn-delete" class="btn-danger">
          حذف مقاله
        </button>
      </div>
    </div>

    <!-- Main Editor Form -->
    <form id="edit-blog-form" class="card" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Title -->
      <div>
        <label for="post-title" class="form-label">عنوان مقاله *</label>
        <input
          type="text"
          id="post-title"
          name="title"
          value={post.title}
          required
          class="form-input"
        />
      </div>

      <!-- Slug & SEO -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="post-slug" class="form-label">نامک یکتا (Slug) *</label>
          <input
            type="text"
            id="post-slug"
            name="slug"
            value={post.slug}
            required
            pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
            class="form-input"
            dir="ltr"
          />
          <span style="font-size: 0.75rem; color: #64748b;">تنها حروف کوچک انگلیسی، ارقام و خط تیره مجاز است.</span>
        </div>
        <div>
          <label for="post-seo" class="form-label">توضیحات سئو (خلاصه مقاله)</label>
          <input
            type="text"
            id="post-seo"
            name="seo_description"
            value={post.seo_description}
            class="form-input"
          />
        </div>
      </div>

      <!-- Block Editor Container -->
      <div style="border-top: 1px solid #e2e8f0; padding-top: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b;">بلوک‌های محتوای مقاله</h3>
          <span style="font-size: 0.85rem; color: #64748b;">تعداد بلوک‌ها: <b id="block-count">0</b></span>
        </div>

        <!-- Rendered blocks list -->
        <div id="blocks-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem;">
          <!-- Dynamically injected blocks -->
        </div>

        <!-- Block Tooling Bar -->
        <div style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 0.75rem; padding: 1.25rem; text-align: center;">
          <div style="font-size: 0.9rem; font-weight: 600; color: #475569; margin-bottom: 0.75rem;">
            افزودن بلوک محتوایی جدید:
          </div>
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;">
            <button type="button" class="btn-add-block" data-type="paragraph">
              📝 پاراگراف متن
            </button>
            <button type="button" class="btn-add-block" data-type="heading">
              📌 تیتر (Heading)
            </button>
            <button type="button" class="btn-add-block" data-type="image">
              🖼️ تصویر
            </button>
            <button type="button" class="btn-add-block" data-type="audio">
              🎧 صوت / پادکست
            </button>
            <button type="button" class="btn-add-block" data-type="video">
              🎬 ویدئو
            </button>
          </div>
        </div>
      </div>

      <!-- Submit Actions -->
      <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid #e2e8f0; padding-top: 1.25rem;">
        <a href="/blog" class="btn-cancel">
          بازگشت
        </a>
        <button type="button" id="btn-save-changes" class="btn-primary">
          💾 ذخیره تغییرات
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ initialBlocks: post.content_blocks, postId: post.id }}>
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
    const blocksContainer = document.getElementById('blocks-container');
    const blockCountEl = document.getElementById('block-count');
    const titleInput = document.getElementById('post-title');
    const slugInput = document.getElementById('post-slug');
    const seoInput = document.getElementById('post-seo');

    let blocks = (initialBlocks || []).map((b) => ({
      id: Math.random().toString(36).substring(2, 9),
      type: b.type,
      data: { ...b.data },
    }));

    function updateCount() {
      if (blockCountEl) blockCountEl.textContent = String(blocks.length);
    }

    function renderBlocks() {
      if (!blocksContainer) return;
      blocksContainer.innerHTML = '';

      blocks.forEach((block, index) => {
        const item = document.createElement('div');
        item.className = 'block-card';
        item.dataset.id = block.id;

        let contentHTML = '';

        if (block.type === 'paragraph') {
          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">پاراگراف متن</div>
            <textarea class="form-input block-input-text" rows="3" placeholder="متن پاراگراف را اینجا بنویسید...">${block.data.text || ''}</textarea>
          `;
        } else if (block.type === 'heading') {
          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">تیتر (Heading)</div>
            <div style="display: flex; gap: 0.5rem;">
              <select class="form-input block-input-level" style="width: 120px;">
                <option value="2" ${block.data.level === 2 ? 'selected' : ''}>H2 (تیتر اصلی)</option>
                <option value="3" ${block.data.level === 3 ? 'selected' : ''}>H3 (تیتر فرعی)</option>
                <option value="4" ${block.data.level === 4 ? 'selected' : ''}>H4 (زیرتیتر)</option>
              </select>
              <input type="text" class="form-input block-input-text" value="${block.data.text || ''}" placeholder="عنوان تیتر..." style="flex: 1;" />
            </div>
          `;
        } else if (block.type === 'image' || block.type === 'audio' || block.type === 'video') {
          const typeName = block.type === 'image' ? 'تصویر' : block.type === 'audio' ? 'صوت / پادکست' : 'ویدئو';
          const acceptType = block.type === 'image' ? 'image/jpeg,image/png,image/webp' : block.type === 'audio' ? 'audio/mpeg' : 'video/mp4';

          contentHTML = `
            <div style="font-weight: 600; font-size: 0.85rem; color: #0284c7; margin-bottom: 0.4rem;">فایل ${typeName}</div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="file" class="block-file-picker" accept="${acceptType}" style="display: none;" />
                <button type="button" class="btn-choose-file" style="padding: 0.4rem 0.8rem; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; border-radius: 0.375rem; cursor: pointer; font-size: 0.85rem;">
                  📤 تغییر / بارگذاری فایل
                </button>
                <span class="upload-status" style="font-size: 0.8rem; color: ${block.data.media_id ? '#166534' : '#64748b'};">
                  ${block.data.media_id ? `✅ فایل متصل است (ID: ${block.data.media_id.slice(0, 8)}...)` : 'فایلی انتخاب نشده است.'}
                </span>
              </div>
              <input type="text" class="form-input block-input-caption" value="${block.data.caption || ''}" placeholder="توضیح یا زیرنویس فایل..." />
            </div>
          `;
        }

        item.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; background: #e2e8f0; color: #334155; padding: 0.15rem 0.5rem; border-radius: 0.25rem;">
              بلوک #${index + 1}
            </span>
            <div style="display: flex; gap: 0.25rem;">
              <button type="button" class="btn-move-up" title="انتقال به بالا" ${index === 0 ? 'disabled' : ''} style="cursor: pointer; padding: 0.2rem 0.4rem; background: none; border: 1px solid #cbd5e1; border-radius: 0.25rem;">⬆️</button>
              <button type="button" class="btn-move-down" title="انتقال به پایین" ${index === blocks.length - 1 ? 'disabled' : ''} style="cursor: pointer; padding: 0.2rem 0.4rem; background: none; border: 1px solid #cbd5e1; border-radius: 0.25rem;">⬇️</button>
              <button type="button" class="btn-remove-block" title="حذف بلوک" style="cursor: pointer; padding: 0.2rem 0.4rem; background: #fee2e2; border: 1px solid #fecaca; border-radius: 0.25rem; color: #991b1b;">❌</button>
            </div>
          </div>
          ${contentHTML}
        `;

        // Input bindings
        const textarea = item.querySelector('.block-input-text');
        if (textarea) {
          textarea.addEventListener('input', (e) => {
            block.data.text = e.target.value;
          });
        }

        const levelSelect = item.querySelector('.block-input-level');
        if (levelSelect) {
          levelSelect.addEventListener('change', (e) => {
            block.data.level = Number(e.target.value);
          });
        }

        const captionInput = item.querySelector('.block-input-caption');
        if (captionInput) {
          captionInput.addEventListener('input', (e) => {
            block.data.caption = e.target.value;
          });
        }

        const filePicker = item.querySelector('.block-file-picker');
        const chooseBtn = item.querySelector('.btn-choose-file');
        const uploadStatus = item.querySelector('.upload-status');

        if (chooseBtn && filePicker && uploadStatus) {
          chooseBtn.addEventListener('click', () => filePicker.click());
          filePicker.addEventListener('change', async () => {
            const file = filePicker.files?.[0];
            if (!file) return;

            uploadStatus.textContent = '⏳ در حال دریافت لینک آپلود مستقیم...';
            try {
              const reqRes = await fetch(`${apiBase}/admin/media/upload-url`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({
                  original_name: file.name,
                  mime_type: file.type,
                  size_bytes: file.size,
                  access_class: 'public',
                }),
              });

              if (!reqRes.ok) {
                const err = await reqRes.json();
                uploadStatus.textContent = `❌ خطا: ${err.message || 'صدور مجوز آپلود رد شد.'}`;
                return;
              }

              const uploadData = await reqRes.json();
              uploadStatus.textContent = '📤 در حال ارسال فایل...';
              await fetch(uploadData.upload_url, {
                method: 'PUT',
                body: file,
                headers: { 'Content-Type': file.type },
              });

              uploadStatus.textContent = '🔄 در حال نهایی‌سازی...';
              const finRes = await fetch(`${apiBase}/admin/media/finalize`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ upload_id: uploadData.upload_id }),
              });

              if (!finRes.ok) {
                uploadStatus.textContent = '❌ خطا در نهایی‌سازی.';
                return;
              }

              const asset = await finRes.json();
              block.data.media_id = asset.id;
              uploadStatus.textContent = `✅ فایل ذخیره شد (${asset.original_name})`;
              uploadStatus.setAttribute('style', 'font-size: 0.8rem; color: #166534;');
            } catch (err) {
              uploadStatus.textContent = '❌ خطا در آپلود فایل.';
            }
          });
        }

        // Actions
        item.querySelector('.btn-move-up')?.addEventListener('click', () => {
          if (index > 0) {
            const temp = blocks[index];
            blocks[index] = blocks[index - 1];
            blocks[index - 1] = temp;
            renderBlocks();
          }
        });

        item.querySelector('.btn-move-down')?.addEventListener('click', () => {
          if (index < blocks.length - 1) {
            const temp = blocks[index];
            blocks[index] = blocks[index + 1];
            blocks[index + 1] = temp;
            renderBlocks();
          }
        });

        item.querySelector('.btn-remove-block')?.addEventListener('click', () => {
          blocks.splice(index, 1);
          renderBlocks();
          updateCount();
        });

        blocksContainer.appendChild(item);
      });

      updateCount();
    }

    document.querySelectorAll('.btn-add-block').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const type = e.currentTarget.dataset.type || 'paragraph';
        const newBlock = {
          id: Math.random().toString(36).substring(2, 9),
          type,
          data: type === 'heading' ? { level: 2, text: '' } : type === 'paragraph' ? { text: '' } : { caption: '' },
        };
        blocks.push(newBlock);
        renderBlocks();
      });
    });

    renderBlocks();

    // Save Changes
    document.getElementById('btn-save-changes')?.addEventListener('click', async () => {
      const title = titleInput.value.trim();
      const slug = slugInput.value.trim();
      const seo = seoInput.value.trim();

      if (!title || !slug) {
        alert('عنوان و نامک الزامی هستند.');
        return;
      }

      const content_blocks = blocks.map((b) => ({ type: b.type, data: b.data }));

      try {
        const res = await fetch(`${apiBase}/admin/blog/${postId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({
            title,
            slug,
            seo_description: seo,
            content_blocks,
          }),
        });

        if (res.ok) {
          alert('تغییرات با موفقیت ذخیره شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert(`خطا در ذخیره: ${err.message || 'مشکلی رخ داد.'}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    });

    // Publish
    document.getElementById('btn-publish')?.addEventListener('click', async () => {
      if (!confirm('آیا از انتشار این مقاله اطمینان دارید؟')) return;
      try {
        const res = await fetch(`${apiBase}/admin/blog/${postId}/publish`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        });
        if (res.ok) {
          alert('مقاله منتشر شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert(`خطا: ${err.message}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    });

    // Unpublish
    document.getElementById('btn-unpublish')?.addEventListener('click', async () => {
      if (!confirm('آیا از لغو انتشار اطمینان دارید؟')) return;
      try {
        const res = await fetch(`${apiBase}/admin/blog/${postId}/unpublish`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        });
        if (res.ok) {
          alert('انتشار لغو شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert(`خطا: ${err.message}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    });

    // Delete
    document.getElementById('btn-delete')?.addEventListener('click', async () => {
      if (!confirm('آیا از حذف کامل این مقاله اطمینان دارید؟')) return;
      try {
        const res = await fetch(`${apiBase}/admin/blog/${postId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        });
        if (res.ok) {
          alert('مقاله حذف شد.');
          window.location.href = '/blog';
        } else {
          const err = await res.json();
          alert(`خطا: ${err.message}`);
        }
      } catch {
        alert('خطا در برقراری ارتباط با سرور.');
      }
    });
  </script>

  <style>
    .form-label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 0.4rem;
    }
    .form-input {
      width: 100%;
      padding: 0.6rem 0.85rem;
      border: 1px solid #cbd5e1;
      border-radius: 0.5rem;
      font-size: 0.95rem;
      color: #1e293b;
      background: #ffffff;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .form-input:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);
    }
    .block-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 1rem;
      box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .btn-add-block {
      background: #ffffff;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 0.45rem 0.9rem;
      border-radius: 0.375rem;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .btn-add-block:hover {
      background: #f1f5f9;
      border-color: #94a3b8;
    }
    .btn-primary {
      background: #0284c7;
      color: #ffffff;
      padding: 0.6rem 1.4rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      background: #0369a1;
    }
    .btn-success {
      background: #16a34a;
      color: #ffffff;
      padding: 0.45rem 1rem;
      border-radius: 0.375rem;
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }
    .btn-warning {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
      padding: 0.45rem 1rem;
      border-radius: 0.375rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-danger {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
      padding: 0.45rem 1rem;
      border-radius: 0.375rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-cancel {
      display: inline-flex;
      align-items: center;
      padding: 0.6rem 1.2rem;
      color: #64748b;
      text-decoration: none;
      font-size: 0.9rem;
    }
  </style>
</AdminLayout>
