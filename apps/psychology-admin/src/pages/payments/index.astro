---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Fallback sample data for SSR/preview
const fallbackPurchases = [
  {
    id: 'pur-101-uuid',
    item_type: 'workshop_registration',
    item_id: 'reg-002-uuid',
    title_snapshot: 'کارگاه روان‌درمانی تحلیلی و تنظیم هیجان',
    amount_rials: 5000000,
    status: 'refund_required',
    tracking_code: 'ZP-987654321',
    created_at: '2026-11-20T14:35:00Z',
  },
  {
    id: 'pur-102-uuid',
    item_type: 'workshop_registration',
    item_id: 'reg-005-uuid',
    title_snapshot: 'کارگاه مهارت‌های حل مسئله (لغو شده)',
    amount_rials: 3500000,
    status: 'refund_required',
    tracking_code: 'ZP-123456789',
    created_at: '2026-11-21T09:15:00Z',
  },
];

let purchases = fallbackPurchases;

function formatDateTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function formatPriceToman(priceRials: number) {
  const toman = Math.floor(priceRials / 10);
  return `${toman.toLocaleString('fa-IR')} تومان`;
}
---

<AdminLayout title="پیگیری بازپرداخت‌ها و تسویه‌ها" currentNav="payments">
  <div class="mb-6">
    <h2 class="text-xl font-bold text-base-content mb-1">
      صف سفارش‌های نیازمند استرداد وجه (مختص مالک)
    </h2>
    <p class="text-xs text-base-content/70">
      خریدهایی که پس از انقضای مهلت نگه‌داشت صندلی یا لغو کارگاه با موفقیت توسط مشتری پرداخت شده‌اند در این صف قرار دارند تا پس از عودت کارت به کارت، شماره مرجع ثبت گردد.
    </p>
  </div>

  <div class="card bg-base-100 border border-base-200 rounded-box shadow-xs overflow-x-auto">
    <table class="table table-zebra w-full text-start text-xs">
      <thead>
        <tr class="bg-base-200/50 text-base-content/70">
          <th>عنوان خرید / کارگاه</th>
          <th>مبلغ پرداختی</th>
          <th>کد رهگیری بانک</th>
          <th>زمان واریز</th>
          <th>وضعیت</th>
          <th class="text-end">اقدام مالی</th>
        </tr>
      </thead>
      <tbody>
        {purchases.map((p) => (
          <tr class="hover">
            <td class="font-bold text-base-content text-sm">
              {p.title_snapshot}
            </td>
            <td>
              <div class="font-bold text-warning text-sm">
                {formatPriceToman(p.amount_rials)}
              </div>
              <span class="text-[11px] text-base-content/60 block">({p.amount_rials.toLocaleString('fa-IR')} ریال)</span>
            </td>
            <td class="font-mono text-base-content/70" dir="ltr">
              {p.tracking_code || '—'}
            </td>
            <td class="text-base-content/70">
              {formatDateTehran(p.created_at)}
            </td>
            <td>
              <span class="badge badge-warning badge-sm font-medium">
                نیازمند بازپرداخت
              </span>
            </td>
            <td class="text-end">
              <button
                class="btn-open-refund btn btn-primary btn-xs font-medium"
                data-purchase-id={p.id}
                data-title={p.title_snapshot}
                data-amount={p.amount_rials}
              >
                ثبت سند بازپرداخت
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Refund Modal -->
  <div id="refund-modal" class="hidden fixed inset-0 bg-neutral/60 backdrop-blur-xs z-50 items-center justify-center p-4">
    <div class="card bg-base-100 border border-base-200 rounded-box max-w-lg w-full p-6 shadow-xl">
      <h3 class="text-base font-bold text-base-content mb-1">
        ثبت دستی بازپرداخت به متقاضی
      </h3>
      <p id="modal-desc" class="text-xs text-base-content/70 mb-5"></p>

      <form id="refund-form" class="flex flex-col gap-4">
        <div id="modal-error" class="hidden alert alert-error text-xs font-medium"></div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1">
            شماره مرجع یا پیگیری تراکنش بانکی (کارت به کارت / پایا) <span class="text-error">*</span>
          </label>
          <input
            id="ref-number"
            type="text"
            dir="ltr"
            required
            placeholder="مثال: REF-14030821-9988"
            class="input input-bordered input-sm w-full font-mono text-xs"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1">
            مبلغ بازپرداخت‌شده (ریال) <span class="text-error">*</span>
          </label>
          <input
            id="ref-amount"
            type="number"
            readonly
            class="input input-bordered input-sm w-full bg-base-200/50 text-xs font-bold"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1">
            توضیحات و علت بازپرداخت
          </label>
          <textarea
            id="ref-reason"
            rows="2"
            placeholder="کارت به کارت به حساب اعلامی مشتری به دلیل تکمیل ظرفیت یا لغو کارگاه..."
            class="textarea textarea-bordered textarea-sm w-full text-xs"
          ></textarea>
        </div>

        <div class="flex justify-end gap-2 mt-2 pt-3 border-t border-base-200">
          <button
            id="btn-cancel-modal"
            type="button"
            class="btn btn-ghost btn-sm font-medium"
          >
            انصراف
          </button>
          <button
            type="submit"
            class="btn btn-primary btn-sm font-medium"
          >
            تأیید و ثبت بازپرداخت
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let activePurchaseId = '';
    const modal = document.getElementById('refund-modal');
    const modalDesc = document.getElementById('modal-desc');
    const modalError = document.getElementById('modal-error');
    const refNumInput = document.getElementById('ref-number') as HTMLInputElement;
    const refAmountInput = document.getElementById('ref-amount') as HTMLInputElement;
    const refReasonInput = document.getElementById('ref-reason') as HTMLTextAreaElement;
    const btnCancel = document.getElementById('btn-cancel-modal');
    const form = document.getElementById('refund-form');

    document.querySelectorAll('.btn-open-refund').forEach((btn) => {
      btn.addEventListener('click', () => {
        activePurchaseId = btn.getAttribute('data-purchase-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const amount = btn.getAttribute('data-amount') || '0';

        if (modalDesc) modalDesc.textContent = `خرید: ${title}`;
        if (refAmountInput) refAmountInput.value = amount;
        if (refNumInput) refNumInput.value = '';
        if (refReasonInput) refReasonInput.value = '';
        if (modalError) modalError.classList.add('hidden');

        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    if (btnCancel && modal) {
      btnCancel.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (modalError) modalError.classList.add('hidden');

        const refNum = refNumInput.value.trim();
        const amount = parseInt(refAmountInput.value, 10);
        const reason = refReasonInput.value.trim();

        if (!refNum) {
          if (modalError) {
            modalError.textContent = 'شماره مرجع بانکی الزامی است.';
            modalError.classList.remove('hidden');
          }
          return;
        }

        try {
          const res = await fetch(`/admin/payments/${activePurchaseId}/refund`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              reference_number: refNum,
              amount_rials: amount,
              reason: reason,
            }),
          });

          if (res.ok) {
            alert('بازپرداخت با موفقیت ثبت شد و سفارش به وضعیت refunded منتقل گردید.');
            window.location.reload();
          } else {
            const data = await res.json().catch(() => ({}));
            let msg = data.message || 'خطا در ثبت بازپرداخت.';
            if (data.code === 'DUPLICATE_REFERENCE') {
              msg = 'این شماره مرجع بانکی قبلاً برای سفارش دیگری ثبت شده است.';
            }
            if (modalError) {
              modalError.textContent = msg;
              modalError.classList.remove('hidden');
            }
          }
        } catch {
          if (modalError) {
            modalError.textContent = 'خطا در برقراری ارتباط با سرور.';
            modalError.classList.remove('hidden');
          }
        }
      });
    }
  </script>
</AdminLayout>
