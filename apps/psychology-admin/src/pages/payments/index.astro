---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Fallback sample data for SSR/preview
const fallbackPurchases = [
  {
    id: 'pur-101-uuid',
    item_type: 'workshop_registration',
    item_id: 'reg-002-uuid',
    title_snapshot: 'کارگاه روان‌درمانی تحلیلی و تنظیم هیجان',
    amount_rials: 5000000,
    status: 'refund_required',
    tracking_code: 'ZP-987654321',
    created_at: '2026-11-20T14:35:00Z',
  },
  {
    id: 'pur-102-uuid',
    item_type: 'workshop_registration',
    item_id: 'reg-005-uuid',
    title_snapshot: 'کارگاه مهارت‌های حل مسئله (لغو شده)',
    amount_rials: 3500000,
    status: 'refund_required',
    tracking_code: 'ZP-123456789',
    created_at: '2026-11-21T09:15:00Z',
  },
];

let purchases = fallbackPurchases;

function formatDateTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function formatPriceToman(priceRials: number) {
  const toman = Math.floor(priceRials / 10);
  return `${toman.toLocaleString('fa-IR')} تومان`;
}
---

<AdminLayout title="پیگیری بازپرداخت‌ها و تسویه‌ها" currentNav="payments">
  <div style="margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.35rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">
      صف سفارش‌های نیازمند استرداد وجه (مختص مالک)
    </h2>
    <p style="color: #64748b; font-size: 0.9rem;">
      خریدهایی که پس از انقضای مهلت نگه‌داشت صندلی یا لغو کارگاه با موفقیت توسط مشتری پرداخت شده‌اند در این صف قرار دارند تا پس از عودت کارت به کارت، شماره مرجع ثبت گردد.
    </p>
  </div>

  <div class="card" style="padding: 0; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: right; font-size: 0.95rem;">
      <thead>
        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569;">
          <th style="padding: 1rem 1.25rem; font-weight: 600;">عنوان خرید / کارگاه</th>
          <th style="padding: 1rem 1rem; font-weight: 600;">مبلغ پرداختی</th>
          <th style="padding: 1rem 1rem; font-weight: 600;">کد رهگیری بانک</th>
          <th style="padding: 1rem 1rem; font-weight: 600;">زمان واریز</th>
          <th style="padding: 1rem 1rem; font-weight: 600;">وضعیت</th>
          <th style="padding: 1rem 1.25rem; font-weight: 600; text-align: left;">اقدام مالی</th>
        </tr>
      </thead>
      <tbody>
        {purchases.map((p) => (
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 1rem 1.25rem; font-weight: 600; color: #0f172a;">
              {p.title_snapshot}
            </td>
            <td style="padding: 1rem 1rem; font-weight: 700; color: #c2410c;">
              {formatPriceToman(p.amount_rials)}
              <span style="font-size: 0.75rem; color: #64748b; display: block;">({p.amount_rials.toLocaleString('fa-IR')} ریال)</span>
            </td>
            <td style="padding: 1rem 1rem; font-family: monospace; color: #334155;" dir="ltr">
              {p.tracking_code || '—'}
            </td>
            <td style="padding: 1rem 1rem; color: #64748b; font-size: 0.9rem;">
              {formatDateTehran(p.created_at)}
            </td>
            <td style="padding: 1rem 1rem;">
              <span style="display: inline-block; padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: #ffedd5; color: #c2410c;">
                نیازمند بازپرداخت
              </span>
            </td>
            <td style="padding: 1rem 1.25rem; text-align: left;">
              <button
                class="btn-open-refund"
                data-purchase-id={p.id}
                data-title={p.title_snapshot}
                data-amount={p.amount_rials}
                style="padding: 0.45rem 0.9rem; background: #0284c7; color: #ffffff; border: none; border-radius: 0.375rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;"
              >
                ثبت سند بازپرداخت
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Refund Modal -->
  <div id="refund-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; padding: 1rem;">
    <div style="background: #ffffff; border-radius: 0.75rem; max-width: 500px; width: 100%; padding: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
      <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">
        ثبت دستی بازپرداخت به متقاضی
      </h3>
      <p id="modal-desc" style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.25rem;"></p>

      <form id="refund-form" style="display: flex; flex-direction: column; gap: 1rem;">
        <div id="modal-error" style="display: none; background: #fef2f2; border: 1px solid #fecaca; border-radius: 0.5rem; padding: 0.5rem 0.75rem; color: #991b1b; font-size: 0.85rem;"></div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem; color: #334155;">
            شماره مرجع یا پیگیری تراکنش بانکی (کارت به کارت / پایا) <span style="color: #ef4444;">*</span>
          </label>
          <input
            id="ref-number"
            type="text"
            dir="ltr"
            required
            placeholder="مثال: REF-14030821-9988"
            style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-family: monospace; font-size: 0.95rem;"
          />
        </div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem; color: #334155;">
            مبلغ بازپرداخت‌شده (ریال) <span style="color: #ef4444;">*</span>
          </label>
          <input
            id="ref-amount"
            type="number"
            readonly
            style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; background: #f8fafc; font-size: 0.95rem;"
          />
        </div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem; color: #334155;">
            توضیحات و علت بازپرداخت
          </label>
          <textarea
            id="ref-reason"
            rows="2"
            placeholder="کارت به کارت به حساب اعلامی مشتری به دلیل تکمیل ظرفیت یا لغو کارگاه..."
            style="width: 100%; padding: 0.55rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-size: 0.9rem; font-family: inherit;"
          ></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem;">
          <button
            id="btn-cancel-modal"
            type="button"
            style="padding: 0.5rem 1rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 0.375rem; font-size: 0.9rem; color: #475569; cursor: pointer;"
          >
            انصراف
          </button>
          <button
            type="submit"
            style="padding: 0.5rem 1.25rem; background: #0284c7; color: #ffffff; border: none; border-radius: 0.375rem; font-size: 0.9rem; font-weight: 600; cursor: pointer;"
          >
            تأیید و ثبت بازپرداخت
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let activePurchaseId = '';
    const modal = document.getElementById('refund-modal');
    const modalDesc = document.getElementById('modal-desc');
    const modalError = document.getElementById('modal-error');
    const refNumInput = document.getElementById('ref-number') as HTMLInputElement;
    const refAmountInput = document.getElementById('ref-amount') as HTMLInputElement;
    const refReasonInput = document.getElementById('ref-reason') as HTMLTextAreaElement;
    const btnCancel = document.getElementById('btn-cancel-modal');
    const form = document.getElementById('refund-form');

    document.querySelectorAll('.btn-open-refund').forEach((btn) => {
      btn.addEventListener('click', () => {
        activePurchaseId = btn.getAttribute('data-purchase-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const amount = btn.getAttribute('data-amount') || '0';

        if (modalDesc) modalDesc.textContent = `خرید: ${title}`;
        if (refAmountInput) refAmountInput.value = amount;
        if (refNumInput) refNumInput.value = '';
        if (refReasonInput) refReasonInput.value = '';
        if (modalError) modalError.style.display = 'none';

        if (modal) modal.style.display = 'flex';
      });
    });

    if (btnCancel && modal) {
      btnCancel.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (modalError) modalError.style.display = 'none';

        const refNum = refNumInput.value.trim();
        const amount = parseInt(refAmountInput.value, 10);
        const reason = refReasonInput.value.trim();

        if (!refNum) {
          if (modalError) {
            modalError.textContent = 'شماره مرجع بانکی الزامی است.';
            modalError.style.display = 'block';
          }
          return;
        }

        try {
          const res = await fetch(`/admin/payments/${activePurchaseId}/refund`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              reference_number: refNum,
              amount_rials: amount,
              reason: reason,
            }),
          });

          if (res.ok) {
            alert('بازپرداخت با موفقیت ثبت شد و سفارش به وضعیت refunded منتقل گردید.');
            window.location.reload();
          } else {
            const data = await res.json().catch(() => ({}));
            let msg = data.message || 'خطا در ثبت بازپرداخت.';
            if (data.code === 'DUPLICATE_REFERENCE') {
              msg = 'این شماره مرجع بانکی قبلاً برای سفارش دیگری ثبت شده است.';
            }
            if (modalError) {
              modalError.textContent = msg;
              modalError.style.display = 'block';
            }
          }
        } catch {
          if (modalError) {
            modalError.textContent = 'خطا در برقراری ارتباط با سرور.';
            modalError.style.display = 'block';
          }
        }
      });
    }
  </script>
</AdminLayout>
