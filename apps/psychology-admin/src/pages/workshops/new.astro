---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="تعریف کارگاه جدید" currentNav="workshops">
  <div class="max-w-3xl mx-auto">
    <div class="mb-6">
      <a href="/workshops" class="btn btn-ghost btn-xs text-base-content/70">
        ← بازگشت به فهرست کارگاه‌ها
      </a>
      <h2 class="text-xl font-bold text-base-content mt-2 mb-1">
        مشخصات کارگاه جدید
      </h2>
      <p class="text-xs text-base-content/70">
        کارگاه پس از ایجاد در وضعیت «پیش‌نویس» قرار می‌گیرد و پس از بررسی نهایی می‌توانید آن را منتشر نمایید.
      </p>
    </div>

    <div class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 shadow-xs">
      <form id="create-workshop-form" class="flex flex-col gap-5">
        <div id="form-error" class="hidden alert alert-error text-xs font-medium"></div>
        <div id="form-success" class="hidden alert alert-success text-xs font-medium"></div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-2">
            <label for="title" class="block text-xs font-semibold text-base-content/80 mb-1">
              عنوان کامل کارگاه <span class="text-error">*</span>
            </label>
            <input
              id="title"
              name="title"
              type="text"
              required
              placeholder="مثال: کارگاه خودآگاهی و مدیریت استرس"
              class="input input-bordered input-sm w-full"
            />
          </div>
          <div>
            <label for="slug" class="block text-xs font-semibold text-base-content/80 mb-1">
              نامک انگلیسی (Slug) <span class="text-error">*</span>
            </label>
            <input
              id="slug"
              name="slug"
              type="text"
              dir="ltr"
              required
              placeholder="stress-management-workshop"
              class="input input-bordered input-sm w-full font-mono text-xs"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="instructor_name" class="block text-xs font-semibold text-base-content/80 mb-1">
              نام مدرس / سخنران <span class="text-error">*</span>
            </label>
            <input
              id="instructor_name"
              name="instructor_name"
              type="text"
              required
              placeholder="مثال: دکتر مریم علوی"
              class="input input-bordered input-sm w-full"
            />
          </div>
          <div>
            <label for="location" class="block text-xs font-semibold text-base-content/80 mb-1">
              محل برگزاری کارگاه <span class="text-error">*</span>
            </label>
            <input
              id="location"
              name="location"
              type="text"
              required
              placeholder="مثال: سالن شماره یک کلینیک مهر"
              class="input input-bordered input-sm w-full"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="starts_at" class="block text-xs font-semibold text-base-content/80 mb-1">
              تاریخ و ساعت شروع <span class="text-error">*</span>
            </label>
            <input
              id="starts_at"
              name="starts_at"
              type="datetime-local"
              required
              class="input input-bordered input-sm w-full text-xs font-sans"
            />
          </div>
          <div>
            <label for="ends_at" class="block text-xs font-semibold text-base-content/80 mb-1">
              تاریخ و ساعت پایان <span class="text-error">*</span>
            </label>
            <input
              id="ends_at"
              name="ends_at"
              type="datetime-local"
              required
              class="input input-bordered input-sm w-full text-xs font-sans"
            />
          </div>
          <div>
            <label for="registration_deadline" class="block text-xs font-semibold text-base-content/80 mb-1">
              مهلت ثبت‌نام <span class="text-error">*</span>
            </label>
            <input
              id="registration_deadline"
              name="registration_deadline"
              type="datetime-local"
              required
              class="input input-bordered input-sm w-full text-xs font-sans"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="capacity" class="block text-xs font-semibold text-base-content/80 mb-1">
              ظرفیت صندلی‌ها (نفر) <span class="text-error">*</span>
            </label>
            <input
              id="capacity"
              name="capacity"
              type="number"
              min="1"
              value="20"
              required
              class="input input-bordered input-sm w-full"
            />
          </div>
          <div>
            <label for="price_rials" class="block text-xs font-semibold text-base-content/80 mb-1">
              شهریه ثبت‌نام (ریال) <span class="text-error">*</span>
            </label>
            <input
              id="price_rials"
              name="price_rials"
              type="number"
              min="0"
              step="10000"
              value="0"
              required
              class="input input-bordered input-sm w-full"
            />
            <span id="price-toman-preview" class="block text-xs text-primary font-bold mt-1">
              معادل: رایگان
            </span>
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-semibold text-base-content/80 mb-1">
            توضیحات، سرفصل‌ها و شرایط شرکت در کارگاه
          </label>
          <textarea
            id="description"
            name="description"
            rows="4"
            placeholder="سرفصل‌های کارگاه، پیش‌نیازها و توضیحات تکمیلی..."
            class="textarea textarea-bordered textarea-sm w-full"
          ></textarea>
        </div>

        <div class="mt-2 flex justify-end gap-3">
          <a href="/workshops" class="btn btn-ghost btn-sm font-medium">
            انصراف
          </a>
          <button id="submit-btn" type="submit" class="btn btn-primary btn-sm font-medium">
            ذخیره و ایجاد کارگاه
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    const priceInput = document.getElementById('price_rials') as HTMLInputElement;
    const pricePreview = document.getElementById('price-toman-preview');
    const form = document.getElementById('create-workshop-form') as HTMLFormElement;
    const errorBox = document.getElementById('form-error');
    const successBox = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    // Auto slug suggestion
    if (titleInput && slugInput) {
      titleInput.addEventListener('blur', () => {
        if (!slugInput.value) {
          const suggested = titleInput.value.trim().toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
          if (suggested) slugInput.value = suggested;
        }
      });
    }

    // Live Toman preview
    if (priceInput && pricePreview) {
      priceInput.addEventListener('input', () => {
        const val = parseInt(priceInput.value, 10) || 0;
        if (val === 0) {
          pricePreview.textContent = 'معادل: رایگان';
        } else {
          const toman = Math.floor(val / 10);
          pricePreview.textContent = `معادل: ${toman.toLocaleString('fa-IR')} تومان`;
        }
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');
        if (successBox) successBox.classList.add('hidden');

        const startsAtVal = (document.getElementById('starts_at') as HTMLInputElement).value;
        const endsAtVal = (document.getElementById('ends_at') as HTMLInputElement).value;
        const deadlineVal = (document.getElementById('registration_deadline') as HTMLInputElement).value;

        if (!startsAtVal || !endsAtVal || !deadlineVal) {
          showError('لطفاً تمامی تاریخ‌ها و ساعت‌ها را مشخص نمایید.');
          return;
        }

        const startsAtISO = new Date(startsAtVal).toISOString();
        const endsAtISO = new Date(endsAtVal).toISOString();
        const deadlineISO = new Date(deadlineVal).toISOString();

        if (new Date(endsAtISO) <= new Date(startsAtISO)) {
          showError('زمان پایان کارگاه باید بعد از زمان شروع باشد.');
          return;
        }

        if (new Date(deadlineISO) > new Date(startsAtISO)) {
          showError('مهلت ثبت‌نام حداکثر تا زمان شروع کارگاه مجاز است.');
          return;
        }

        const payload = {
          title: titleInput.value.trim(),
          slug: slugInput.value.trim(),
          instructor_name: (document.getElementById('instructor_name') as HTMLInputElement).value.trim(),
          location: (document.getElementById('location') as HTMLInputElement).value.trim(),
          starts_at: startsAtISO,
          ends_at: endsAtISO,
          registration_deadline: deadlineISO,
          capacity: parseInt((document.getElementById('capacity') as HTMLInputElement).value, 10) || 1,
          price_rials: parseInt(priceInput.value, 10) || 0,
          description: (document.getElementById('description') as HTMLTextAreaElement).value.trim(),
        };

        submitBtn.disabled = true;
        submitBtn.textContent = 'در حال ذخیره‌سازی...';

        try {
          const res = await fetch('/admin/workshops', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok) {
            showError(data.message || 'خطا در ایجاد کارگاه.');
            submitBtn.disabled = false;
            submitBtn.textContent = 'ذخیره و ایجاد کارگاه';
            return;
          }

          if (successBox) {
            successBox.textContent = 'کارگاه با موفقیت ایجاد گردید. در حال انتقال...';
            successBox.classList.remove('hidden');
          }

          setTimeout(() => {
            window.location.href = `/workshops/${data.id || ''}`;
          }, 800);
        } catch {
          showError('خطا در برقراری ارتباط با سرور.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'ذخیره و ایجاد کارگاه';
        }
      });
    }

    function showError(msg: string) {
      if (errorBox) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }
    }
  </script>
</AdminLayout>
