---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Fallback sample data for SSR/preview
const now = new Date();
const t1 = new Date(now.getTime() + 24 * 3600 * 1000);
t1.setUTCHours(10, 0, 0, 0);
const t2 = new Date(now.getTime() + 48 * 3600 * 1000);
t2.setUTCHours(14, 0, 0, 0);
const t3 = new Date(now.getTime() - 24 * 3600 * 1000);
t3.setUTCHours(11, 0, 0, 0);

const fallbackAppointments = [
  {
    id: 'a0000001-1111-4000-8000-000000000001',
    therapist_id: 'e48a12bc-1111-4000-8000-000000000001',
    therapist_name: 'دکتر مریم علوی',
    slot_id: 's1111111-0000-4000-8000-000000000001',
    guest_name: 'سارا محمدی',
    guest_phone: '۰۹۱۲۳۴۵۶۷۸۹',
    notes: 'مشاوره اضطراب و استرس شغلی',
    status: 'pending',
    starts_at: t1.toISOString(),
    ends_at: new Date(t1.getTime() + 50 * 60 * 1000).toISOString(),
    created_at: new Date(now.getTime() - 30 * 60 * 1000).toISOString(),
  },
  {
    id: 'a0000002-2222-4000-8000-000000000002',
    therapist_id: 'e48a12bc-1111-4000-8000-000000000001',
    therapist_name: 'دکتر مریم علوی',
    slot_id: 's2222222-0000-4000-8000-000000000002',
    guest_name: 'علی حسینی',
    guest_phone: '۰۹۱۸۱۲۳۴۵۶۷',
    notes: 'جلسه پیگیری زوج‌درمانی',
    status: 'confirmed',
    starts_at: t2.toISOString(),
    ends_at: new Date(t2.getTime() + 50 * 60 * 1000).toISOString(),
    created_at: new Date(now.getTime() - 5 * 3600 * 1000).toISOString(),
  },
  {
    id: 'a0000003-3333-4000-8000-000000000003',
    therapist_id: 'e48a12bc-2222-4000-8000-000000000002',
    therapist_name: 'دکتر رضا مرادی',
    slot_id: 's3333333-0000-4000-8000-000000000003',
    guest_name: 'مهدی کریمی',
    guest_phone: '۰۹۳۵۰۰۰۱۱۲۲',
    notes: 'وسواس فکری',
    status: 'completed',
    starts_at: t3.toISOString(),
    ends_at: new Date(t3.getTime() + 45 * 60 * 1000).toISOString(),
    created_at: new Date(now.getTime() - 48 * 3600 * 1000).toISOString(),
  },
];

let appointments = fallbackAppointments;

const url = new URL(Astro.request.url);
const currentFilter = url.searchParams.get('status') || 'all';

const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const host = Astro.request.headers.get('host') || 'localhost:3001';
const cookie = Astro.request.headers.get('cookie') || '';

try {
  const queryStr = currentFilter !== 'all' ? `?status=${encodeURIComponent(currentFilter)}` : '';
  const res = await fetch(`${apiBase}/admin/appointments${queryStr}`, {
    headers: {
      Host: host,
      Cookie: cookie,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      appointments = data;
    }
  }
} catch {
  // Graceful fallback to preview demo data
}

if (currentFilter !== 'all') {
  appointments = appointments.filter((a) => a.status === currentFilter);
}

const pendingCount = fallbackAppointments.filter((a) => a.status === 'pending').length;
const confirmedCount = fallbackAppointments.filter((a) => a.status === 'confirmed').length;
const totalCount = fallbackAppointments.length;

function formatDateTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      weekday: 'short',
      month: 'numeric',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function getStatusBadge(st: string) {
  switch (st) {
    case 'confirmed':
      return { text: 'تأییدشده و قطعی', badgeClass: 'badge-success' };
    case 'pending':
      return { text: 'در انتظار تماس و تأیید', badgeClass: 'badge-info' };
    case 'cancelled':
      return { text: 'لغو شده', badgeClass: 'badge-error' };
    case 'expired':
      return { text: 'منقضی‌شده', badgeClass: 'badge-ghost' };
    case 'completed':
      return { text: 'انجام شد', badgeClass: 'badge-neutral' };
    default:
      return { text: st, badgeClass: 'badge-ghost' };
  }
}
---

<AdminLayout title="مدیریت نوبت‌ها و تقویم مشاوره" currentNav="appointments">
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="card bg-base-100 border border-base-200 border-e-4 border-e-primary rounded-box p-5 shadow-xs">
      <div class="text-xs text-base-content/70 mb-1 font-semibold">
        نوبت‌های در انتظار تأیید پذیرش
      </div>
      <div class="text-2xl font-bold text-primary">
        {pendingCount}
      </div>
      <div class="text-[11px] text-base-content/60 mt-1">
        نگه‌داشت موقت ۲ ساعته
      </div>
    </div>

    <div class="card bg-base-100 border border-base-200 border-e-4 border-e-success rounded-box p-5 shadow-xs">
      <div class="text-xs text-base-content/70 mb-1 font-semibold">
        نوبت‌های قطعی پیش‌رو
      </div>
      <div class="text-2xl font-bold text-success">
        {confirmedCount}
      </div>
      <div class="text-[11px] text-base-content/60 mt-1">
        آماده برگزاری در کلینیک
      </div>
    </div>

    <div class="card bg-base-100 border border-base-200 border-e-4 border-e-base-300 rounded-box p-5 shadow-xs">
      <div class="text-xs text-base-content/70 mb-1 font-semibold">
        کل نوبت‌های ثبت‌شده
      </div>
      <div class="text-2xl font-bold text-base-content">
        {totalCount}
      </div>
      <div class="text-[11px] text-base-content/60 mt-1">
        کلینیک به وقت تهران
      </div>
    </div>
  </div>

  <!-- Filter Navigation Tabs -->
  <div class="tabs tabs-boxed bg-base-100 p-1 mb-6 border border-base-200 rounded-lg w-fit">
    <a
      href="/appointments?status=all"
      class={`tab text-xs sm:text-sm font-medium ${currentFilter === 'all' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
    >
      همه نوبت‌ها
    </a>
    <a
      href="/appointments?status=pending"
      class={`tab text-xs sm:text-sm font-medium ${currentFilter === 'pending' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
    >
      در انتظار تأیید ({pendingCount})
    </a>
    <a
      href="/appointments?status=confirmed"
      class={`tab text-xs sm:text-sm font-medium ${currentFilter === 'confirmed' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
    >
      تأییدشده و قطعی
    </a>
    <a
      href="/appointments?status=completed"
      class={`tab text-xs sm:text-sm font-medium ${currentFilter === 'completed' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
    >
      انجام شده
    </a>
    <a
      href="/appointments?status=cancelled"
      class={`tab text-xs sm:text-sm font-medium ${currentFilter === 'cancelled' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
    >
      لغو شده / منقضی
    </a>
  </div>

  <!-- Appointments Table -->
  <div class="card bg-base-100 border border-base-200 rounded-box shadow-xs overflow-x-auto">
    <table class="table table-zebra w-full text-start text-xs">
      <thead>
        <tr class="bg-base-200/50 text-base-content/70">
          <th>مراجع (نام و تماس)</th>
          <th>درمانگر</th>
          <th>تاریخ و ساعت (تهران)</th>
          <th>وضعیت</th>
          <th class="text-end">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {appointments.length === 0 ? (
          <tr>
            <td colspan="5" class="py-8 text-center text-base-content/60">
              هیچ نوبتی با این وضعیت ثبت نشده است.
            </td>
          </tr>
        ) : (
          appointments.map((appt) => {
            const badge = getStatusBadge(appt.status);
            return (
              <tr class="hover">
                <td>
                  <div class="font-bold text-base-content text-sm mb-0.5">
                    {appt.guest_name}
                  </div>
                  <div class="text-xs text-primary font-mono" dir="ltr">
                    <a href={`tel:${appt.guest_phone}`} class="hover:underline">
                      {appt.guest_phone}
                    </a>
                  </div>
                </td>
                <td class="font-semibold text-base-content/90">
                  {appt.therapist_name}
                </td>
                <td>
                  <div class="font-bold text-base-content text-xs">
                    {formatDateTehran(appt.starts_at)}
                  </div>
                </td>
                <td>
                  <span class={`badge ${badge.badgeClass} badge-sm font-medium`}>
                    {badge.text}
                  </span>
                </td>
                <td class="text-end">
                  <div class="flex gap-1 justify-end items-center flex-wrap">
                    {appt.status === 'pending' && (
                      <button
                        type="button"
                        class="confirm-btn btn btn-success btn-xs font-medium"
                        data-id={appt.id}
                      >
                        تأیید نوبت
                      </button>
                    )}

                    {appt.status === 'confirmed' && (
                      <button
                        type="button"
                        class="reschedule-btn btn btn-primary btn-xs font-medium"
                        data-id={appt.id}
                        data-therapist-id={appt.therapist_id}
                        data-therapist-name={appt.therapist_name}
                      >
                        جابه‌جایی
                      </button>
                    )}

                    {(appt.status === 'pending' || appt.status === 'confirmed') && (
                      <button
                        type="button"
                        class="cancel-btn btn btn-error btn-outline btn-xs font-medium"
                        data-id={appt.id}
                      >
                        لغو
                      </button>
                    )}

                    <button
                      type="button"
                      class="history-btn btn btn-ghost btn-xs text-base-content/70 font-medium"
                      data-id={appt.id}
                    >
                      تاریخچه
                    </button>
                  </div>
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>
  </div>

  <!-- Cancel Modal -->
  <div id="cancel-modal" class="hidden fixed inset-0 bg-neutral/60 backdrop-blur-xs z-50 items-center justify-center p-4">
    <div class="card bg-base-100 border border-base-200 rounded-box max-w-md w-full p-6 shadow-xl">
      <h3 class="text-base font-bold text-error mb-2">
        لغو نوبت توسط پذیرش کلینیک
      </h3>
      <p class="text-xs text-base-content/70 mb-4 leading-relaxed">
        با ثبت لغو، سانس مربوطه آزاد شده و علت لغو در سوابق نوبت و لاگ ممیزی ثبت می‌شود.
      </p>
      <input type="hidden" id="cancel-target-id" value="" />
      <div class="mb-4">
        <label for="cancel-reason" class="block text-xs font-semibold text-base-content/80 mb-1">
          علت لغو نوبت:
        </label>
        <textarea
          id="cancel-reason"
          rows="2"
          placeholder="مثال: عدم پاسخگویی مراجع در هماهنگی تلفنی یا درخواست انصراف مراجع"
          class="textarea textarea-bordered textarea-sm w-full text-xs"
        ></textarea>
      </div>
      <div id="cancel-err-msg" class="hidden alert alert-error text-xs font-medium mb-4"></div>
      <div class="flex gap-2">
        <button id="do-cancel-btn" type="button" class="btn btn-error btn-sm flex-1 font-medium">
          تأیید لغو نوبت
        </button>
        <button id="close-cancel-btn" type="button" class="btn btn-ghost btn-sm font-medium">
          انصراف
        </button>
      </div>
    </div>
  </div>

  <!-- Reschedule Modal -->
  <div id="reschedule-modal" class="hidden fixed inset-0 bg-neutral/60 backdrop-blur-xs z-50 items-center justify-center p-4">
    <div class="card bg-base-100 border border-base-200 rounded-box max-w-lg w-full p-6 shadow-xl">
      <h3 class="text-base font-bold text-primary mb-2">
        جابه‌جایی نوبت به سانس آزاد جدید
      </h3>
      <p class="text-xs text-base-content/70 mb-4">
        درمانگر: <strong id="reschedule-th-name" class="text-base-content">-</strong>
      </p>
      <input type="hidden" id="reschedule-target-id" value="" />
      <div class="mb-4">
        <label for="reschedule-new-slot" class="block text-xs font-semibold text-base-content/80 mb-1">
          انتخاب سانس جدید:
        </label>
        <select
          id="reschedule-new-slot"
          class="select select-bordered select-sm w-full text-xs"
        >
          <option value="">در حال دریافت سانس‌های آزاد...</option>
        </select>
      </div>
      <div class="mb-4">
        <label for="reschedule-reason" class="block text-xs font-semibold text-base-content/80 mb-1">
          علت جابه‌جایی نوبت:
        </label>
        <input
          type="text"
          id="reschedule-reason"
          placeholder="هماهنگی تلفنی با مراجع"
          class="input input-bordered input-sm w-full text-xs"
        />
      </div>
      <div id="reschedule-err-msg" class="hidden alert alert-error text-xs font-medium mb-4"></div>
      <div class="flex gap-2">
        <button id="do-reschedule-btn" type="button" class="btn btn-primary btn-sm flex-1 font-medium">
          ثبت جابه‌جایی اتمیک
        </button>
        <button id="close-reschedule-btn" type="button" class="btn btn-ghost btn-sm font-medium">
          انصراف
        </button>
      </div>
    </div>
  </div>

  <!-- History Modal -->
  <div id="history-modal" class="hidden fixed inset-0 bg-neutral/60 backdrop-blur-xs z-50 items-center justify-center p-4">
    <div class="card bg-base-100 border border-base-200 rounded-box max-w-lg w-full p-6 shadow-xl max-h-[80vh] flex flex-col">
      <h3 class="text-base font-bold text-base-content mb-3 pb-2 border-b border-base-200">
        تاریخچه و ردگیری وضعیت نوبت
      </h3>
      <div id="history-content" class="flex-1 overflow-y-auto py-2 text-xs">
        در حال بارگذاری سوابق...
      </div>
      <div class="mt-4 pt-3 border-t border-base-200 text-end">
        <button id="close-history-btn" type="button" class="btn btn-ghost btn-sm font-medium">
          بستن
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ apiBase }}>
    // Confirm Appointment
    document.querySelectorAll('.confirm-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const apptId = btn.getAttribute('data-id');
        if (!confirm('آیا از تأیید قطعی این نوبت اطمینان دارید؟')) return;

        btn.disabled = true;
        btn.textContent = 'در حال ثبت...';

        try {
          const res = await fetch(`${apiBase}/admin/appointments/${apptId}/confirm`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Host': window.location.host,
            },
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.message || 'خطا در تأیید نوبت.');
            btn.disabled = false;
            btn.textContent = 'تأیید نوبت';
          }
        } catch {
          alert('خطای اتصال به سرور.');
          btn.disabled = false;
          btn.textContent = 'تأیید نوبت';
        }
      });
    });

    // Cancel Modal
    const cancelModal = document.getElementById('cancel-modal');
    const cancelTargetId = document.getElementById('cancel-target-id');
    const cancelReason = document.getElementById('cancel-reason');
    const cancelErrMsg = document.getElementById('cancel-err-msg');
    const doCancelBtn = document.getElementById('do-cancel-btn');
    const closeCancelBtn = document.getElementById('close-cancel-btn');

    document.querySelectorAll('.cancel-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        cancelTargetId.value = btn.getAttribute('data-id') || '';
        cancelReason.value = '';
        cancelErrMsg.classList.add('hidden');
        cancelModal.classList.remove('hidden');
        cancelModal.classList.add('flex');
      });
    });

    closeCancelBtn?.addEventListener('click', () => {
      cancelModal.classList.add('hidden');
      cancelModal.classList.remove('flex');
    });

    doCancelBtn?.addEventListener('click', async () => {
      const apptId = cancelTargetId.value;
      const reason = cancelReason.value.trim();
      doCancelBtn.disabled = true;
      doCancelBtn.textContent = 'در حال ثبت...';
      cancelErrMsg.classList.add('hidden');

      try {
        const res = await fetch(`${apiBase}/admin/appointments/${apptId}/cancel`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Host': window.location.host,
          },
          body: JSON.stringify({ reason }),
        });

        if (res.ok) {
          window.location.reload();
          return;
        }
        const err = await res.json().catch(() => ({}));
        cancelErrMsg.classList.remove('hidden');
        cancelErrMsg.textContent = err.message || 'خطا در لغو نوبت.';
      } catch {
        cancelErrMsg.classList.remove('hidden');
        cancelErrMsg.textContent = 'خطای اتصال به سرور.';
      } finally {
        doCancelBtn.disabled = false;
        doCancelBtn.textContent = 'تأیید لغو نوبت';
      }
    });

    // Reschedule Modal
    const rescheduleModal = document.getElementById('reschedule-modal');
    const rescheduleTargetId = document.getElementById('reschedule-target-id');
    const rescheduleThName = document.getElementById('reschedule-th-name');
    const rescheduleNewSlot = document.getElementById('reschedule-new-slot');
    const rescheduleReason = document.getElementById('reschedule-reason');
    const rescheduleErrMsg = document.getElementById('reschedule-err-msg');
    const doRescheduleBtn = document.getElementById('do-reschedule-btn');
    const closeRescheduleBtn = document.getElementById('close-reschedule-btn');

    document.querySelectorAll('.reschedule-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const apptId = btn.getAttribute('data-id') || '';
        const thId = btn.getAttribute('data-therapist-id') || '';
        const thName = btn.getAttribute('data-therapist-name') || '';

        rescheduleTargetId.value = apptId;
        rescheduleThName.textContent = thName;
        rescheduleReason.value = 'هماهنگی تلفنی با مراجع';
        rescheduleErrMsg.classList.add('hidden');
        rescheduleNewSlot.innerHTML = '<option value="">در حال دریافت سانس‌های آزاد...</option>';
        rescheduleModal.classList.remove('hidden');
        rescheduleModal.classList.add('flex');

        try {
          const res = await fetch(`${apiBase}/public/therapists/${thId}/slots`, {
            headers: { Host: window.location.host },
          });
          if (res.ok) {
            const slots = await res.json();
            if (slots.length === 0) {
              rescheduleNewSlot.innerHTML = '<option value="">سانس خالی موجود نیست</option>';
            } else {
              rescheduleNewSlot.innerHTML = slots.map((s) => {
                const dStr = new Intl.DateTimeFormat('fa-IR', {
                  timeZone: 'Asia/Tehran',
                  month: 'numeric',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                }).format(new Date(s.starts_at));
                return `<option value="${s.id}">${dStr} (سانس آزاد)</option>`;
              }).join('');
            }
          }
        } catch {
          rescheduleNewSlot.innerHTML = '<option value="">خطا در دریافت سانس‌ها</option>';
        }
      });
    });

    closeRescheduleBtn?.addEventListener('click', () => {
      rescheduleModal.classList.add('hidden');
      rescheduleModal.classList.remove('flex');
    });

    doRescheduleBtn?.addEventListener('click', async () => {
      const apptId = rescheduleTargetId.value;
      const newSlotId = rescheduleNewSlot.value;
      const reason = rescheduleReason.value.trim();

      if (!newSlotId) {
        alert('لطفاً یک سانس جدید انتخاب کنید.');
        return;
      }

      doRescheduleBtn.disabled = true;
      doRescheduleBtn.textContent = 'در حال جابه‌جایی...';
      rescheduleErrMsg.classList.add('hidden');

      try {
        const res = await fetch(`${apiBase}/admin/appointments/${apptId}/reschedule`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Host': window.location.host,
          },
          body: JSON.stringify({ new_slot_id: newSlotId, reason }),
        });

        if (res.ok) {
          window.location.reload();
          return;
        }

        const err = await res.json().catch(() => ({}));
        rescheduleErrMsg.classList.remove('hidden');
        if (res.status === 409) {
          rescheduleErrMsg.textContent = 'سانس انتخابی پر شده است. لطفاً سانس دیگری انتخاب نمایید (نوبت قبلی تغییر نکرد).';
        } else {
          rescheduleErrMsg.textContent = err.message || 'خطا در جابه‌جایی نوبت.';
        }
      } catch {
        rescheduleErrMsg.classList.remove('hidden');
        rescheduleErrMsg.textContent = 'خطای اتصال به سرور.';
      } finally {
        doRescheduleBtn.disabled = false;
        doRescheduleBtn.textContent = 'ثبت جابه‌جایی اتمیک';
      }
    });

    // History Modal
    const historyModal = document.getElementById('history-modal');
    const historyContent = document.getElementById('history-content');
    const closeHistoryBtn = document.getElementById('close-history-btn');

    document.querySelectorAll('.history-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const apptId = btn.getAttribute('data-id') || '';
        historyContent.innerHTML = 'در حال دریافت سوابق...';
        historyModal.classList.remove('hidden');
        historyModal.classList.add('flex');

        try {
          const res = await fetch(`${apiBase}/admin/appointments/${apptId}/history`, {
            headers: { Host: window.location.host },
          });
          if (res.ok) {
            const list = await res.json();
            if (!list || list.length === 0) {
              historyContent.innerHTML = '<div class="text-base-content/60 text-center py-4">سابقه‌ای برای این نوبت ثبت نشده است.</div>';
            } else {
              historyContent.innerHTML = list.map((h) => {
                const tStr = new Intl.DateTimeFormat('fa-IR', {
                  timeZone: 'Asia/Tehran',
                  dateStyle: 'medium',
                  timeStyle: 'short',
                }).format(new Date(h.created_at));
                return `
                  <div class="border-e-2 border-e-primary pe-3 mb-3">
                    <div class="font-bold text-base-content text-xs">
                      تغییر وضعیت: <span class="text-primary">${h.from_status || 'شروع'} &larr; ${h.to_status}</span>
                    </div>
                    <div class="text-[11px] text-base-content/60 my-0.5">
                      اقدام‌کننده: <strong>${h.actor_role}</strong> (${tStr})
                    </div>
                    ${h.note ? `<div class="text-[11px] text-base-content/80 bg-base-200/50 p-1.5 rounded-sm">علت: ${h.note}</div>` : ''}
                  </div>
                `;
              }).join('');
            }
          } else {
            historyContent.innerHTML = '<div class="text-error">خطا در دریافت سوابق تاریخچه.</div>';
          }
        } catch {
          historyContent.innerHTML = '<div class="text-error">خطای اتصال به سرور.</div>';
        }
      });
    });

    closeHistoryBtn?.addEventListener('click', () => {
      historyModal.classList.add('hidden');
      historyModal.classList.remove('flex');
    });
  </script>
</AdminLayout>
