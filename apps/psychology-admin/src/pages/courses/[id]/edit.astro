---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { AdminCourseItem } from '@psychology/api-client';

const { id } = Astro.params;
const apiBase = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';
const host = Astro.request.headers.get('host') || 'localhost:3001';

// Fallback demo course
let course: AdminCourseItem = {
  id: id || 'c1111111-1111-1111-1111-111111111111',
  title: 'مدیریت جامع اضطراب و نشخوار فکری',
  slug: 'anxiety-management',
  description: 'مهارت‌های شناختی-رفتاری (CBT) برای مهار استرس روزمره و حملات پانیک',
  instructor_name: 'دکتر مریم علوی',
  price_rials: 15000000,
  status: 'draft',
  lessons_count: 5,
  published_at: null,
  created_at: '2026-11-10T10:00:00Z',
  updated_at: '2026-11-10T10:00:00Z',
};

try {
  const res = await fetch(`${apiBase}/v1/admin/courses/${id}`, {
    headers: {
      Host: host,
      ...(sessionToken ? { Cookie: `session_token=${sessionToken}` } : {}),
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (data && data.id) {
      course = data;
    }
  }
} catch {
  // Use fallback
}

const priceTomans = Math.floor(course.price_rials / 10);
---

<AdminLayout title={`ویرایش دوره: ${course.title}`} currentNav="courses">
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    <!-- Top Bar -->
    <div class="flex justify-between items-center flex-wrap gap-4">
      <div>
        <h2 class="text-xl font-bold text-base-content">ویرایش مشخصات دوره آموزشی</h2>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-xs text-base-content/70">وضعیت جاری:</span>
          <span class="badge badge-warning badge-xs font-semibold">
            {course.status === 'published' ? 'منتشرشده' : course.status === 'archived' ? 'بایگانی‌شده' : 'پیش‌نویس'}
          </span>
        </div>
      </div>
      <div class="flex gap-2 items-center">
        <a href={`/courses/${course.id}/lessons`} class="btn btn-ghost btn-sm text-primary font-medium">
          🎬 مدیریت جلسات ({course.lessons_count} جلسه)
        </a>
        <a href="/courses" class="btn btn-ghost btn-xs text-base-content/60">
          ← لیست دوره‌ها
        </a>
      </div>
    </div>

    <!-- Edit Form Card -->
    <div class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 shadow-xs">
      <form id="edit-course-form" class="flex flex-col gap-5" data-id={course.id}>
        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="title">
            عنوان دوره <span class="text-error">*</span>
          </label>
          <input type="text" id="title" name="title" required value={course.title} class="input input-bordered input-sm w-full" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="slug">
              نامک انگلیسی (Slug) <span class="text-error">*</span>
            </label>
            <input type="text" id="slug" name="slug" required value={course.slug} class="input input-bordered input-sm w-full font-mono text-xs" dir="ltr" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="instructor_name">
              نام مدرس دوره <span class="text-error">*</span>
            </label>
            <input type="text" id="instructor_name" name="instructor_name" required value={course.instructor_name} class="input input-bordered input-sm w-full" />
          </div>
        </div>

        <div>
          <label for="topic" class="block text-xs font-semibold text-base-content/80 mb-1">موضوع آموزش (اختیاری)</label>
          <input id="topic" name="topic" type="text" maxlength="80" value={course.topic} class="input input-bordered input-sm w-full" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="price_tomans">
            مبلغ دوره (تومان) <span class="text-error">*</span>
          </label>
          <input type="number" id="price_tomans" name="price_tomans" required min="0" step="1000" value={priceTomans} class="input input-bordered input-sm w-full" />
          <span class="text-[11px] text-base-content/60 mt-1 block">مبلغ در سیستم با دقت کامل ریالی ذخیره می‌شود.</span>
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="description">توضیحات و اهداف آموزشی دوره</label>
          <textarea id="description" name="description" rows="4" class="textarea textarea-bordered textarea-sm w-full">{course.description}</textarea>
        </div>

        <div class="flex justify-between items-center mt-2 pt-4 border-t border-base-200 flex-wrap gap-4">
          <div class="flex gap-2">
            {course.status === 'draft' && (
              <button type="button" class="btn btn-success btn-sm font-medium" id="publish-btn">
                🚀 انتشار عمومی دوره
              </button>
            )}
            {course.status === 'published' && (
              <button type="button" class="btn btn-warning btn-sm font-medium" id="archive-btn">
                📦 بایگانی دوره
              </button>
            )}
          </div>

          <div class="flex gap-2">
            <a href="/courses" class="btn btn-ghost btn-sm font-medium">انصراف</a>
            <button type="submit" class="btn btn-primary btn-sm font-medium" id="save-btn">
              💾 ذخیره تغییرات
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('edit-course-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const courseId = form?.dataset.id;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.innerText = 'در حال ذخیره...';

      const formData = new FormData(form);
      const title = String(formData.get('title') || '').trim();
      const slug = String(formData.get('slug') || '').trim();
      const instructor_name = String(formData.get('instructor_name') || '').trim();
      const description = String(formData.get('description') || '').trim();
      const price_tomans = Number(formData.get('price_tomans') || 0);
      const price_rials = price_tomans * 10;

      try {
        const res = await fetch(`/v1/admin/courses/${courseId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            slug,
            instructor_name,
            topic: String(formData.get('topic') ?? ''),
            description,
            price_rials,
          }),
        });

        if (res.ok) {
          alert('تغییرات دوره با موفقیت ذخیره شد.');
          window.location.href = '/courses';
        } else {
          const err = await res.json();
          alert('خطا در ذخیره تغییرات: ' + (err.message || 'خطا در اعتبارسنجی'));
          saveBtn.disabled = false;
          saveBtn.innerText = '💾 ذخیره تغییرات';
        }
      } catch {
        alert('خطای ارتباط با سرور.');
        saveBtn.disabled = false;
        saveBtn.innerText = '💾 ذخیره تغییرات';
      }
    });

    const publishBtn = document.getElementById('publish-btn');
    publishBtn?.addEventListener('click', async () => {
      if (!confirm('آیا از انتشار عمومی دوره اطمینان دارید؟ دوره باید حداقل ۱ جلسه داشته باشد.')) return;
      try {
        const res = await fetch(`/v1/admin/courses/${courseId}/publish`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          alert('دوره منتشر شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('خطا در انتشار: ' + (err.message || 'حداقل ۱ جلسه نیاز است'));
        }
      } catch {
        alert('خطای ارتباط با سرور.');
      }
    });

    const archiveBtn = document.getElementById('archive-btn');
    archiveBtn?.addEventListener('click', async () => {
      if (!confirm('آیا از بایگانی دوره اطمینان دارید؟ فروش جدید متوقف می‌شود.')) return;
      try {
        const res = await fetch(`/v1/admin/courses/${courseId}/archive`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          alert('دوره بایگانی شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('خطا در بایگانی: ' + (err.message || 'خطا'));
        }
      } catch {
        alert('خطای ارتباط با سرور.');
      }
    });
  </script>
</AdminLayout>
