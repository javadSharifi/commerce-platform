---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { AdminCourseItem } from '@psychology/api-client';

const { id } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';

// Fallback demo course
let course: AdminCourseItem = {
  id: id || 'c1111111-1111-1111-1111-111111111111',
  title: 'مدیریت جامع اضطراب و نشخوار فکری',
  slug: 'anxiety-management',
  description: 'مهارت‌های شناختی-رفتاری (CBT) برای مهار استرس روزمره و حملات پانیک',
  instructor_name: 'دکتر مریم علوی',
  price_rials: 15000000,
  status: 'draft',
  lessons_count: 5,
  published_at: null,
  created_at: '2026-11-10T10:00:00Z',
  updated_at: '2026-11-10T10:00:00Z',
};

try {
  const res = await fetch(`${apiBase}/admin/courses/${id}`, {
    headers: {
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (data && data.id) {
      course = data;
    }
  }
} catch {
  // Use fallback
}

const priceTomans = Math.floor(course.price_rials / 10);
---

<AdminLayout title={`ویرایش دوره: ${course.title}`} currentNav="courses">
  <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Top Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 700; color: #0f172a;">ویرایش مشخصات دوره آموزشی</h2>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
          <span style="font-size: 0.85rem; color: #64748b;">وضعیت جاری:</span>
          <span style="font-size: 0.8rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 9999px; background: #fef3c7; color: #92400e;">
            {course.status === 'published' ? 'منتشرشده' : course.status === 'archived' ? 'بایگانی‌شده' : 'پیش‌نویس'}
          </span>
        </div>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <a href={`/courses/${course.id}/lessons`} class="btn-secondary">
          🎬 مدیریت جلسات ({course.lessons_count} جلسه)
        </a>
        <a href="/courses" style="font-size: 0.9rem; color: #64748b; text-decoration: none; display: flex; align-items: center; gap: 0.25rem; margin-right: 0.5rem;">
          ← لیست دوره‌ها
        </a>
      </div>
    </div>

    <!-- Edit Form Card -->
    <div class="card">
      <form id="edit-course-form" style="display: flex; flex-direction: column; gap: 1.25rem;" data-id={course.id}>
        <div>
          <label class="form-label" for="title">عنوان دوره <span style="color: #ef4444;">*</span></label>
          <input type="text" id="title" name="title" required value={course.title} class="form-input" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div>
            <label class="form-label" for="slug">نامک انگلیسی (Slug) <span style="color: #ef4444;">*</span></label>
            <input type="text" id="slug" name="slug" required value={course.slug} class="form-input" dir="ltr" />
          </div>

          <div>
            <label class="form-label" for="instructor_name">نام مدرس دوره <span style="color: #ef4444;">*</span></label>
            <input type="text" id="instructor_name" name="instructor_name" required value={course.instructor_name} class="form-input" />
          </div>
        </div>

        <div>
          <label class="form-label" for="price_tomans">مبلغ دوره (تومان) <span style="color: #ef4444;">*</span></label>
          <input type="number" id="price_tomans" name="price_tomans" required min="0" step="1000" value={priceTomans} class="form-input" />
          <span style="font-size: 0.75rem; color: #64748b;">مبلغ در سیستم با دقت کامل ریالی ذخیره می‌شود.</span>
        </div>

        <div>
          <label class="form-label" for="description">توضیحات و اهداف آموزشی دوره</label>
          <textarea id="description" name="description" rows="5" class="form-input">{course.description}</textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e2e8f0; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; gap: 0.5rem;">
            {course.status === 'draft' && (
              <button type="button" class="btn-publish" id="publish-btn">
                🚀 انتشار عمومی دوره
              </button>
            )}
            {course.status === 'published' && (
              <button type="button" class="btn-archive" id="archive-btn">
                📦 بایگانی دوره
              </button>
            )}
          </div>

          <div style="display: flex; gap: 0.75rem;">
            <a href="/courses" class="btn-secondary">انصراف</a>
            <button type="submit" class="btn-primary" id="save-btn">
              💾 ذخیره تغییرات
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <style>
    .form-label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 0.4rem;
    }
    .form-input {
      width: 100%;
      padding: 0.65rem 0.85rem;
      border: 1px solid #cbd5e1;
      border-radius: 0.5rem;
      font-family: inherit;
      font-size: 0.9rem;
      color: #0f172a;
      box-sizing: border-box;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-input:focus {
      outline: none;
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.1);
    }
    .btn-primary {
      background: #0284c7;
      color: #ffffff;
      padding: 0.6rem 1.4rem;
      border: none;
      border-radius: 0.5rem;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .btn-primary:hover {
      background: #0369a1;
    }
    .btn-secondary {
      background: #f1f5f9;
      color: #475569;
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      border: 1px solid #e2e8f0;
    }
    .btn-secondary:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    .btn-publish {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .btn-publish:hover {
      background: #bbf7d0;
    }
    .btn-archive {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .btn-archive:hover {
      background: #fecaca;
    }
  </style>

  <script>
    const form = document.getElementById('edit-course-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
    const archiveBtn = document.getElementById('archive-btn') as HTMLButtonElement;
    const courseId = form?.dataset.id;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.innerText = 'در حال ذخیره...';

      const formData = new FormData(form);
      const title = String(formData.get('title') || '').trim();
      const slug = String(formData.get('slug') || '').trim();
      const instructor_name = String(formData.get('instructor_name') || '').trim();
      const priceTomans = Number(formData.get('price_tomans') || 0);
      const description = String(formData.get('description') || '').trim();

      const priceRials = priceTomans * 10;

      try {
        const res = await fetch(`/admin/courses/${courseId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            slug,
            instructor_name,
            price_rials: priceRials,
            description,
          }),
        });

        if (res.ok) {
          alert('تغییرات دوره با موفقیت ذخیره شد.');
          window.location.href = '/courses';
        } else {
          const err = await res.json();
          alert('خطا در ذخیره: ' + (err.message || 'خطا'));
          saveBtn.disabled = false;
          saveBtn.innerText = '💾 ذخیره تغییرات';
        }
      } catch {
        alert('خطای ارتباط با سرور.');
        saveBtn.disabled = false;
        saveBtn.innerText = '💾 ذخیره تغییرات';
      }
    });

    publishBtn?.addEventListener('click', async () => {
      if (!confirm('آیا از انتشار عمومی این دوره اطمینان دارید؟ دوره باید حداقل ۱ جلسه آماده داشته باشد.')) return;
      try {
        const res = await fetch(`/admin/courses/${courseId}/publish`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          alert('دوره با موفقیت منتشر شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('خطا در انتشار دوره: ' + (err.message || 'حداقل ۱ جلسه مورد نیاز است'));
        }
      } catch {
        alert('خطای ارتباط با سرور.');
      }
    });

    archiveBtn?.addEventListener('click', async () => {
      if (!confirm('آیا از بایگانی این دوره اطمینان دارید؟')) return;
      try {
        const res = await fetch(`/admin/courses/${courseId}/archive`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          alert('دوره بایگانی شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('خطا در بایگانی دوره: ' + (err.message || 'خطا'));
        }
      } catch {
        alert('خطای ارتباط با سرور.');
      }
    });
  </script>
</AdminLayout>
