---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { AdminCourseItem, AdminLessonItem } from '@psychology/api-client';

const { id } = Astro.params;
const apiBase = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';
const host = Astro.request.headers.get('host') || 'localhost:3001';

// Fallback demo course & lessons
let course: AdminCourseItem = {
  id: id || 'c1111111-1111-1111-1111-111111111111',
  title: 'مدیریت جامع اضطراب و نشخوار فکری',
  slug: 'anxiety-management',
  description: 'مهارت‌های شناختی-رفتاری برای مهار استرس روزمره',
  instructor_name: 'دکتر مریم علوی',
  price_rials: 15000000,
  status: 'published',
  lessons_count: 3,
  published_at: '2026-11-10T10:00:00Z',
  created_at: '2026-11-10T10:00:00Z',
  updated_at: '2026-11-10T10:00:00Z',
};

let lessons: AdminLessonItem[] = [
  {
    id: 'l1111111-1111-1111-1111-111111111111',
    course_id: id || 'c111',
    title: 'درس اول: فیزیولوژی اضطراب و سیستم عصبی',
    description: 'بررسی ریشه‌های تکاملی و جسمانی برانگیختگی هیجانی',
    display_order: 1,
    media_asset_id: 'm1111111-1111-1111-1111-111111111111',
    duration_seconds: 1200,
    is_free_preview: true,
    created_at: '2026-11-10T10:00:00Z',
    updated_at: '2026-11-10T10:00:00Z',
  },
  {
    id: 'l2222222-2222-2222-2222-222222222222',
    course_id: id || 'c111',
    title: 'درس دوم: تکنیک‌های فوری آرام‌سازی و تنفس دیافراگمی',
    description: 'تمرین‌های تنفسی ۴-۷-۸ و تنظیم تپش قلب در مواقع تنش',
    display_order: 2,
    media_asset_id: 'm2222222-2222-2222-2222-222222222222',
    duration_seconds: 1800,
    is_free_preview: false,
    created_at: '2026-11-11T12:00:00Z',
    updated_at: '2026-11-11T12:00:00Z',
  },
  {
    id: 'l3333333-3333-3333-3333-333333333333',
    course_id: id || 'c111',
    title: 'درس سوم: بازسازی شناختی و چالش با خطاهای فکری',
    description: 'شناسایی فاجعه‌سازی و ذهن‌خوانی در افکار خودآیند منفی',
    display_order: 3,
    media_asset_id: 'm3333333-3333-3333-3333-333333333333',
    duration_seconds: 2400,
    is_free_preview: false,
    created_at: '2026-11-12T15:00:00Z',
    updated_at: '2026-11-12T15:00:00Z',
  },
];

try {
  // Fetch course detail
  const cRes = await fetch(`${apiBase}/v1/admin/courses/${id}`, {
    headers: {
      Host: host,
      ...(sessionToken ? { Cookie: `session_token=${sessionToken}` } : {}),
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (cRes.ok) {
    const data = await cRes.json();
    if (data && data.id) course = data;
  }

  // Fetch lessons list
  const lRes = await fetch(`${apiBase}/v1/admin/courses/${id}/lessons`, {
    headers: {
      Host: host,
      ...(sessionToken ? { Cookie: `session_token=${sessionToken}` } : {}),
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (lRes.ok) {
    const lData = await lRes.json();
    if (Array.isArray(lData)) lessons = lData;
  }
} catch {
  // Use fallback preview
}

function formatDuration(seconds: number) {
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
}
---

<AdminLayout title={`مدیریت جلسات دوره: ${course.title}`} currentNav="courses">
  <div class="flex flex-col gap-6">
    <!-- Header -->
    <div class="flex justify-between items-center flex-wrap gap-4">
      <div>
        <h2 class="text-xl font-bold text-base-content">جلسات دوره: {course.title}</h2>
        <p class="text-xs text-base-content/70 mt-1">
          مدرس: {course.instructor_name} · وضعیت: {course.status === 'published' ? 'منتشرشده' : course.status === 'archived' ? 'بایگانی‌شده' : 'پیش‌نویس'}
        </p>
      </div>
      <div class="flex gap-2 items-center">
        <a href={`/courses/${course.id}/edit`} class="btn btn-ghost btn-sm text-base-content/80 font-medium">
          ✏️ ویرایش مشخصات دوره
        </a>
        <a href="/courses" class="btn btn-ghost btn-xs text-base-content/60">
          ← لیست دوره‌ها
        </a>
      </div>
    </div>

    <!-- Security & Storage Separation Alert -->
    <div class="alert alert-success bg-success/10 border-success/30 text-success text-xs leading-relaxed p-4 rounded-box">
      <span>🔒</span>
      <div>
        <strong class="font-bold">جداسازی رسانه‌های دوره و سهمیه ذخیره‌سازی:</strong>
        طبق الزامات سخت امنیتی، فایل‌های ویدیویی و صوتی دروس در کلاس دسترسی خصوصی <code>course_private</code> نگه‌داری می‌شوند (سقف ۵۱۲ مگابایت ویدیو و ۱۲۸ مگابایت صوت). رسانه‌های عمومی بلاگ یا فایل‌های تأییدنشده مجاز به اتصال به دروس نیستند و فقط با احراز دسترسی خرید قابل استریم خواهند بود.
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Lessons Table -->
      <div class="lg:col-span-2 card bg-base-100 border border-base-200 rounded-box shadow-xs overflow-x-auto">
        <div class="p-4 border-b border-base-200 flex justify-between items-center">
          <h3 class="text-sm font-bold text-base-content">فهرست جلسات دوره ({lessons.length} جلسه)</h3>
          <span class="text-xs text-base-content/60">مرتب‌شده بر اساس ترتیب نمایش</span>
        </div>

        <table class="table table-zebra w-full text-start text-xs">
          <thead>
            <tr class="bg-base-200/50 text-base-content/70">
              <th class="w-14 text-center">ترتیب</th>
              <th>عنوان و شرح جلسه</th>
              <th>نوع دسترسی</th>
              <th>مدت زمان</th>
              <th class="text-end">عملیات</th>
            </tr>
          </thead>
          <tbody>
            {lessons.length === 0 ? (
              <tr>
                <td colspan="5" class="py-8 text-center text-base-content/60">
                  هنوز هیچ جلسه‌ای برای این دوره ثبت نشده است. از فرم روبرو اولین جلسه را اضافه کنید.
                </td>
              </tr>
            ) : (
              lessons.map((lesson) => (
                <tr class="hover">
                  <td class="font-bold text-primary text-center">
                    {lesson.display_order}
                  </td>
                  <td>
                    <div class="font-bold text-base-content text-sm">{lesson.title}</div>
                    {lesson.description && (
                      <div class="text-xs text-base-content/70 mt-0.5">{lesson.description}</div>
                    )}
                    <div class="text-[11px] text-base-content/50 font-mono mt-1">
                      شناسه رسانه: {lesson.media_asset_id}
                    </div>
                  </td>
                  <td>
                    {lesson.is_free_preview ? (
                      <span class="badge badge-success badge-xs font-medium">
                        پیش‌نمایش رایگان
                      </span>
                    ) : (
                      <span class="badge badge-info badge-xs font-medium">
                        خریداران دوره
                      </span>
                    )}
                  </td>
                  <td class="font-mono text-base-content/80">
                    {formatDuration(lesson.duration_seconds)}
                  </td>
                  <td class="text-end">
                    <button
                      type="button"
                      class="btn-delete-lesson btn btn-error btn-outline btn-xs font-medium"
                      data-id={lesson.id}
                      data-title={lesson.title}
                    >
                      حذف
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Add Lesson Form Card -->
      <div class="card bg-base-100 border border-base-200 rounded-box p-5 shadow-xs flex flex-col gap-4">
        <h3 class="text-sm font-bold text-base-content border-b border-base-200 pb-3">
          ➕ افزودن جلسه جدید
        </h3>

        <form id="add-lesson-form" class="flex flex-col gap-4" data-course-id={course.id}>
          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="lesson_title">
              عنوان جلسه <span class="text-error">*</span>
            </label>
            <input type="text" id="lesson_title" name="title" required placeholder="مثال: درس اول: مقدمات" class="input input-bordered input-sm w-full" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-base-content/80 mb-1" for="display_order">
                ترتیب <span class="text-error">*</span>
              </label>
              <input type="number" id="display_order" name="display_order" required min="1" value={lessons.length + 1} class="input input-bordered input-sm w-full" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-base-content/80 mb-1" for="duration_minutes">
                مدت (دقیقه) <span class="text-error">*</span>
              </label>
              <input type="number" id="duration_minutes" name="duration_minutes" required min="1" placeholder="مثال: ۲۵" class="input input-bordered input-sm w-full" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="media_asset_id">
              شناسه رسانه اختصاصی (course_private) <span class="text-error">*</span>
            </label>
            <input type="text" id="media_asset_id" name="media_asset_id" required placeholder="شناسه UUID رسانه" class="input input-bordered input-sm w-full font-mono text-xs" dir="ltr" />
            <span class="text-[11px] text-base-content/60 mt-1 block">
              فایل ویدیویی یا صوتی خصوصی از منوی <a href="/media" target="_blank" class="text-primary underline">رسانه‌ها</a>.
            </span>
          </div>

          <div>
            <label class="flex items-center gap-2 text-xs text-base-content/80 cursor-pointer">
              <input type="checkbox" id="is_free_preview" name="is_free_preview" value="true" class="checkbox checkbox-xs checkbox-primary" />
              <span>پیش‌نمایش رایگان (بدون نیاز به خرید دوره)</span>
            </label>
          </div>

          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="lesson_desc">توضیحات کوتاه جلسه</label>
            <textarea id="lesson_desc" name="description" rows="3" placeholder="توضیحات اختیاری..." class="textarea textarea-bordered textarea-sm w-full"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-sm w-full font-medium mt-1" id="add-lesson-btn">
            ثبت جلسه
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('add-lesson-form') as HTMLFormElement;
    const addBtn = document.getElementById('add-lesson-btn') as HTMLButtonElement;
    const courseId = form?.dataset.courseId;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      addBtn.disabled = true;
      addBtn.innerText = 'در حال ثبت...';

      const formData = new FormData(form);
      const title = String(formData.get('title') || '').trim();
      const display_order = Number(formData.get('display_order') || 1);
      const duration_minutes = Number(formData.get('duration_minutes') || 0);
      const duration_seconds = duration_minutes * 60;
      const media_asset_id = String(formData.get('media_asset_id') || '').trim();
      const is_free_preview = formData.get('is_free_preview') === 'true';
      const description = String(formData.get('description') || '').trim();

      try {
        const res = await fetch(`/v1/admin/courses/${courseId}/lessons`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            display_order,
            duration_seconds,
            media_asset_id,
            is_free_preview,
            description,
          }),
        });

        if (res.ok) {
          alert('جلسه جدید با موفقیت اضافه شد.');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('خطا در ثبت جلسه: ' + (err.message || 'خطا در اعتبارسنجی رسانه'));
          addBtn.disabled = false;
          addBtn.innerText = 'ثبت جلسه';
        }
      } catch {
        alert('خطای ارتباط با سرور.');
        addBtn.disabled = false;
        addBtn.innerText = 'ثبت جلسه';
      }
    });

    document.querySelectorAll('.btn-delete-lesson').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const lessonId = target.dataset.id;
        const title = target.dataset.title;
        if (!confirm(`آیا از حذف جلسه "${title}" اطمینان دارید؟`)) return;

        try {
          const res = await fetch(`/v1/admin/courses/${courseId}/lessons/${lessonId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
          });

          if (res.ok) {
            alert('جلسه حذف شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در حذف جلسه: ' + (err.message || 'خطا'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });
  </script>
</AdminLayout>
