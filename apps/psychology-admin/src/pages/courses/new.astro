---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="تعریف دوره جدید" currentNav="courses">
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    <!-- Header with Back Link -->
    <div class="flex justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-base-content">ایجاد پیش‌نویس دوره آموزشی جدید</h2>
        <p class="text-xs text-base-content/70 mt-1">
          اطلاعات عمومی دوره را وارد کنید. پس از ثبت می‌توانید جلسات ویدئویی یا صوتی را بارگذاری کنید.
        </p>
      </div>
      <a href="/courses" class="btn btn-ghost btn-xs text-base-content/60">
        ← بازگشت به لیست دوره‌ها
      </a>
    </div>

    <!-- Course Form Card -->
    <div class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 shadow-xs">
      <form id="create-course-form" class="flex flex-col gap-5">
        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="title">
            عنوان دوره <span class="text-error">*</span>
          </label>
          <input type="text" id="title" name="title" required placeholder="مثال: مدیریت جامع استرس و اضطراب" class="input input-bordered input-sm w-full" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="slug">
              نامک انگلیسی (Slug) <span class="text-error">*</span>
            </label>
            <input type="text" id="slug" name="slug" required placeholder="stress-management" class="input input-bordered input-sm w-full font-mono text-xs" dir="ltr" />
            <span class="text-[11px] text-base-content/60 mt-1 block">در آدرس عمومی دوره در وب‌سایت استفاده می‌شود.</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-base-content/80 mb-1" for="instructor_name">
              نام مدرس دوره <span class="text-error">*</span>
            </label>
            <input type="text" id="instructor_name" name="instructor_name" required placeholder="مثال: دکتر مریم علوی" class="input input-bordered input-sm w-full" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="price_tomans">
            مبلغ دوره (تومان) <span class="text-error">*</span>
          </label>
          <input type="number" id="price_tomans" name="price_tomans" required min="0" step="1000" placeholder="۱,۵۰۰,۰۰۰" class="input input-bordered input-sm w-full" />
          <span class="text-[11px] text-base-content/60 mt-1 block">مبلغ در سیستم با دقت کامل ریالی ذخیره می‌شود. برای دوره‌های رایگان عدد ۰ وارد کنید.</span>
        </div>

        <div>
          <label class="block text-xs font-semibold text-base-content/80 mb-1" for="description">توضیحات و اهداف آموزشی دوره</label>
          <textarea id="description" name="description" rows="4" placeholder="سرفصل‌ها، مخاطبان هدف، دستاوردها و پیش‌نیازهای دوره..." class="textarea textarea-bordered textarea-sm w-full"></textarea>
        </div>

        <div class="flex justify-end gap-3 mt-2 pt-4 border-t border-base-200">
          <a href="/courses" class="btn btn-ghost btn-sm font-medium">انصراف</a>
          <button type="submit" class="btn btn-primary btn-sm font-medium" id="submit-btn">
            ذخیره پیش‌نویس و ادامه به جلسات ➔
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('create-course-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerText = 'در حال ایجاد...';

      const formData = new FormData(form);
      const title = String(formData.get('title') || '').trim();
      const slug = String(formData.get('slug') || '').trim();
      const instructor_name = String(formData.get('instructor_name') || '').trim();
      const description = String(formData.get('description') || '').trim();
      const price_tomans = Number(formData.get('price_tomans') || 0);
      const price_rials = price_tomans * 10;

      try {
        const res = await fetch('/v1/admin/courses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            slug,
            instructor_name,
            description,
            price_rials,
          }),
        });

        if (res.ok) {
          const course = await res.json();
          window.location.href = `/courses/${course.id}/lessons`;
        } else {
          const err = await res.json();
          alert('خطا در ثبت دوره: ' + (err.message || 'خطا در اعتبارسنجی'));
          submitBtn.disabled = false;
          submitBtn.innerText = 'ذخیره پیش‌نویس و ادامه به جلسات ➔';
        }
      } catch {
        alert('خطای ارتباط با سرور.');
        submitBtn.disabled = false;
        submitBtn.innerText = 'ذخیره پیش‌نویس و ادامه به جلسات ➔';
      }
    });
  </script>
</AdminLayout>
