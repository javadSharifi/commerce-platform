---
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { AdminCourseItem, CourseStatus } from '@psychology/api-client';

const statusFilter = Astro.url.searchParams.get('status') as CourseStatus | null;
const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const tenantId = Astro.cookies.get('tenant_id')?.value || '4f3b7b51-7890-4e12-b345-67890abcdef1';
const sessionToken = Astro.cookies.get('session_token')?.value || '';

// Fallback demo courses for dev/preview
const fallbackCourses: AdminCourseItem[] = [
  {
    id: 'c1111111-1111-1111-1111-111111111111',
    title: 'مدیریت جامع اضطراب و نشخوار فکری',
    slug: 'anxiety-management',
    description: 'مهارت‌های شناختی-رفتاری (CBT) برای مهار استرس روزمره و حملات پانیک',
    instructor_name: 'دکتر مریم علوی',
    price_rials: 15000000,
    status: 'published',
    lessons_count: 8,
    published_at: '2026-11-10T10:00:00Z',
    created_at: '2026-11-08T08:00:00Z',
    updated_at: '2026-11-10T10:00:00Z',
  },
  {
    id: 'c2222222-2222-2222-2222-222222222222',
    title: 'مهارت‌های تنظیم هیجان و ذهن‌آگاهی',
    slug: 'emotion-regulation',
    description: 'تمرین‌های کاربردی مبتنی بر درمان مبتنی بر پذیرش و تعهد (ACT)',
    instructor_name: 'دکتر کامران راد',
    price_rials: 22000000,
    status: 'draft',
    lessons_count: 2,
    published_at: null,
    created_at: '2026-11-18T14:30:00Z',
    updated_at: '2026-11-18T14:30:00Z',
  },
  {
    id: 'c3333333-3333-3333-3333-333333333333',
    title: 'ارتباط موثر در روابط زناشویی',
    slug: 'couple-communication',
    description: 'اصول حل تعارض و بازسازی صمیمیت در زندگی مشترک',
    instructor_name: 'دکتر سارا شمس',
    price_rials: 18000000,
    status: 'archived',
    lessons_count: 6,
    published_at: '2026-10-01T09:00:00Z',
    created_at: '2026-09-25T11:00:00Z',
    updated_at: '2026-11-15T12:00:00Z',
  },
];

let courses = fallbackCourses;

try {
  const query = statusFilter ? `?status=${encodeURIComponent(statusFilter)}` : '';
  const res = await fetch(`${apiBase}/admin/courses${query}`, {
    headers: {
      'X-Tenant-ID': tenantId,
      'Authorization': `Bearer ${sessionToken}`,
    },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      courses = data;
    }
  }
} catch {
  // Graceful fallback to preview data
}

if (statusFilter) {
  courses = courses.filter((c) => c.status === statusFilter);
}

function formatTomans(rials: number) {
  const tomans = Math.floor(rials / 10);
  return tomans.toLocaleString('fa-IR') + ' تومان';
}

function formatDatePersian(dateStr?: string | null) {
  if (!dateStr) return '—';
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'Asia/Tehran',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function getStatusBadge(status: string) {
  switch (status) {
    case 'published':
      return { text: 'منتشرشده', badgeClass: 'badge-success' };
    case 'draft':
      return { text: 'پیش‌نویس', badgeClass: 'badge-warning' };
    case 'archived':
      return { text: 'بایگانی‌شده', badgeClass: 'badge-ghost' };
    default:
      return { text: status, badgeClass: 'badge-ghost' };
  }
}

const stats = {
  total: fallbackCourses.length,
  published: fallbackCourses.filter((c) => c.status === 'published').length,
  draft: fallbackCourses.filter((c) => c.status === 'draft').length,
  archived: fallbackCourses.filter((c) => c.status === 'archived').length,
};
---

<AdminLayout title="مدیریت دوره‌های ضبط‌شده" currentNav="courses">
  <div class="flex flex-col gap-6">
    <!-- Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card bg-base-100 border border-base-200 rounded-box p-5 shadow-xs">
        <span class="text-xs text-base-content/70 font-medium">کل دوره‌ها</span>
        <span class="text-2xl font-bold text-base-content mt-1">{stats.total.toLocaleString('fa-IR')}</span>
      </div>
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-success rounded-box p-5 shadow-xs">
        <span class="text-xs text-success font-medium">دوره‌های فعال و منتشرشده</span>
        <span class="text-2xl font-bold text-success mt-1">{stats.published.toLocaleString('fa-IR')}</span>
      </div>
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-warning rounded-box p-5 shadow-xs">
        <span class="text-xs text-warning font-medium">دوره‌های پیش‌نویس</span>
        <span class="text-2xl font-bold text-warning mt-1">{stats.draft.toLocaleString('fa-IR')}</span>
      </div>
      <div class="card bg-base-100 border border-base-200 border-e-4 border-e-base-300 rounded-box p-5 shadow-xs">
        <span class="text-xs text-base-content/60 font-medium">دوره‌های بایگانی‌شده</span>
        <span class="text-2xl font-bold text-base-content/70 mt-1">{stats.archived.toLocaleString('fa-IR')}</span>
      </div>
    </div>

    <!-- Action Bar & Filters -->
    <div class="flex justify-between items-center flex-wrap gap-4">
      <div class="tabs tabs-boxed bg-base-100 p-1 border border-base-200 rounded-lg w-fit">
        <a
          href="/courses"
          class={`tab text-xs sm:text-sm font-medium ${!statusFilter ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          همه
        </a>
        <a
          href="/courses?status=published"
          class={`tab text-xs sm:text-sm font-medium ${statusFilter === 'published' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          منتشرشده
        </a>
        <a
          href="/courses?status=draft"
          class={`tab text-xs sm:text-sm font-medium ${statusFilter === 'draft' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          پیش‌نویس
        </a>
        <a
          href="/courses?status=archived"
          class={`tab text-xs sm:text-sm font-medium ${statusFilter === 'archived' ? 'tab-active !bg-primary !text-primary-content' : 'text-base-content/70'}`}
        >
          بایگانی‌شده
        </a>
      </div>

      <a href="/courses/new" class="btn btn-primary btn-sm rounded-lg font-medium">
        <span>+</span> تعریف دوره جدید
      </a>
    </div>

    <!-- Courses Table -->
    <div class="card bg-base-100 border border-base-200 rounded-box shadow-xs overflow-x-auto">
      <table class="table table-zebra w-full text-start text-xs">
        <thead>
          <tr class="bg-base-200/50 text-base-content/70">
            <th>عنوان دوره و مدرس</th>
            <th>نامک (Slug)</th>
            <th>مبلغ دوره</th>
            <th>جلسات</th>
            <th>وضعیت</th>
            <th>تاریخ انتشار</th>
            <th class="text-end">عملیات</th>
          </tr>
        </thead>
        <tbody>
          {courses.length === 0 ? (
            <tr>
              <td colspan="7" class="py-8 text-center text-base-content/60">
                هیچ دوره‌ای در این دسته‌بندی یافت نشد.
              </td>
            </tr>
          ) : (
            courses.map((course) => {
              const badge = getStatusBadge(course.status);
              return (
                <tr class="hover">
                  <td>
                    <div class="font-bold text-base-content text-sm mb-0.5">{course.title}</div>
                    <div class="text-base-content/60 text-xs">مدرس: {course.instructor_name}</div>
                  </td>
                  <td class="font-mono text-base-content/70" dir="ltr">
                    {course.slug}
                  </td>
                  <td class="font-bold text-primary text-sm">
                    {formatTomans(course.price_rials)}
                  </td>
                  <td>
                    <span class="badge badge-ghost badge-sm font-medium">
                      {(course.lessons_count || 0).toLocaleString('fa-IR')} جلسه
                    </span>
                  </td>
                  <td>
                    <span class={`badge ${badge.badgeClass} badge-sm font-medium`}>
                      {badge.text}
                    </span>
                  </td>
                  <td class="text-base-content/70">
                    {formatDatePersian(course.published_at)}
                  </td>
                  <td class="text-end">
                    <div class="flex gap-1 justify-end items-center flex-wrap">
                      <a href={`/courses/${course.id}/lessons`} class="btn btn-ghost btn-xs text-primary font-medium" title="مدیریت جلسات و ویدئوها">
                        🎬 جلسات
                      </a>
                      <a href={`/courses/${course.id}/edit`} class="btn btn-ghost btn-xs text-base-content/70 font-medium" title="ویرایش دوره">
                        ✏️ ویرایش
                      </a>
                      {course.status === 'draft' && (
                        <button
                          type="button"
                          class="btn btn-success btn-xs font-medium btn-publish"
                          data-id={course.id}
                          title="انتشار عمومی دوره"
                        >
                          🚀 انتشار
                        </button>
                      )}
                      {course.status === 'published' && (
                        <button
                          type="button"
                          class="btn btn-warning btn-xs font-medium btn-archive"
                          data-id={course.id}
                          title="بایگانی دوره (توقف فروش تازه)"
                        >
                          📦 بایگانی
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    document.querySelectorAll('.btn-publish').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!confirm('آیا از انتشار عمومی این دوره اطمینان دارید؟ دوره باید حداقل ۱ جلسه آماده داشته باشد.')) return;
        try {
          const res = await fetch(`/admin/courses/${id}/publish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          if (res.ok) {
            alert('دوره با موفقیت منتشر شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در انتشار دوره: ' + (err.message || 'حداقل ۱ جلسه مورد نیاز است'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });

    document.querySelectorAll('.btn-archive').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (!confirm('آیا از بایگانی این دوره اطمینان دارید؟ فروش جدید متوقف می‌شود ولی خریداران قبلی به جلسات دسترسی خواهند داشت.')) return;
        try {
          const res = await fetch(`/admin/courses/${id}/archive`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          if (res.ok) {
            alert('دوره بایگانی شد.');
            window.location.reload();
          } else {
            const err = await res.json();
            alert('خطا در بایگانی دوره: ' + (err.message || 'خطا'));
          }
        } catch {
          alert('خطای ارتباط با سرور.');
        }
      });
    });
  </script>
</AdminLayout>
