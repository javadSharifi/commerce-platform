---
import '@psychology/ui/styles/base.css';

interface Props {
  title?: string;
  currentNav?: string;
}

const { title = 'پنل مدیریت کلینیک', currentNav = 'dashboard' } = Astro.props;

// Ensure private admin layout responses are strictly not cached
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');
---

<!doctype html>
<html lang="fa" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | سامانه مدیریت روان‌شناسی</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-base-200 text-base-content min-h-screen flex font-sans antialiased">
    <!-- Sidebar -->
    <aside class="w-64 bg-neutral text-neutral-content flex flex-col shrink-0 min-h-screen border-e border-neutral-content/10">
      <div class="p-5 text-base font-bold text-neutral-content border-b border-neutral-content/10">
        مدیریت کلینیک روان‌شناسی
      </div>
      <ul class="flex flex-col gap-1 p-3 list-none">
        <li>
          <a
            href="/"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'dashboard'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>📊</span>
            <span>داشبورد</span>
          </a>
        </li>
        <li>
          <a
            href="/workshops"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'workshops'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>👥</span>
            <span>کارگاه‌ها و ثبت‌نام‌ها</span>
          </a>
        </li>
        <li>
          <a
            href="/courses"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'courses'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>🎓</span>
            <span>دوره‌های ضبط‌شده</span>
          </a>
        </li>
        <li>
          <a
            href="/payments"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'payments'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>💳</span>
            <span>پیگیری بازپرداخت‌ها</span>
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'blog'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>✍️</span>
            <span>مقالات و بلاگ</span>
          </a>
        </li>
        <li>
          <a
            href="/media"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'media'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>📁</span>
            <span>رسانه‌ها و فایل‌ها</span>
          </a>
        </li>
        <li>
          <a
            href="/appointments"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'appointments'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>📅</span>
            <span>نوبت‌دهی و تقویم</span>
          </a>
        </li>
        <li>
          <a
            href="/settings"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${
              currentNav === 'settings'
                ? 'bg-primary text-primary-content font-semibold'
                : 'text-neutral-content/80 hover:bg-neutral-content/10 hover:text-neutral-content'
            }`}
          >
            <span>⚙️</span>
            <span>تنظیمات و ظاهر مطب</span>
          </a>
        </li>
      </ul>
      <div class="mt-auto p-4 border-t border-neutral-content/10 text-xs text-neutral-content/60">
        نسخه سامانه: ۱.۰.۰
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-base-200">
      <header class="bg-base-100 border-b border-base-300 px-6 py-4 flex justify-between items-center">
        <h1 class="text-lg font-bold text-base-content">{title}</h1>
        <div class="flex items-center gap-4">
          <span class="text-sm text-base-content/70">دکتر علوی (مدیر مطب)</span>
          <button class="btn btn-xs btn-outline btn-error">خروج</button>
        </div>
      </header>

      <main class="flex-1 p-6 sm:p-8 min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
