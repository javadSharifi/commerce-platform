---
import '@psychology/ui/styles/base.css';
import '../templates/minimal/theme.css';
import '../templates/clinical/theme.css';
import '../templates/mobile-app/theme.css';
import '../templates/editorial/theme.css';

import {
  DEFAULT_RADIUS,
  DEFAULT_SCALE,
  isValidRadius,
  isValidScale,
  resolvePaletteMeta,
} from '@psychology/ui';
import { resolveTemplate } from '../templates/registry.js';
import type { SiteHeaderVM, FooterVM, SiteShellVM } from '../templates/view-models.js';

interface Props {
  title?: string;
  description?: string;
  paletteId?: string | null;
  templateId?: string | null;
  themeRadius?: string | null;
  themeScale?: string | null;
  hideHeaderFooter?: boolean;
  robots?: string;
}

const {
  title = 'مرکز خدمات روان‌شناختی و مشاوره',
  description = 'سامانه تخصصی مشاوره، کارگاه‌ها و آموزش روان‌شناسی',
  paletteId,
  templateId,
  themeRadius,
  themeScale,
  hideHeaderFooter = false,
  robots,
} = Astro.props;

const activeTemplate = resolveTemplate(templateId);
const safePalette = resolvePaletteMeta(paletteId);
const HeaderComponent = activeTemplate.components.Header;
const FooterComponent = activeTemplate.components.Footer;
const ShellComponent = activeTemplate.components.Shell;

const safeRadius = themeRadius && isValidRadius(themeRadius) ? themeRadius : DEFAULT_RADIUS;
const safeScale = themeScale && isValidScale(themeScale) ? themeScale : DEFAULT_SCALE;

const currentPath = Astro.url?.pathname || '/';
const headerVM: SiteHeaderVM = {
  clinicTitle: title,
  navItems: [
    { label: 'صفحه اصلی', href: '/', isActive: currentPath === '/' },
    { label: 'دوره‌ها', href: '/courses', isActive: currentPath.startsWith('/courses') },
    { label: 'کارگاه‌ها', href: '/workshops', isActive: currentPath.startsWith('/workshops') },
    { label: 'وبلاگ', href: '/blog', isActive: currentPath.startsWith('/blog') },
    { label: 'درخواست نوبت', href: '/booking', isActive: currentPath.startsWith('/booking') },
    { label: 'حساب کاربری', href: '/account/courses', isActive: currentPath.startsWith('/account') },
  ],
  primaryAction: {
    label: 'دریافت نوبت',
    href: '/booking',
  },
};

const footerVM: FooterVM = {
  clinicName: title,
  copyrightYear: new Date().toLocaleDateString('fa-IR', { year: 'numeric' }),
  description,
};

const shellVM: SiteShellVM = {
  clinicTitle: title,
  headerVM,
  footerVM,
  currentPath,
  hideHeaderFooter,
};
---

<!doctype html>
<html
  lang="fa"
  dir="rtl"
  data-theme={activeTemplate.meta.daisyTheme}
  data-palette={safePalette.id}
  data-radius={safeRadius}
  data-scale={safeScale}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content font-sans antialiased">
    {ShellComponent ? (
      <ShellComponent {...shellVM}>
        <slot />
      </ShellComponent>
    ) : (
      <>
        {!hideHeaderFooter && <HeaderComponent {...headerVM} />}
        <main class="flex-1 w-full">
          <slot />
        </main>
        {!hideHeaderFooter && <FooterComponent {...footerVM} />}
      </>
    )}
  </body>
</html>
