---
import type { SiteShellVM } from '../view-models.js';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props extends SiteShellVM {}

const { headerVM, footerVM, currentPath = '/', hideHeaderFooter = false } = Astro.props;

// Determine active destination for the 4 primary destinations + more items
const isHomeActive = currentPath === '/' || currentPath === '';
const isCoursesActive = currentPath.startsWith('/courses');
const isWorkshopsActive = currentPath.startsWith('/workshops');
const isBookingActive = currentPath.startsWith('/booking');
const isBlogActive = currentPath.startsWith('/blog');
const isAccountActive = currentPath.startsWith('/account');
const isMoreActive = isBlogActive || isAccountActive;
---

<div class="template-shell mobile-app-shell flex flex-col min-h-screen pb-20 md:pb-0" style="scroll-padding-bottom: 5rem;">
  {!hideHeaderFooter && <Header {...headerVM} />}
  <main class="flex-1 w-full">
    <slot />
  </main>
  {!hideHeaderFooter && <Footer {...footerVM} />}

  {!hideHeaderFooter && (
    <nav
      class="mobile-bottom-nav fixed bottom-0 inset-x-0 z-40 bg-base-100/95 backdrop-blur-md border-t border-base-200/80 shadow-lg md:hidden pb-[env(safe-area-inset-bottom)]"
      aria-label="ناوبری اصلی اپلیکیشن"
    >
      <div class="grid grid-cols-5 h-16 max-w-lg mx-auto items-center px-1 text-xs">
        <a
          href="/"
          class={`flex flex-col items-center justify-center h-full py-1 gap-1 transition-colors ${
            isHomeActive ? 'text-primary font-bold' : 'text-base-content/70 hover:text-primary'
          }`}
          aria-current={isHomeActive ? 'page' : undefined}
          aria-label="خانه"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill={isHomeActive ? 'currentColor' : 'none'} viewBox="0 0 24 24" stroke="currentColor" stroke-width={isHomeActive ? '1' : '2'}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="text-[11px] leading-tight">خانه</span>
        </a>

        <a
          href="/courses"
          class={`flex flex-col items-center justify-center h-full py-1 gap-1 transition-colors ${
            isCoursesActive ? 'text-primary font-bold' : 'text-base-content/70 hover:text-primary'
          }`}
          aria-current={isCoursesActive ? 'page' : undefined}
          aria-label="دوره‌ها"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill={isCoursesActive ? 'currentColor' : 'none'} viewBox="0 0 24 24" stroke="currentColor" stroke-width={isCoursesActive ? '1' : '2'}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="text-[11px] leading-tight">دوره‌ها</span>
        </a>

        <a
          href="/workshops"
          class={`flex flex-col items-center justify-center h-full py-1 gap-1 transition-colors ${
            isWorkshopsActive ? 'text-primary font-bold' : 'text-base-content/70 hover:text-primary'
          }`}
          aria-current={isWorkshopsActive ? 'page' : undefined}
          aria-label="کارگاه‌ها"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill={isWorkshopsActive ? 'currentColor' : 'none'} viewBox="0 0 24 24" stroke="currentColor" stroke-width={isWorkshopsActive ? '1' : '2'}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span class="text-[11px] leading-tight">کارگاه‌ها</span>
        </a>

        <a
          href="/booking"
          class={`flex flex-col items-center justify-center h-full py-1 gap-1 transition-colors ${
            isBookingActive ? 'text-primary font-bold' : 'text-base-content/70 hover:text-primary'
          }`}
          aria-current={isBookingActive ? 'page' : undefined}
          aria-label="درخواست نوبت"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill={isBookingActive ? 'currentColor' : 'none'} viewBox="0 0 24 24" stroke="currentColor" stroke-width={isBookingActive ? '1' : '2'}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-[11px] leading-tight">نوبت</span>
        </a>

        <div class="dropdown dropdown-top dropdown-end flex justify-center h-full">
          <details class="w-full h-full flex flex-col justify-center">
            <summary
              class={`flex flex-col items-center justify-center h-full py-1 gap-1 cursor-pointer list-none transition-colors ${
                isMoreActive ? 'text-primary font-bold' : 'text-base-content/70 hover:text-primary'
              }`}
              aria-label="منوی بیشتر"
              aria-haspopup="menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <span class="text-[11px] leading-tight">بیشتر</span>
            </summary>
            <ul
              class="dropdown-content menu p-2 shadow-2xl bg-base-100 border border-base-300 rounded-2xl w-48 mb-3 z-50 text-right space-y-1"
              role="menu"
            >
              <li role="none">
                <a
                  href="/blog"
                  role="menuitem"
                  class={`py-2.5 px-3 text-xs rounded-xl flex items-center justify-between ${
                    isBlogActive ? 'active font-bold text-primary bg-primary/10' : 'text-base-content hover:bg-base-200'
                  }`}
                  aria-current={isBlogActive ? 'page' : undefined}
                >
                  <span>وبلاگ و مقالات</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </a>
              </li>
              <li role="none">
                <a
                  href="/account/courses"
                  role="menuitem"
                  class={`py-2.5 px-3 text-xs rounded-xl flex items-center justify-between ${
                    isAccountActive ? 'active font-bold text-primary bg-primary/10' : 'text-base-content hover:bg-base-200'
                  }`}
                  aria-current={isAccountActive ? 'page' : undefined}
                >
                  <span>حساب کاربری</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </a>
              </li>
            </ul>
          </details>
        </div>
      </div>
    </nav>
  )}
</div>
