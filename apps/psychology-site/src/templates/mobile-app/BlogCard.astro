---
import type { BlogCardVM } from '../view-models.js';

interface Props extends BlogCardVM {}

const { slug, title, excerpt, dateLabel, coverUrl } = Astro.props;
---

<article class="card bg-base-100 border border-base-200 hover:border-primary/50 transition-all duration-200 overflow-hidden shadow-xs hover:shadow-md rounded-2xl flex flex-col h-full">
  {coverUrl && (
    <figure class="aspect-video w-full bg-base-200 overflow-hidden">
      <img src={coverUrl} alt={title} class="w-full h-full object-cover" loading="lazy" />
    </figure>
  )}

  <div class="card-body p-5 flex flex-col flex-1 justify-between">
    <div>
      <div class="text-xs text-base-content/60 mb-2">
        {dateLabel}
      </div>

      <h3 class="card-title text-base sm:text-lg font-bold text-base-content mb-2 line-clamp-2">
        <a href={`/blog/${slug}`} class="hover:text-primary transition-colors">
          {title}
        </a>
      </h3>

      <p class="text-sm text-base-content/70 line-clamp-3 leading-relaxed mb-4">
        {excerpt}
      </p>
    </div>

    <div class="pt-2">
      <a href={`/blog/${slug}`} class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1">
        ادامه مطلب &larr;
      </a>
    </div>
  </div>
</article>
