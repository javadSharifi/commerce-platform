---
import type { FooterVM } from '../view-models.js';

interface Props extends FooterVM {}

const { clinicName, copyrightYear, description, phone, address } = Astro.props;
const hasContact = Boolean(phone || address);
---

<footer class="editorial-footer mt-12 w-full border-t border-base-300">
  <div class="editorial-container py-12">
    <div class:list={['grid gap-12', hasContact ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
      <div class="space-y-4">
        <p class="editorial-brand text-base-content">{clinicName}</p>
        {description && (
          <p class="max-w-xs text-pretty">
            {description}
          </p>
        )}
      </div>

      <nav class="space-y-4" aria-labelledby="editorial-footer-nav">
        <h2 id="editorial-footer-nav">دسترسی سریع</h2>
        <ul class="space-y-2">
          <li><a href="/">صفحه اصلی</a></li>
          <li><a href="/courses">دوره‌ها</a></li>
          <li><a href="/workshops">کارگاه‌ها</a></li>
          <li><a href="/blog">وبلاگ</a></li>
          <li><a href="/booking">درخواست نوبت</a></li>
        </ul>
      </nav>

      {hasContact && (
        <div class="space-y-4">
          <h2>تماس با مطب</h2>
          <address class="space-y-2 not-italic">
            {address && <p>{address}</p>}
            {phone && <p><bdi dir="ltr">{phone}</bdi></p>}
          </address>
        </div>
      )}
    </div>

    <p class="mt-8 border-t border-base-300 pt-6 text-xs leading-[1.125rem]">
      © {copyrightYear} {clinicName}. تمامی حقوق محفوظ است.
    </p>
  </div>
</footer>
