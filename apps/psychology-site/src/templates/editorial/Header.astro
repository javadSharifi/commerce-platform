---
import type { SiteHeaderVM } from '../view-models.js';

interface Props extends SiteHeaderVM {}

const { clinicTitle, navItems, primaryAction } = Astro.props;
const links = navItems.filter(item => item.href !== primaryAction?.href);
const actionIsCurrent = navItems.some(item => item.href === primaryAction?.href && item.isActive);
---

<header class="sticky top-0 z-40 w-full border-b border-base-300 bg-base-100/90 backdrop-blur-md">
  <div class="editorial-container flex min-h-20 items-center justify-between gap-4">
    <a href="/" class="editorial-brand min-w-0 max-w-72 rounded-sm text-base-content">
      {clinicTitle}
    </a>

    <nav class="hidden shrink-0 items-center gap-4 md:flex lg:gap-8" aria-label="ناوبری اصلی">
      {links.map(item => (
        <a href={item.href} class="editorial-nav-link" aria-current={item.isActive ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      {primaryAction && (
        <a
          href={primaryAction.href}
          class="editorial-primary-action btn btn-primary rounded-full shadow-none"
          aria-current={actionIsCurrent ? 'page' : undefined}
        >
          {primaryAction.label}
        </a>
      )}
      <div class="md:hidden">
        <details class="dropdown dropdown-end">
          <summary
            class="editorial-menu-toggle btn btn-square rounded-full"
            aria-label="منوی ناوبری"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <ul class="editorial-menu dropdown-content menu w-56 rounded-box border border-base-300 p-3 shadow-sm">
            {links.map(item => (
              <li>
                <a
                  href={item.href}
                  class:list={['py-2 text-sm', { 'active font-semibold text-primary': item.isActive }]}
                  aria-current={item.isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </div>
</header>
