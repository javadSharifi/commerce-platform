---
import type { BlogCardVM } from '../view-models.js';

interface Props extends BlogCardVM {}

const { slug, title, excerpt, dateLabel, coverUrl } = Astro.props;
---

<article class="card bg-base-100 border border-base-300 hover:border-primary/50 transition-all duration-200 overflow-hidden shadow-sm hover:shadow-md rounded-2xl flex flex-col h-full">
  {coverUrl ? (
    <figure class="aspect-video w-full bg-base-200 overflow-hidden">
      <img src={coverUrl} alt={title} class="w-full h-full object-cover" loading="lazy" />
    </figure>
  ) : (
    <div class="aspect-video w-full bg-base-200/80 flex items-center justify-center text-base-content/40 text-sm">
      بدون تصویر
    </div>
  )}

  <div class="card-body p-6 flex flex-col flex-1 justify-between">
    <div>
      <div class="text-xs text-base-content/65 mb-2">
        {dateLabel}
      </div>

      <h3 class="card-title text-base sm:text-lg font-bold text-base-content mb-2 line-clamp-2">
        <a href={`/blog/${slug}`} class="hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm">
          {title}
        </a>
      </h3>

      {excerpt && (
        <p class="text-xs sm:text-sm text-base-content/75 line-clamp-3 leading-relaxed mb-4">
          {excerpt}
        </p>
      )}
    </div>

    <div class="pt-4 border-t border-base-200 flex items-center justify-between mt-auto">
      <a
        href={`/blog/${slug}`}
        class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
      >
        <span>مطالعه مقاله</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
