---
import type { HomeHeroVM } from '../view-models.js';

interface Props extends HomeHeroVM {}

const { badgeText, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Right Column (RTL Start): Content -->
    <div class="lg:col-span-7 flex flex-col items-start gap-5">
      {badgeText && (
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-semibold">
          <span class="inline-block w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span>{badgeText}</span>
        </span>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-base-content tracking-tight leading-tight text-balance">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-base-content/75 max-w-2xl leading-relaxed text-pretty">
        {description}
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href={primaryCta.href}
          class="btn btn-primary btn-md sm:btn-lg rounded-full px-8 shadow-none font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <span>{primaryCta.label}</span>
        </a>

        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="btn btn-outline btn-md sm:btn-lg rounded-full px-8 font-medium border-base-300 hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>

      <!-- Subtle Trust Indicators Row -->
      <div class="pt-5 mt-2 border-t border-base-200 w-full flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-base-content/65">
        <div class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path>
          </svg>
          <span>عضو سازمان نظام روان‌شناسی</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <path d="M15 10l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14v-4z"></path><rect width="12" height="12" x="3" y="6" rx="2"></rect>
          </svg>
          <span>مشاوره آنلاین و حضوری</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>رویکرد علمی و مبتنی بر شواهد</span>
        </div>
      </div>
    </div>

    <!-- Left Column: Visual Portrait Arch Frame & Floating Badge -->
    <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
      <div class="relative w-full max-w-sm">
        <div class="bg-base-200/90 p-2 sm:p-3 rounded-t-full rounded-b-2xl border border-base-300 shadow-sm overflow-hidden aspect-[3/4] flex items-center justify-center">
          <div class="w-full h-full bg-base-100 rounded-t-full rounded-b-xl border border-base-300 flex flex-col items-center justify-center text-base-content/40 text-center p-6 gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-primary/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="text-xs font-medium text-base-content/60">فضای امن و اختصاصی مشاوره</span>
          </div>
        </div>

        <!-- Floating Glass Badge -->
        <div class="absolute -bottom-3 right-4 left-4 sm:right-6 sm:left-auto bg-base-100/95 backdrop-blur-md border border-base-300 rounded-xl px-4 py-2.5 shadow-md flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-3 h-3 rounded-full bg-primary" aria-hidden="true"></span>
          <div class="flex flex-col text-xs">
            <span class="font-bold text-base-content">پذیرش مراجعین</span>
            <span class="text-base-content/65">آنلاین و حضوری با تعیین وقت قبلی</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
