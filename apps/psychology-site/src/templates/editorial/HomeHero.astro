---
import type { HomeHeroVM } from '../view-models.js';

interface Props extends HomeHeroVM {}

const { badgeText, title, description, portraitUrl, portraitAlt, primaryCta, secondaryCta } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:pt-16 md:pb-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Right Column (RTL Start): Content -->
    <div class="lg:col-span-7 flex flex-col items-start gap-5">
      {badgeText && (
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-semibold">
          <span class="inline-block w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span>{badgeText}</span>
        </span>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-base-content tracking-tight leading-tight text-balance">
        {title}
      </h1>

      {description && (
        <p class="text-base sm:text-lg text-base-content/75 max-w-2xl leading-loose text-pretty">{description}</p>
      )}

      <!-- Dual CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href={primaryCta.href}
          class="btn btn-primary btn-md sm:btn-lg rounded-full px-8 shadow-none font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <span>{primaryCta.label}</span>
        </a>

        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="btn btn-outline btn-md sm:btn-lg rounded-full px-8 font-medium border-base-300 hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>

    </div>

    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div class="w-full max-w-md aspect-[3/4] rounded-t-full rounded-b-3xl border border-base-300 bg-base-200 p-2">
        {portraitUrl ? (
          <img src={portraitUrl} alt={portraitAlt ?? ''} class="w-full h-full rounded-t-full rounded-b-2xl object-cover" />
        ) : (
          <div data-portrait-placeholder class="w-full h-full rounded-t-full rounded-b-2xl bg-base-100" aria-hidden="true"></div>
        )}
      </div>
    </div>
  </div>
</section>
