---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveTemplate } from '../templates/registry.js';
import type { HomeHeroVM } from '../templates/view-models.js';
import { fetchPublicSite } from '../lib/site.js';
import { isValidHexColor, isValidRadius, isValidScale, Button } from '@psychology/ui';

// Preview responses must never be stored in shared CDN or browser cache
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Tenant is strictly determined from the incoming Host (Hard Rule 1)
const site = await fetchPublicSite(Astro.request);

// Read and validate preview query parameters
const qTemplate = Astro.url.searchParams.get('template');
const activeTemplate = resolveTemplate(qTemplate || site.template_id);
const previewTemplateId = activeTemplate.meta.id;

const qPrimary = Astro.url.searchParams.get('primary');
const previewPrimary = qPrimary && isValidHexColor(qPrimary) ? qPrimary : site.primary_color;

const qRadius = Astro.url.searchParams.get('radius');
const previewRadius = qRadius && isValidRadius(qRadius) ? qRadius : site.theme_radius;

const qScale = Astro.url.searchParams.get('scale');
const previewScale = qScale && isValidScale(qScale) ? qScale : site.theme_scale;

const HomeHeroComponent = activeTemplate.components.HomeHero;

const heroVM: HomeHeroVM = {
  badgeText: site.name,
  title: site.title,
  description: site.description,
  primaryCta: {
    label: 'رزرو نوبت مشاوره',
    href: '/booking',
  },
  secondaryCta: {
    label: 'مشاهده کارگاه‌ها',
    href: '/workshops',
  },
};
---

<BaseLayout
  title={`پیش‌نمایش: ${site.title}`}
  description={site.description}
  primaryColor={previewPrimary}
  templateId={previewTemplateId}
  themeRadius={previewRadius}
  themeScale={previewScale}
  robots="noindex, nofollow"
>
  <div class="bg-warning text-warning-content text-xs font-semibold py-2 px-4 text-center shadow-xs">
    حالت پیش‌نمایش ظاهر (تغییرات هنوز منتشر نشده است)
  </div>

  <HomeHeroComponent {...heroVM} />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-base-100 rounded-2xl p-6 border border-base-200 shadow-xs">
        <h3 class="text-base font-bold text-base-content mb-3">اطلاعات تماس و دسترسی</h3>
        {site.phone && (
          <p class="text-sm text-base-content/80 mb-2">
            تلفن تماس: <span class="font-medium text-base-content">{site.phone}</span>
          </p>
        )}
        {site.address && (
          <p class="text-sm text-base-content/80">
            نشانی مطب: <span class="font-medium text-base-content">{site.address}</span>
          </p>
        )}
      </div>
      <div class="bg-base-100 rounded-2xl p-6 border border-base-200 shadow-xs">
        <h3 class="text-base font-bold text-base-content mb-3">ساعات کاری و پذیرش</h3>
        <p class="text-sm text-base-content/80 mb-2">شنبه تا چهارشنبه: ۱۴:۰۰ الی ۲۰:۰۰</p>
        <p class="text-xs text-base-content/60">پاسخگویی تلفنی و هماهنگی نوبت‌ها با تعیین وقت قبلی</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-base-200 rounded-3xl p-8 border border-base-300 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-start">
        <h4 class="text-lg font-bold text-base-content mb-1">نیاز به مشاوره فردی یا خانوادگی دارید؟</h4>
        <p class="text-sm text-base-content/70">درمانگران متخصص ما آماده ارائه خدمات حضوری و آنلاین هستند.</p>
      </div>
      <a href="/booking">
        <Button variant="primary">رزرو نوبت مشاوره</Button>
      </a>
    </div>
  </section>
</BaseLayout>
