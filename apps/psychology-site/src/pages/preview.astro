---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePageContent from '../components/HomePageContent.astro';
import { resolveTemplate } from '../templates/registry.js';
import { fetchPublicSite } from '../lib/site.js';
import {
  DEFAULT_PALETTE_ID,
  isValidPaletteId,
  isValidRadius,
  isValidScale,
} from '@psychology/ui';

// Preview responses must never be stored in shared CDN or browser cache
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Tenant is strictly determined from the incoming Host (Hard Rule 1)
const site = Astro.locals.site || (await fetchPublicSite(Astro.request));

// Read and validate preview query parameters: template, palette, radius, scale (PSY-6.6.1 / PSY-D10)
// 1. Template: absent or empty uses published value; non-empty invalid safely falls back to minimal
const qTemplate = Astro.url.searchParams.get('template');
const templateInput = qTemplate !== null && qTemplate !== '' ? qTemplate : site.template_id;
const activeTemplate = resolveTemplate(templateInput);
const previewTemplateId = activeTemplate.meta.id;

// 2. Palette: absent or empty uses published value; non-empty invalid safely falls back to calm-sage
const qPalette = Astro.url.searchParams.get('palette');
let previewPaletteId: string;
if (qPalette === null || qPalette === '') {
  previewPaletteId = isValidPaletteId(site.palette_id) ? site.palette_id : DEFAULT_PALETTE_ID;
} else if (isValidPaletteId(qPalette)) {
  previewPaletteId = qPalette;
} else {
  previewPaletteId = DEFAULT_PALETTE_ID;
}

// 3. Radius: absent or empty uses published value; non-empty invalid first falls back to published, then md
const qRadius = Astro.url.searchParams.get('radius');
const publishedRadius = isValidRadius(site.theme_radius) ? site.theme_radius : 'md';
let previewRadius: string;
if (qRadius === null || qRadius === '') {
  previewRadius = publishedRadius;
} else if (isValidRadius(qRadius)) {
  previewRadius = qRadius;
} else {
  previewRadius = publishedRadius;
}

// 4. Scale: absent or empty uses published value; non-empty invalid first falls back to published, then md
const qScale = Astro.url.searchParams.get('scale');
const publishedScale = isValidScale(site.theme_scale) ? site.theme_scale : 'md';
let previewScale: string;
if (qScale === null || qScale === '') {
  previewScale = publishedScale;
} else if (isValidScale(qScale)) {
  previewScale = qScale;
} else {
  previewScale = publishedScale;
}
---

<BaseLayout
  title={`پیش‌نمایش: ${site.title}`}
  description={site.description}
  paletteId={previewPaletteId}
  templateId={previewTemplateId}
  themeRadius={previewRadius}
  themeScale={previewScale}
  robots="noindex, nofollow"
>
  <div class="bg-warning text-warning-content text-xs font-semibold py-2 px-4 text-center shadow-xs">
    حالت پیش‌نمایش ظاهر (تغییرات هنوز منتشر نشده است)
  </div>

  <HomePageContent site={site} templateId={previewTemplateId} />
</BaseLayout>
