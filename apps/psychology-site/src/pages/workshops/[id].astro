---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicSiteClient } from '../../lib/site.js';
import { publicEducationCache, readEducation } from '../../lib/education.js';
import { formatPrice } from '../../lib/home.js';

const { id } = Astro.params;
const site = Astro.locals.site!;
const api = publicSiteClient(Astro.request);
const result = await readEducation('workshop detail', api && id ? () => api.getPublicWorkshop(encodeURIComponent(id)) : undefined);
const workshop = result.data;
if (!workshop) {
  const unavailable = result.status === 503;
  return new Response(unavailable ? 'نمایش کارگاه موقتاً در دسترس نیست.' : 'کارگاه مورد نظر یافت نشد.', {
    status: unavailable ? 503 : 404, headers: { 'Cache-Control': 'private, no-store', 'Content-Type': 'text/plain; charset=utf-8' },
  });
}
Astro.response.headers.set('Cache-Control', publicEducationCache);

const remainingCapacity = workshop.remaining_capacity;
const isFull = remainingCapacity <= 0;
const isFree = workshop.price_rials === 0;
const registrationOpen = workshop.is_registration_open && !isFull;

function formatDateTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      dateStyle: 'full',
      timeStyle: 'short',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

---

<BaseLayout
  title={`${workshop.title} | ${site.title}`}
  description={workshop.description}
  paletteId={site.palette_id}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="مسیر راهنما" class="mb-6 text-sm text-base-content/70">
      <a href="/workshops" class="hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm">
        کارگاه‌ها
      </a>
      <span class="mx-2 text-base-content/40">/</span>
      <span class="text-base-content font-medium">{workshop.title}</span>
    </nav>

    <article class="card bg-base-100 border border-base-200 rounded-2xl p-6 sm:p-10 shadow-xs mb-8">
      <!-- Header Block -->
      <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-6 pb-6 border-b border-base-200">
        <div>
          <span class={`badge badge-sm font-semibold mb-3 ${
            workshop.is_registration_open && !isFull
              ? 'badge-success'
              : 'badge-error'
          }`}>
            {workshop.is_registration_open && !isFull ? 'ثبت‌نام فعال' : isFull ? 'ظرفیت تکمیل است' : 'پایان مهلت ثبت‌نام'}
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content leading-tight">
            {workshop.title}
          </h1>
        </div>
        <div class="sm:text-end shrink-0">
          <div class="text-xs text-base-content/60 mb-0.5">شهریه کارگاه:</div>
          <div class="text-2xl sm:text-3xl font-black text-primary tracking-tight">
            {formatPrice(workshop.price_rials)}
          </div>
          {workshop.price_rials > 0 && (
            <div class="text-xs text-base-content/50 mt-0.5">
              {workshop.price_rials.toLocaleString('fa-IR')} ریال
            </div>
          )}
        </div>
      </div>

      <!-- Key Details Strip -->
      <div class="bg-base-200/50 border border-base-200 rounded-xl p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 text-sm">
        <div>
          <span class="text-base-content/60 block text-xs mb-0.5">مدرس کارگاه:</span>
          <strong class="text-base-content">{workshop.instructor_name || site.title}</strong>
        </div>
        <div>
          <span class="text-base-content/60 block text-xs mb-0.5">زمان برگزاری:</span>
          <strong class="text-base-content">{formatDateTehran(workshop.starts_at)}</strong>
        </div>
        <div>
          <span class="text-base-content/60 block text-xs mb-0.5">محل برگزاری:</span>
          <strong class="text-base-content">{workshop.location}</strong>
        </div>
        <div>
          <span class="text-base-content/60 block text-xs mb-0.5">ظرفیت باقیمانده:</span>
          <strong class={isFull ? 'text-error font-bold' : 'text-base-content'}>
            {isFull ? 'تکمیل شده (۰ صندلی)' : `${remainingCapacity.toLocaleString('fa-IR')} صندلی خالی`}
          </strong>
        </div>
      </div>

      <!-- Workshop Syllabus & Description -->
      <div class="text-base-content/85 text-sm sm:text-base leading-relaxed mb-8">
        <h2 class="text-lg font-bold text-base-content mb-3 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary" aria-hidden="true"></span>
          درباره این دوره و سرفصل‌ها
        </h2>
        <p class="whitespace-pre-line leading-relaxed bg-base-200/25 p-5 rounded-xl border border-base-200/70">
          {workshop.description}
        </p>
      </div>

      <!-- Registration Box -->
      <div id="registration-section" class="border-t border-base-200 pt-6">
        <h2 class="text-lg font-bold text-base-content mb-1">
          {registrationOpen ? 'فرم ثبت‌نام آنلاین در کارگاه' : 'وضعیت ثبت‌نام'}
        </h2>
        {registrationOpen && <p class="text-xs text-base-content/70 mb-5">
          {isFree
            ? 'این کارگاه به صورت رایگان برگزار می‌شود و پس از تکمیل فرم، صندلی شما فوراً قطعی می‌گردد.'
            : 'پس از ثبت فرم، صندلی شما به مدت ۱۵ دقیقه رزرو موقت شده و جهت پرداخت به درگاه امن بانکی هدایت می‌شوید.'}
        </p>}

        {isFull ? (
          <div class="flex flex-col gap-3 max-w-md">
            <div class="alert alert-error text-xs font-semibold leading-relaxed">
              ظرفیت این کارگاه تکمیل شده است.
            </div>
            <button disabled class="btn btn-disabled w-full text-sm font-bold rounded-full">
              تکمیل ظرفیت
            </button>
            <a href="/workshops" class="btn btn-outline btn-sm rounded-full text-xs text-center mt-1">
              مشاهده سایر کارگاه‌های دارای ظرفیت
            </a>
          </div>
        ) : !workshop.is_registration_open ? (
          <div class="flex flex-col gap-3 max-w-md">
            <div class="alert alert-error text-xs font-semibold leading-relaxed">
              مهلت ثبت‌نام در این کارگاه به پایان رسیده است.
            </div>
            <button disabled class="btn btn-disabled w-full text-sm font-bold rounded-full">
              پایان مهلت ثبت‌نام
            </button>
            <a href="/workshops" class="btn btn-outline btn-sm rounded-full text-xs text-center mt-1">
              مشاهده سایر کارگاه‌های دارای ظرفیت
            </a>
          </div>
        ) : (
          <form id="register-form" class="flex flex-col gap-4 max-w-md">
            <div id="form-error" class="alert alert-error text-xs hidden"></div>

            <div>
              <label for="guest_name" class="label-text text-xs font-semibold text-base-content block mb-1">
                نام و نام خانوادگی <span class="text-error">*</span>
              </label>
              <input
                id="guest_name"
                name="guest_name"
                type="text"
                required
                placeholder="مثال: سارا محمدی"
                class="input input-bordered w-full text-base-content bg-base-100 text-sm rounded-xl"
              />
            </div>

            <div>
              <label for="guest_phone" class="label-text text-xs font-semibold text-base-content block mb-1">
                شماره تلفن همراه <span class="text-error">*</span>
              </label>
              <input
                id="guest_phone"
                name="guest_phone"
                type="tel"
                dir="ltr"
                required
                placeholder="09123456789"
                class="input input-bordered w-full text-base-content bg-base-100 text-sm text-end rounded-xl"
              />
              <span class="block text-[11px] text-base-content/60 mt-1">
                پیامک تأیید و پیگیری ثبت‌نام به این شماره ارسال خواهد شد.
              </span>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="btn btn-primary w-full text-sm font-bold mt-2 rounded-full"
            >
              {isFree ? 'ثبت و تایید نهایی ثبت‌نام رایگان' : `رزرو صندلی و پرداخت (${formatPrice(workshop.price_rials)})`}
            </button>
          </form>
        )}
      </div>
    </article>
  </div>

  <script define:vars={{ workshopId: workshop.id, isFree }}>
    const form = document.getElementById('register-form');
    const errorBox = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBox.classList.add('hidden');
        errorBox.textContent = '';

        const nameInput = document.getElementById('guest_name');
        const phoneInput = document.getElementById('guest_phone');

        const guestName = nameInput.value.trim();
        let guestPhone = phoneInput.value.trim();

        // Convert Persian/Arabic digits to English
        const p2e = s => s.replace(/[۰-۹]/g, d => '0123456789'['۰۱۲۳۴۵۶۷۸۹'.indexOf(d)])
                          .replace(/[٠-٩]/g, d => '0123456789'['٠١٢٣٤٥٦٧٨٩'.indexOf(d)]);
        guestPhone = p2e(guestPhone).replace(/[\s-]/g, '');

        if (!guestName) {
          showError('لطفاً نام و نام خانوادگی خود را وارد نمایید.');
          return;
        }

        if (!/^09\d{9}$/.test(guestPhone)) {
          showError('فرمت شماره تلفن همراه نامعتبر است. مثال: 09123456789');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'در حال ثبت اطلاعات...';

        try {
          const res = await fetch(`/v1/public/workshops/${encodeURIComponent(workshopId)}/register`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              guest_name: guestName,
              guest_phone: guestPhone,
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            let msg = data.message || 'خطا در ثبت‌نام. لطفاً دوباره تلاش کنید.';
            if (data.code === 'CAPACITY_FULL') {
              msg = 'متأسفانه ظرفیت کارگاه تکمیل شده است.';
            } else if (data.code === 'DUPLICATE_REGISTRATION') {
              msg = 'یک ثبت‌نام فعال با این شماره موبایل قبلاً ثبت شده است.';
            } else if (data.code === 'DEADLINE_PASSED') {
              msg = 'مهلت ثبت‌نام در این کارگاه به پایان رسیده است.';
            }
            showError(msg);
            submitBtn.disabled = false;
            submitBtn.textContent = isFree ? 'ثبت و تایید نهایی ثبت‌نام رایگان' : 'رزرو صندلی و پرداخت';
            return;
          }

          // Registration succeeded!
          if (data.lookup_token) {
            try {
              localStorage.setItem(`reg_${data.registration_id}`, data.lookup_token);
            } catch {
              // Ignore localStorage quota errors
            }
          }

          if (isFree || data.status === 'confirmed') {
            window.location.href = `/workshops/registrations/${data.registration_id}?lookup_token=${data.lookup_token}`;
          } else if (data.payment_url) {
            window.location.href = data.payment_url;
          } else {
            window.location.href = `/workshops/registrations/${data.registration_id}?lookup_token=${data.lookup_token}`;
          }
        } catch (err) {
          showError('خطا در برقراری ارتباط با سرور.');
          submitBtn.disabled = false;
          submitBtn.textContent = isFree ? 'ثبت و تایید نهایی ثبت‌نام رایگان' : 'رزرو صندلی و پرداخت';
        }
      });
    }

    function showError(msg) {
      if (errorBox) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }
    }
  </script>
</BaseLayout>
