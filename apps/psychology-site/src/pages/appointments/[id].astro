---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicSiteClient } from '../../lib/site.js';
import { ApiClientError, type PublicAppointmentResponse } from '@psychology/api-client';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const site = Astro.locals.site!;
const id = Astro.params.id ?? '';
const legacyHash = Astro.url.searchParams.get('hash') || Astro.url.searchParams.get('lookup_hash');
const hash = Astro.cookies.get('appointment_lookup')?.value || legacyHash;
const api = publicSiteClient(Astro.request);
let appointment: PublicAppointmentResponse | undefined;
let unavailable = false;

if (hash && api) {
  try {
    const data = await api.getPublicAppointmentStatus(encodeURIComponent(id), hash);
    if (data.id !== id || !Number.isFinite(Date.parse(data.starts_at)) ||
        !Number.isFinite(Date.parse(data.ends_at))) throw new Error('Unexpected appointment response');
    appointment = data;
  } catch (err) {
    unavailable = !(err instanceof ApiClientError && [400, 403, 404].includes(err.status));
    if (unavailable) console.error('Appointment tracking unavailable', err instanceof Error ? err.name : 'UnknownError');
  }
} else {
  unavailable = Boolean(hash);
}

if (!appointment) Astro.response.status = unavailable ? 503 : 404;
if (appointment && legacyHash && hash) {
  Astro.cookies.set('appointment_lookup', hash, {
    path: `/appointments/${encodeURIComponent(id)}`, httpOnly: true, sameSite: 'lax',
    secure: Astro.url.protocol === 'https:',
  });
}

const status = {
  pending: 'در انتظار تأیید و تماس پذیرش',
  confirmed: 'تأییدشده و قطعی',
  cancelled: 'لغو شده',
  expired: 'منقضی‌شده',
  completed: 'جلسه برگزار شد',
} as const;
const dateTime = new Intl.DateTimeFormat('fa-IR-u-ca-persian', {
  dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Tehran',
});
const canCancel = appointment && ['pending', 'confirmed'].includes(appointment.status) &&
  Date.parse(appointment.starts_at) > Date.now();
---

<BaseLayout title={`پیگیری خصوصی نوبت | ${site.title}`} paletteId={site.palette_id} templateId={site.template_id}
  themeRadius={site.theme_radius} themeScale={site.theme_scale} robots="noindex, nofollow">
  <div class="mx-auto max-w-xl px-4 py-10">
    <article class="card bg-base-100 rounded-2xl border border-base-200 p-6 sm:p-8">
      <h1 class="mb-4 text-2xl font-extrabold">وضعیت نوبت مشاوره</h1>
      {appointment ? (
        <div class="space-y-5">
          <p class="badge badge-primary badge-outline">{status[appointment.status] ?? 'وضعیت نامشخص'}</p>
          <dl class="rounded-xl bg-base-200/55 p-4 text-sm">
            <dt>نام مراجع</dt><dd class="mb-3 font-semibold">{appointment.guest_name}</dd>
            <dt>شروع جلسه به وقت تهران</dt><dd class="font-semibold">{dateTime.format(new Date(appointment.starts_at))}</dd>
          </dl>
          {canCancel && <button id="cancel-appt-btn" type="button" class="btn btn-outline btn-error">لغو نوبت مشاوره</button>}
        </div>
      ) : (
        <p role="status" class="alert alert-warning">
          {unavailable ? 'دریافت وضعیت نوبت موقتاً ممکن نیست. دوباره تلاش کنید.' :
            'دسترسی به اطلاعات نوبت محدود است. پیگیری از مرورگر ثبت درخواست امکان‌پذیر است.'}
        </p>
      )}
      <a href="/booking" class="btn btn-ghost mt-4">بازگشت به صفحه نوبت‌دهی</a>
    </article>

    {canCancel && (
      <dialog id="cancel-confirm-modal" class="modal" aria-labelledby="cancel-heading">
        <div class="modal-box space-y-4">
          <h2 id="cancel-heading" class="text-lg font-bold">لغو نوبت مشاوره</h2>
          <p>با تأیید، این نوبت لغو می‌شود.</p>
          <p id="cancel-modal-error" class="text-error" role="alert"></p>
          <div class="flex gap-2">
            <button type="button" id="confirm-cancel-btn" class="btn btn-error">تأیید لغو</button>
            <form method="dialog"><button type="submit" class="btn btn-ghost" autofocus>انصراف</button></form>
          </div>
        </div>
      </dialog>
    )}
  </div>
</BaseLayout>

{appointment && legacyHash && <script is:inline>history.replaceState(null, '', location.pathname);</script>}
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#cancel-confirm-modal');
  const open = document.getElementById('cancel-appt-btn');
  const confirm = document.querySelector<HTMLButtonElement>('#confirm-cancel-btn');
  const error = document.getElementById('cancel-modal-error');
  if (dialog && open && confirm && error) {
    open.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('close', () => open.focus());
    confirm.addEventListener('click', async () => {
      confirm.disabled = true;
      error.textContent = '';
      try {
        const res = await fetch(location.pathname + '/cancel', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
        });
        if (res.ok) location.reload();
        else error.textContent = (await res.json()).message || 'لغو نوبت ممکن نیست.';
      } catch {
        error.textContent = 'ارتباط با سرور برقرار نشد.';
      } finally {
        confirm.disabled = false;
      }
    });
  }
</script>
