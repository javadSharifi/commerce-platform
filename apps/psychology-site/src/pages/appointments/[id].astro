---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublicSite } from '../../lib/site.js';

// Set strict cache-control header to prevent private appointment caching
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');

const { id } = Astro.params;
const site = await fetchPublicSite(Astro.request);

const url = new URL(Astro.request.url);
const lookupHash = url.searchParams.get('hash') || url.searchParams.get('lookup_hash') || '';

// Fallback appointment for SSR/preview
const now = new Date();
const sampleStart = new Date(now.getTime() + 24 * 3600 * 1000);
sampleStart.setUTCHours(11, 0, 0, 0);
const sampleEnd = new Date(sampleStart.getTime() + 50 * 60 * 1000);

const fallbackAppointment = {
  id: id || '',
  therapist_id: 'e48a12bc-1111-4000-8000-000000000001',
  therapist_name: 'دکتر مریم علوی',
  guest_name: 'مراجع محترم',
  status: 'pending',
  expires_at: new Date(now.getTime() + 2 * 3600 * 1000).toISOString(),
  starts_at: sampleStart.toISOString(),
  ends_at: sampleEnd.toISOString(),
};

let appointmentData = fallbackAppointment;
let fetchError = '';
let isUnauthorized = false;

const apiBase = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const host = Astro.request.headers.get('host') || 'localhost:3000';

if (lookupHash && id) {
  try {
    const res = await fetch(`${apiBase}/public/appointments/${id}?hash=${encodeURIComponent(lookupHash)}`, {
      headers: {
        Host: host,
        'X-Guest-Lookup-Hash': lookupHash,
      },
      signal: AbortSignal.timeout(1200),
    });
    if (res.ok) {
      appointmentData = await res.json();
    } else if (res.status === 404 || res.status === 403) {
      if (id === 'appt-demo-1' || !import.meta.env.PROD) {
        appointmentData = fallbackAppointment;
      } else {
        isUnauthorized = true;
        fetchError = 'اطلاعات نوبت یافت نشد یا کلید پیگیری خصوصی نامعتبر است.';
      }
    }
  } catch {
    // API offline in dev
  }
} else if (!lookupHash) {
  if (import.meta.env.PROD) {
    isUnauthorized = true;
    fetchError = 'برای مشاهده نوبت نیاز به پیوند اختصاصی پیگیری دارید.';
  }
}

function formatDateTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function formatTimeTehran(dateStr: string) {
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      timeZone: 'Asia/Tehran',
      hour: '2-digit',
      minute: '2-digit',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

function getStatusBadge(st: string) {
  switch (st) {
    case 'confirmed':
      return { text: 'تأییدشده و قطعی', badgeClass: 'badge-success', icon: '✓' };
    case 'pending':
      return { text: 'در انتظار تأیید و تماس پذیرش', badgeClass: 'badge-info', icon: '⏳' };
    case 'cancelled':
      return { text: 'لغو شده', badgeClass: 'badge-error', icon: '✕' };
    case 'expired':
      return { text: 'منقضی‌شده', badgeClass: 'badge-ghost', icon: '⏱' };
    case 'completed':
      return { text: 'جلسه برگزار شد', badgeClass: 'badge-neutral', icon: '✓' };
    default:
      return { text: st, badgeClass: 'badge-ghost', icon: '•' };
  }
}

const badge = getStatusBadge(appointmentData.status);
const isFuture = new Date(appointmentData.starts_at).getTime() > Date.now();
const canCancel = (appointmentData.status === 'pending' || appointmentData.status === 'confirmed') && isFuture;
---

<BaseLayout
  title={`پیگیری خصوصی نوبت مشاوره | ${site.title}`}
  primaryColor={site.primary_color}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
  robots="noindex, nofollow"
>
  <div class="max-w-xl mx-auto px-4 py-10">
    <div class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 shadow-xs">
      {isUnauthorized ? (
        <div class="text-center py-6">
          <div class="w-14 h-14 rounded-full bg-error/20 text-error inline-flex items-center justify-center text-2xl mb-4">
            🔒
          </div>
          <h1 class="text-xl font-bold text-base-content mb-2">
            دسترسی به اطلاعات نوبت محدود است
          </h1>
          <p class="text-xs text-base-content/70 leading-relaxed mb-6">
            {fetchError || 'جهت حفظ حریم خصوصی مراجعین، مشاهده وضعیت نوبت فقط از طریق پیوند اختصاصی صادر شده امکان‌پذیر است.'}
          </p>
          <a href="/booking" class="btn btn-primary btn-sm">
            بازگشت به تقویم نوبت‌دهی
          </a>
        </div>
      ) : (
        <div>
          <!-- Status Header -->
          <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-base-200 text-2xl mb-3">
              {badge.icon}
            </div>
            <h1 class="text-xl sm:text-2xl font-extrabold text-base-content mb-2">
              وضعیت نوبت مشاوره
            </h1>
            <div class={`badge ${badge.badgeClass} text-xs font-bold py-2.5 px-4`}>
              {badge.text}
            </div>
          </div>

          <!-- Status Specific Notice -->
          {appointmentData.status === 'pending' && (
            <div class="alert alert-info text-xs mb-6 leading-relaxed">
              <strong>درخواست شما ثبت موقت شد:</strong> سانس مورد نظر تا حداکثر ۲ ساعت برای شما قفل شده است. همکاران پذیرش کلینیک به زودی جهت تأیید قطعی نوبت و هماهنگی نهایی با شما تماس خواهند گرفت.
            </div>
          )}

          {appointmentData.status === 'confirmed' && (
            <div class="alert alert-success text-xs mb-6 leading-relaxed">
              <strong>نوبت شما قطعی و نهایی شده است:</strong> لطفاً ۱۰ دقیقه پیش از ساعت شروع جلسه در محل کلینیک حضور به هم رسانید.
            </div>
          )}

          {appointmentData.status === 'cancelled' && (
            <div class="alert alert-error text-xs mb-6 leading-relaxed">
              این نوبت لغو شده است و زمان آن آزاد گردیده است. در صورت نیاز به تعیین وقت جدید می‌توانید از صفحه رزرو اقدام فرمایید.
            </div>
          )}

          {appointmentData.status === 'expired' && (
            <div class="alert alert-neutral text-xs mb-6 leading-relaxed">
              مهلت ۲ ساعته تأیید این سانس به پایان رسیده و نوبت منقضی گردیده است.
            </div>
          )}

          <!-- Details Table -->
          <div class="border border-base-200 rounded-box overflow-hidden mb-6 text-xs sm:text-sm">
            <div class="flex justify-between items-center p-3.5 border-b border-base-200 bg-base-200/40">
              <span class="text-base-content/60">نام مراجع:</span>
              <strong class="text-base-content">{appointmentData.guest_name}</strong>
            </div>
            <div class="flex justify-between items-center p-3.5 border-b border-base-200 bg-base-100">
              <span class="text-base-content/60">تاریخ جلسه (به وقت تهران):</span>
              <strong class="text-base-content">{formatDateTehran(appointmentData.starts_at)}</strong>
            </div>
            <div class="flex justify-between items-center p-3.5 border-b border-base-200 bg-base-200/40">
              <span class="text-base-content/60">ساعت برگزاری:</span>
              <strong class="text-primary font-bold" dir="ltr">
                {formatTimeTehran(appointmentData.starts_at)} - {formatTimeTehran(appointmentData.ends_at)}
              </strong>
            </div>
            <div class="flex justify-between items-center p-3.5 bg-base-100">
              <span class="text-base-content/60">کد پیگیری سیستمی:</span>
              <span class="font-mono text-xs text-base-content/70" dir="ltr">
                {appointmentData.id.slice(0, 8)}...
              </span>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-col gap-3">
            {canCancel && (
              <button
                type="button"
                id="cancel-appt-btn"
                class="btn btn-error btn-outline w-full text-sm font-bold"
              >
                لغو نوبت مشاوره
              </button>
            )}

            <a
              href="/booking"
              class="btn btn-ghost btn-sm w-full"
            >
              بازگشت به صفحه نوبت‌دهی
            </a>
          </div>

          <!-- Cancellation Confirmation Modal -->
          <div id="cancel-confirm-modal" class="hidden fixed inset-0 bg-black/60 z-50 items-center justify-center p-4">
            <div class="card bg-base-100 rounded-box max-w-sm w-full p-6 shadow-xl border border-base-200">
              <h3 class="text-base font-bold text-error mb-2">
                آیا از لغو نوبت اطمینان دارید؟
              </h3>
              <p class="text-xs text-base-content/70 leading-relaxed mb-5">
                با لغو نوبت، این سانس مجدداً برای سایر مراجعین آزاد خواهد شد و نوبت شما باطل می‌گردد.
              </p>
              <div id="cancel-modal-error" class="alert alert-error text-xs mb-4 hidden"></div>

              <div class="flex gap-2">
                <button
                  type="button"
                  id="confirm-cancel-btn"
                  class="btn btn-error btn-sm flex-1 font-bold"
                >
                  بله، لغو شود
                </button>
                <button
                  type="button"
                  id="dismiss-cancel-btn"
                  class="btn btn-ghost btn-sm"
                >
                  انصراف
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <script define:vars={{ appointmentId: appointmentData.id, lookupHash, apiBase }}>
    const cancelBtn = document.getElementById('cancel-appt-btn');
    const cancelModal = document.getElementById('cancel-confirm-modal');
    const dismissBtn = document.getElementById('dismiss-cancel-btn');
    const confirmBtn = document.getElementById('confirm-cancel-btn');
    const errorBox = document.getElementById('cancel-modal-error');

    if (cancelBtn && cancelModal) {
      cancelBtn.addEventListener('click', () => {
        cancelModal.classList.remove('hidden');
        cancelModal.classList.add('flex');
      });

      dismissBtn?.addEventListener('click', () => {
        cancelModal.classList.add('hidden');
        cancelModal.classList.remove('flex');
        if (errorBox) errorBox.classList.add('hidden');
      });

      confirmBtn?.addEventListener('click', async () => {
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'در حال لغو...';
        if (errorBox) errorBox.classList.add('hidden');

        try {
          const host = window.location.host;
          const res = await fetch(`${apiBase}/public/appointments/${appointmentId}/cancel`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Host': host,
              'X-Guest-Lookup-Hash': lookupHash,
            },
            body: JSON.stringify({ reason: 'لغو توسط مراجع از پنل پیگیری' }),
          });

          if (res.ok) {
            window.location.reload();
            return;
          }

          const err = await res.json().catch(() => ({}));
          if (errorBox) {
            errorBox.textContent = err.message || 'خطا در لغو نوبت.';
            errorBox.classList.remove('hidden');
          }
        } catch {
          if (errorBox) {
            errorBox.textContent = 'خطای ارتباط با سرور.';
            errorBox.classList.remove('hidden');
          }
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'بله، لغو شود';
        }
      });
    }
  </script>
</BaseLayout>
