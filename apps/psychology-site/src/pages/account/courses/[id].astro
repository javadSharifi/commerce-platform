---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fetchPublicSite } from '../../../lib/site.js';

// Strict private no-store header: buyer course streaming & lesson playback
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');

const { id } = Astro.params;
const site = await fetchPublicSite(Astro.request);
---

<BaseLayout
  title={`پخش جلسات دوره | ${site.title}`}
  description="پخش آنلاین و اختصاصی ویدیو و صوت جلسات دوره آموزشی"
  primaryColor={site.primary_color}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <a href="/account/courses" class="text-sm text-base-content/70 hover:text-primary transition-colors inline-flex items-center gap-1.5">
        <span>&larr;</span> بازگشت به لیست دوره‌های من
      </a>
    </div>

    <div id="course-viewer-root" data-course-id={id}>
      <!-- Loading State -->
      <div id="viewer-loading" class="text-center py-20 text-base-content/60">
        <span class="loading loading-spinner loading-lg text-primary mb-3"></span>
        <p class="text-sm">در حال بررسی دسترسی و بارگذاری اطلاعات دوره...</p>
      </div>

      <!-- Error State (Not Entitled / Revoked / Unauthenticated) -->
      <div id="viewer-error" class="hidden card bg-base-100 border border-error/30 rounded-box p-8 max-w-lg mx-auto text-center shadow-sm my-8">
        <div class="text-4xl text-error mb-3">🔒</div>
        <h2 id="viewer-error-title" class="text-lg font-bold text-error mb-2">
          عدم دسترسی به این دوره
        </h2>
        <p id="viewer-error-desc" class="text-xs text-base-content/70 mb-6 leading-relaxed">
          دسترسی معتبری برای حساب شما در این دوره یافت نشد.
        </p>
        <div id="viewer-error-actions" class="flex gap-3 justify-center">
          <a href="/account/courses" class="btn btn-ghost btn-sm">
            بازگشت به دوره‌های من
          </a>
          <a id="btn-public-course-link" href="/courses" class="btn btn-primary btn-sm hidden">
            مشاهده صفحه دوره
          </a>
        </div>
      </div>

      <!-- Main Player & Syllabus Grid -->
      <div id="viewer-content" class="hidden grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <!-- Left Column: Video/Audio Player & Active Lesson Info -->
        <div class="lg:col-span-2 flex flex-col gap-6">
          <!-- Unified Media Container -->
          <div class="bg-black rounded-box overflow-hidden shadow-md relative min-h-[260px] flex flex-col justify-center">
            <!-- 1. Video Player Element (for video/mp4) -->
            <video
              id="main-video-player"
              controls
              playsinline
              preload="metadata"
              class="w-full max-h-[480px] block bg-black"
            >
              مرورگر شما از پخش مستقیم ویدیو پشتیبانی نمی‌کند.
            </video>

            <!-- 2. Audio/Voice Player Element (for audio/mpeg) -->
            <div id="audio-player-wrapper" class="hidden p-8 bg-gradient-to-br from-neutral to-neutral-focus text-neutral-content">
              <div class="flex items-center justify-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center text-2xl text-primary">
                  🎙️
                </div>
                <div>
                  <span class="text-xs text-neutral-content/70 block">فایل صوتی اختصاصی جلسه</span>
                  <div id="audio-title-display" class="text-base font-bold text-neutral-content">جلسه صوتی</div>
                </div>
              </div>

              <!-- Native Audio Tag -->
              <audio id="main-audio-player" preload="metadata" class="w-full mb-4"></audio>

              <!-- Extra Audio Quick Controls for Mobile Seek & Speed -->
              <div class="flex items-center justify-between flex-wrap gap-3 border-t border-white/10 pt-4">
                <div class="flex gap-2">
                  <button id="btn-audio-back10" class="btn btn-ghost btn-xs text-neutral-content border border-white/20">
                    ↺ ۱۰ ثانیه قبل
                  </button>
                  <button id="btn-audio-fwd10" class="btn btn-ghost btn-xs text-neutral-content border border-white/20">
                    ↻ ۱۰ ثانیه بعد
                  </button>
                </div>
                <div class="flex items-center gap-2">
                  <label class="text-xs text-neutral-content/70">سرعت پخش:</label>
                  <select id="audio-speed-select" class="select select-bordered select-xs bg-neutral text-neutral-content">
                    <option value="0.75">۰.۷۵x</option>
                    <option value="1.0" selected>۱.۰x (طبیعی)</option>
                    <option value="1.25">۱.۲۵x</option>
                    <option value="1.5">۱.۵x</option>
                    <option value="2.0">۲.۰x</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Loading overlay when fetching / renewing stream URL -->
            <div id="player-loading-overlay" class="hidden absolute inset-0 bg-black/85 text-white flex-col items-center justify-center gap-3 z-10">
              <span class="loading loading-spinner loading-md text-primary"></span>
              <span id="player-loading-text" class="text-xs">در حال صدور لینک امن و بهینه‌سازی پخش...</span>
            </div>

            <!-- Mobile buffering spinner -->
            <div id="player-buffering-overlay" class="hidden absolute top-4 start-4 bg-black/75 text-white px-3 py-1.5 rounded-full text-xs z-5 items-center gap-2">
              <span class="loading loading-spinner loading-xs text-primary"></span>
              <span>در حال دریافت داده شبکه...</span>
            </div>
          </div>

          <!-- Lesson Meta Card -->
          <div class="card bg-base-100 border border-base-200 rounded-box p-6 shadow-xs">
            <div class="flex justify-between items-start gap-4 mb-3 flex-wrap">
              <div>
                <span id="media-type-badge" class="badge badge-ghost text-xs mb-2">
                  ویدیو آموزشی
                </span>
                <h1 id="active-lesson-title" class="text-lg sm:text-xl font-bold text-base-content leading-snug">
                  عنوان جلسه
                </h1>
              </div>
              <span id="stream-ttl-badge" class="badge badge-success badge-sm text-xs py-2 whitespace-nowrap">
                🔒 لینک امن فعال
              </span>
            </div>
            <p id="active-lesson-desc" class="text-xs sm:text-sm text-base-content/80 leading-relaxed mb-4">
              توضیحات جلسه در این قسمت نمایش داده می‌شود.
            </p>
            <div class="flex items-center justify-between border-t border-base-200 pt-4 text-xs text-base-content/60 flex-wrap gap-2">
              <span id="active-course-title">دوره: -</span>
              <div class="flex gap-2 items-center">
                <span id="seek-status-label" class="text-xs text-success hidden">موقعیت بازنشانی شد ✓</span>
                <button id="btn-renew-stream" class="btn btn-ghost btn-xs border border-base-300">
                  🔄 تمدید لینک پخش
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Playlist / Lessons Outline -->
        <div class="card bg-base-100 border border-base-200 rounded-box p-5 shadow-xs">
          <h2 class="text-base font-bold text-base-content mb-4 border-b border-base-200 pb-3">
            جلسات دوره
          </h2>
          <div id="lessons-playlist" class="flex flex-col gap-2 max-h-[520px] overflow-y-auto">
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface LessonItem {
    id: string;
    title: string;
    description?: string;
    display_order: number;
    duration_seconds: number;
    is_free_preview: boolean;
  }

  interface CourseDetail {
    id: string;
    title: string;
    slug: string;
    description: string;
    instructor_name: string;
    status: string;
    lessons: LessonItem[];
  }

  interface CourseEntitlement {
    id: string;
    course_id: string;
    course_slug?: string;
    course_title_snapshot: string;
    status: 'active' | 'revoked';
  }

  const rootEl = document.getElementById('course-viewer-root');
  const courseIdParam = rootEl?.getAttribute('data-course-id') || '';

  const loadingEl = document.getElementById('viewer-loading');
  const errorEl = document.getElementById('viewer-error');
  const errorTitle = document.getElementById('viewer-error-title');
  const errorDesc = document.getElementById('viewer-error-desc');

  const contentEl = document.getElementById('viewer-content');
  const videoPlayer = document.getElementById('main-video-player') as HTMLVideoElement;
  const audioWrapper = document.getElementById('audio-player-wrapper');
  const audioPlayer = document.getElementById('main-audio-player') as HTMLAudioElement;
  const audioTitleDisplay = document.getElementById('audio-title-display');
  const mediaTypeBadge = document.getElementById('media-type-badge');

  const playerOverlay = document.getElementById('player-loading-overlay');

  const activeTitle = document.getElementById('active-lesson-title');
  const activeDesc = document.getElementById('active-lesson-desc');
  const activeCourseTitle = document.getElementById('active-course-title');
  const btnRenew = document.getElementById('btn-renew-stream');
  const playlistEl = document.getElementById('lessons-playlist');

  const btnAudioBack10 = document.getElementById('btn-audio-back10');
  const btnAudioFwd10 = document.getElementById('btn-audio-fwd10');
  const audioSpeedSelect = document.getElementById('audio-speed-select') as HTMLSelectElement;

  let currentCourse: CourseDetail | null = null;
  let activeLesson: LessonItem | null = null;

  async function initViewer() {
    try {
      const authRes = await fetch('/account/auth/me');
      if (!authRes.ok) {
        showError('ورود به حساب کاربری الزامی است', 'جهت مشاهده جلسات دوره، ابتدا باید وارد حساب کاربری خود شوید.');
        return;
      }

      const coursesRes = await fetch('/account/courses/my');
      if (!coursesRes.ok) {
        showError('عدم دسترسی به دوره', 'اطلاعات دوره‌های خریداری‌شده شما یافت نشد.');
        return;
      }
      const myCourses: CourseEntitlement[] = await coursesRes.json();
      const entitlement = myCourses.find(c => c.course_id === courseIdParam || c.id === courseIdParam);

      if (!entitlement || entitlement.status === 'revoked') {
        showError('عدم دسترسی به دوره', 'شما به این دوره دسترسی ندارید یا دسترسی لغو شده است.');
        return;
      }

      const detailRes = await fetch(`/public/courses/${entitlement.course_slug || entitlement.course_id}`);
      if (!detailRes.ok) {
        showError('خطا در دریافت اطلاعات دوره', 'امکان دریافت سرفصل‌ها و جلسات دوره میسر نشد.');
        return;
      }
      currentCourse = await detailRes.json();

      if (!currentCourse || !currentCourse.lessons || currentCourse.lessons.length === 0) {
        showError('جلسه‌ای یافت نشد', 'این دوره هنوز هیچ جلسه بارگذاری‌شده‌ای ندارد.');
        return;
      }

      renderViewer();
    } catch {
      showError('خطای ارتباط با سرور', 'برقراری ارتباط با سامانه آموزش میسر نشد.');
    }
  }

  function showError(title: string, desc: string) {
    if (loadingEl) loadingEl.classList.add('hidden');
    if (contentEl) contentEl.classList.add('hidden');
    if (errorEl) {
      errorEl.classList.remove('hidden');
      if (errorTitle) errorTitle.textContent = title;
      if (errorDesc) errorDesc.textContent = desc;
    }
  }

  function renderViewer() {
    if (!currentCourse) return;
    if (loadingEl) loadingEl.classList.add('hidden');
    if (contentEl) {
      contentEl.classList.remove('hidden');
      contentEl.classList.add('grid');
    }

    if (activeCourseTitle) activeCourseTitle.textContent = `دوره: ${currentCourse.title}`;

    if (playlistEl) {
      playlistEl.innerHTML = '';
      currentCourse.lessons.forEach((l) => {
        const item = document.createElement('div');
        item.className = 'flex items-center gap-3 p-3 rounded-box border border-base-200 bg-base-200/40 cursor-pointer hover:bg-base-200 transition-all text-xs';
        item.setAttribute('data-lesson-id', l.id);
        item.innerHTML = `
          <span class="w-6 h-6 rounded-full bg-base-300 font-bold flex items-center justify-center shrink-0">
            ${l.display_order}
          </span>
          <div class="flex-1 truncate">
            <div class="font-semibold text-base-content truncate">${l.title}</div>
            <div class="text-[11px] text-base-content/60">${Math.round(l.duration_seconds / 60)} دقیقه</div>
          </div>
        `;
        item.addEventListener('click', () => switchLesson(l));
        playlistEl.appendChild(item);
      });
    }

    if (currentCourse.lessons.length > 0) {
      switchLesson(currentCourse.lessons[0]);
    }
  }

  async function switchLesson(lesson: LessonItem) {
    activeLesson = lesson;
    if (activeTitle) activeTitle.textContent = lesson.title;
    if (activeDesc) activeDesc.textContent = lesson.description || 'توضیحات تکمیلی برای این جلسه ثبت نشده است.';

    if (playlistEl) {
      const items = playlistEl.querySelectorAll('div[data-lesson-id]');
      items.forEach((it) => {
        if (it.getAttribute('data-lesson-id') === lesson.id) {
          it.className = 'flex items-center gap-3 p-3 rounded-box border border-primary bg-primary/10 text-primary cursor-pointer transition-all text-xs font-bold';
        } else {
          it.className = 'flex items-center gap-3 p-3 rounded-box border border-base-200 bg-base-200/40 cursor-pointer hover:bg-base-200 transition-all text-xs';
        }
      });
    }

    await loadLessonMedia(lesson.id);
  }

  async function loadLessonMedia(lessonId: string) {
    if (playerOverlay) {
      playerOverlay.classList.remove('hidden');
      playerOverlay.classList.add('flex');
    }
    try {
      const res = await fetch(`/account/lessons/${lessonId}/stream`);
      if (res.ok) {
        const streamData = await res.json();
        const streamUrl = streamData.stream_url;
        const mimeType = streamData.mime_type || 'video/mp4';

        if (mimeType.startsWith('audio/')) {
          if (videoPlayer) videoPlayer.classList.add('hidden');
          if (audioWrapper) audioWrapper.classList.remove('hidden');
          if (audioTitleDisplay && activeLesson) audioTitleDisplay.textContent = activeLesson.title;
          if (mediaTypeBadge) mediaTypeBadge.textContent = 'صوت آموزشی';
          if (audioPlayer) {
            audioPlayer.src = streamUrl;
            audioPlayer.load();
          }
        } else {
          if (audioWrapper) audioWrapper.classList.add('hidden');
          if (videoPlayer) {
            videoPlayer.classList.remove('hidden');
            videoPlayer.src = streamUrl;
            videoPlayer.load();
          }
          if (mediaTypeBadge) mediaTypeBadge.textContent = 'ویدیو آموزشی';
        }
      }
    } catch {
      // media stream error
    } finally {
      if (playerOverlay) {
        playerOverlay.classList.add('hidden');
        playerOverlay.classList.remove('flex');
      }
    }
  }

  btnRenew?.addEventListener('click', () => {
    if (activeLesson) loadLessonMedia(activeLesson.id);
  });

  btnAudioBack10?.addEventListener('click', () => {
    if (audioPlayer) audioPlayer.currentTime = Math.max(0, audioPlayer.currentTime - 10);
  });

  btnAudioFwd10?.addEventListener('click', () => {
    if (audioPlayer) audioPlayer.currentTime = Math.min(audioPlayer.duration || 0, audioPlayer.currentTime + 10);
  });

  audioSpeedSelect?.addEventListener('change', () => {
    if (audioPlayer) audioPlayer.playbackRate = parseFloat(audioSpeedSelect.value);
  });

  initViewer();
</script>
