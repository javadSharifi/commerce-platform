---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fetchPublicSite } from '../../../lib/site.js';

// Strict private no-store header: buyer courses dashboard
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');

const site = Astro.locals.site || (await fetchPublicSite(Astro.request));
---

<BaseLayout
  title={`دوره‌های من | ${site.title}`}
  description="مشاهده و دسترسی به دوره‌های آموزشی خریداری‌شده"
  paletteId={site.palette_id}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 border-b border-base-200 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content mb-1">
          دوره‌های من
        </h1>
        <p class="text-sm text-base-content/70">
          لیست دوره‌های آموزشی خریداری‌شده با امکان تماشا و استریم آنلاین
        </p>
      </div>
      <div id="buyer-badge" class="hidden items-center gap-2 bg-base-200 text-base-content px-3 py-1.5 rounded-full text-xs font-semibold">
        <span id="buyer-phone-label"></span>
        <button id="btn-logout" class="text-error hover:underline cursor-pointer text-xs ms-2">خروج</button>
      </div>
    </div>

    <!-- State 1: Checking Authentication -->
    <div id="state-checking" class="text-center py-16 text-base-content/60">
      <span class="loading loading-spinner loading-lg text-primary mb-3"></span>
      <p class="text-sm">در حال بررسی وضعیت ورود به حساب کاربری...</p>
    </div>

    <!-- State 2: Unauthenticated - Login Form -->
    <div id="state-unauthed" class="hidden card bg-base-100 border border-base-200 rounded-box p-6 sm:p-8 max-w-md mx-auto shadow-sm text-center my-8">
      <div class="text-4xl mb-3">🎓</div>
      <h2 class="text-lg sm:text-xl font-bold text-base-content mb-2">
        ورود به حساب جهت مشاهده دوره‌ها
      </h2>
      <p class="text-xs text-base-content/70 mb-6 leading-relaxed">
        جهت دسترسی به جلسات و تماشای دوره‌های خریداری‌شده، لطفاً با شماره موبایلی که با آن ثبت‌نام کرده‌اید وارد شوید.
      </p>

      <!-- Step 1: Phone Input -->
      <div id="login-step-phone">
        <div class="mb-4 text-start">
          <label class="label-text text-xs font-semibold text-base-content block mb-1">
            شماره موبایل
          </label>
          <input
            type="tel"
            id="login-phone-input"
            placeholder="۰۹۱۲۳۴۵۶۷۸۹"
            dir="ltr"
            class="input input-bordered w-full text-base-content bg-base-100 text-center text-sm"
          />
        </div>
        <button id="btn-login-send-otp" class="btn btn-primary w-full text-sm font-semibold">
          دریافت کد تأیید ورود
        </button>
      </div>

      <!-- Step 2: OTP Verification -->
      <div id="login-step-verify" class="hidden">
        <div class="mb-4 text-start">
          <label class="label-text text-xs font-semibold text-base-content block mb-1">
            کد تأیید ارسال‌شده
          </label>
          <input
            type="text"
            id="login-code-input"
            placeholder="کد ۵ رقمی"
            dir="ltr"
            maxlength="6"
            class="input input-bordered w-full text-base-content bg-base-100 text-center tracking-widest text-sm"
          />
        </div>
        <button id="btn-login-verify-otp" class="btn btn-primary w-full text-sm font-semibold">
          ورود و مشاهده دوره‌ها
        </button>
      </div>

      <div id="login-msg" class="mt-3 text-xs hidden"></div>
    </div>

    <!-- State 3: Authenticated - Courses List -->
    <div id="state-authed" class="hidden">
      <!-- Empty State -->
      <div id="courses-empty" class="hidden card bg-base-100 border border-base-200 rounded-box p-10 text-center">
        <div class="text-4xl text-base-content/40 mb-3">📚</div>
        <h3 class="text-lg font-bold text-base-content mb-1">هنوز در دوره‌ای ثبت‌نام نکرده‌اید</h3>
        <p class="text-xs text-base-content/70 mb-5">
          دوره‌های آموزشی ارائه‌شده توسط متخصصین روان‌شناسی را مشاهده و ثبت‌نام کنید.
        </p>
        <div>
          <a href="/courses" class="btn btn-primary btn-sm">
            مشاهده لیست دوره‌های آموزشی
          </a>
        </div>
      </div>

      <!-- Courses Grid -->
      <div id="courses-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const stateChecking = document.getElementById('state-checking');
  const stateUnauthed = document.getElementById('state-unauthed');
  const stateAuthed = document.getElementById('state-authed');
  const buyerBadge = document.getElementById('buyer-badge');
  const buyerPhoneLabel = document.getElementById('buyer-phone-label');
  const btnLogout = document.getElementById('btn-logout');

  const stepPhone = document.getElementById('login-step-phone');
  const stepVerify = document.getElementById('login-step-verify');
  const phoneInput = document.getElementById('login-phone-input') as HTMLInputElement;
  const codeInput = document.getElementById('login-code-input') as HTMLInputElement;
  const btnSendOtp = document.getElementById('btn-login-send-otp') as HTMLButtonElement;
  const btnVerifyOtp = document.getElementById('btn-login-verify-otp') as HTMLButtonElement;
  const loginMsg = document.getElementById('login-msg');

  const coursesGrid = document.getElementById('courses-grid');
  const coursesEmpty = document.getElementById('courses-empty');

  function showLoginMsg(text: string, isError = true) {
    if (!loginMsg) return;
    loginMsg.classList.remove('hidden', 'text-error', 'text-success');
    loginMsg.classList.add(isError ? 'text-error' : 'text-success');
    loginMsg.textContent = text;
  }

  async function checkAuth() {
    try {
      const res = await fetch('/v1/account/auth/me');
      if (res.ok) {
        const buyer = await res.json();
        if (stateChecking) stateChecking.classList.add('hidden');
        if (stateUnauthed) stateUnauthed.classList.add('hidden');
        if (stateAuthed) stateAuthed.classList.remove('hidden');
        if (buyerBadge) {
          buyerBadge.classList.remove('hidden');
          buyerBadge.classList.add('flex');
        }
        if (buyerPhoneLabel) buyerPhoneLabel.textContent = buyer.phone;
        await loadMyCourses();
        return;
      }
    } catch {
      // not logged in
    }
    if (stateChecking) stateChecking.classList.add('hidden');
    if (stateUnauthed) stateUnauthed.classList.remove('hidden');
    if (stateAuthed) stateAuthed.classList.add('hidden');
    if (buyerBadge) buyerBadge.classList.add('hidden');
  }

  checkAuth();

  btnLogout?.addEventListener('click', async () => {
    try {
      await fetch('/v1/account/auth/logout', { method: 'POST' });
    } catch {
      // Ignore network errors on logout
    }
    window.location.reload();
  });

  btnSendOtp?.addEventListener('click', async () => {
    const phone = phoneInput?.value.trim();
    if (!phone) {
      showLoginMsg('لطفاً شماره موبایل را وارد نمایید.');
      return;
    }
    btnSendOtp.disabled = true;
    btnSendOtp.textContent = 'در حال ارسال...';
    try {
      const res = await fetch('/v1/account/auth/otp/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json();
      if (res.ok) {
        showLoginMsg('کد تأیید به شماره شما پیامک شد.', false);
        if (stepPhone) stepPhone.classList.add('hidden');
        if (stepVerify) stepVerify.classList.remove('hidden');
      } else {
        showLoginMsg(data.message || 'خطا در ارسال کد تأیید.');
        btnSendOtp.disabled = false;
        btnSendOtp.textContent = 'دریافت کد تأیید ورود';
      }
    } catch {
      showLoginMsg('خطا در برقراری ارتباط با سرور.');
      btnSendOtp.disabled = false;
      btnSendOtp.textContent = 'دریافت کد تأیید ورود';
    }
  });

  btnVerifyOtp?.addEventListener('click', async () => {
    const phone = phoneInput?.value.trim();
    const code = codeInput?.value.trim();
    if (!code) {
      showLoginMsg('لطفاً کد ۵ رقمی را وارد نمایید.');
      return;
    }
    btnVerifyOtp.disabled = true;
    btnVerifyOtp.textContent = 'در حال تأیید...';
    try {
      const res = await fetch('/v1/account/auth/otp/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, code }),
      });
      const data = await res.json();
      if (res.ok) {
        showLoginMsg('ورود با موفقیت انجام شد.', false);
        await checkAuth();
      } else {
        showLoginMsg(data.message || 'کد واردشده نامعتبر یا منقضی است.');
        btnVerifyOtp.disabled = false;
        btnVerifyOtp.textContent = 'ورود و مشاهده دوره‌ها';
      }
    } catch {
      showLoginMsg('خطا در برقراری ارتباط با سرور.');
      btnVerifyOtp.disabled = false;
      btnVerifyOtp.textContent = 'ورود و مشاهده دوره‌ها';
    }
  });

  async function loadMyCourses() {
    if (!coursesGrid) return;
    coursesGrid.replaceChildren();
    try {
      const res = await fetch('/v1/account/courses');
      if (res.ok) {
        const items = await res.json();
        if (Array.isArray(items) && items.length > 0) {
          if (coursesEmpty) coursesEmpty.classList.add('hidden');
          items.forEach((c) => {
            const card = document.createElement('article');
            card.className = 'card bg-base-100 border border-base-200 rounded-box p-5 shadow-xs flex flex-col justify-between';

            const topDiv = document.createElement('div');

            const badge = document.createElement('div');
            badge.className = 'badge badge-success badge-sm text-xs mb-3';
            badge.textContent = 'دسترسی فعال';
            topDiv.appendChild(badge);

            const heading = document.createElement('h3');
            heading.className = 'font-bold text-base text-base-content mb-2 leading-snug';
            heading.textContent = c.title || '';
            topDiv.appendChild(heading);

            const instructor = document.createElement('div');
            instructor.className = 'text-xs text-base-content/70 mb-4';
            instructor.textContent = `مدرس: ${c.instructor_name || 'مرکز روان‌شناسی'}`;
            topDiv.appendChild(instructor);

            card.appendChild(topDiv);

            const bottomDiv = document.createElement('div');
            bottomDiv.className = 'pt-4 border-t border-base-200';

            const link = document.createElement('a');
            link.href = `/account/courses/${encodeURIComponent(c.id)}`;
            link.className = 'btn btn-primary btn-sm w-full';
            link.textContent = 'ورود به کلاس و پخش آنلاین';
            bottomDiv.appendChild(link);

            card.appendChild(bottomDiv);

            coursesGrid.appendChild(card);
          });
          return;
        }
      }
    } catch (err) {
      console.error('Failed to load my courses:', err);
    }
    if (coursesEmpty) coursesEmpty.classList.remove('hidden');
  }
</script>
