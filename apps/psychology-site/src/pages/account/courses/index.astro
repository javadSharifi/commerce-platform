---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Strict private no-store header: buyer courses dashboard
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');
---

<BaseLayout title="دوره‌های من - پنل کاربری" description="مشاهده و دسترسی به دوره‌های آموزشی خریداری‌شده">
  <div style="max-width: 900px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin-bottom: 0.35rem;">
          دوره‌های من
        </h1>
        <p style="font-size: 0.95rem; color: #64748b;">
          لیست دوره‌های آموزشی خریداری‌شده با امکان تماشا و استریم آنلاین
        </p>
      </div>
      <div id="buyer-badge" style="display: none; background: #e0f2fe; color: #0369a1; padding: 0.4rem 0.85rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600;">
        <span id="buyer-phone-label"></span>
        <button id="btn-logout" style="background: none; border: none; color: #dc2626; margin-right: 0.5rem; cursor: pointer; font-size: 0.8rem; text-decoration: underline;">خروج</button>
      </div>
    </div>

    <!-- State 1: Checking Authentication -->
    <div id="state-checking" style="text-align: center; padding: 4rem 2rem; color: #64748b;">
      <div style="display: inline-block; width: 32px; height: 32px; border: 3px solid #cbd5e1; border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 1rem;"></div>
      <p style="font-size: 1rem;">در حال بررسی وضعیت ورود به حساب کاربری...</p>
    </div>

    <!-- State 2: Unauthenticated - Login Form -->
    <div id="state-unauthed" style="display: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 2.5rem; max-width: 480px; margin: 2rem auto; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); text-align: center;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🎓</div>
      <h2 style="font-size: 1.3rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem;">ورود به حساب جهت مشاهده دوره‌ها</h2>
      <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.5rem; line-height: 1.6;">
        جهت دسترسی به جلسات و تماشای دوره‌های خریداری‌شده، لطفاً با شماره موبایلی که با آن ثبت‌نام کرده‌اید وارد شوید.
      </p>

      <!-- Step 1: Phone Input -->
      <div id="login-step-phone">
        <div style="margin-bottom: 1rem; text-align: right;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">
            شماره موبایل
          </label>
          <input
            type="tel"
            id="login-phone-input"
            placeholder="۰۹۱۲۳۴۵۶۷۸۹"
            dir="ltr"
            style="width: 100%; padding: 0.65rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 1rem; text-align: center;"
          />
        </div>
        <button id="btn-login-send-otp" class="btn" style="width: 100%; padding: 0.7rem; font-weight: 600;">
          دریافت کد تأیید ورود
        </button>
      </div>

      <!-- Step 2: OTP Verification -->
      <div id="login-step-verify" style="display: none;">
        <div style="margin-bottom: 1rem; text-align: right;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">
            کد تأیید ارسال‌شده
          </label>
          <input
            type="text"
            id="login-code-input"
            placeholder="کد ۵ رقمی"
            dir="ltr"
            maxlength="6"
            style="width: 100%; padding: 0.65rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 1.2rem; text-align: center; letter-spacing: 0.25rem;"
          />
        </div>
        <button id="btn-login-verify-otp" class="btn" style="width: 100%; padding: 0.7rem; font-weight: 600;">
          ورود و مشاهده دوره‌ها
        </button>
      </div>

      <div id="login-msg" style="margin-top: 1rem; font-size: 0.85rem; display: none;"></div>
    </div>

    <!-- State 3: Authenticated - Courses List -->
    <div id="state-authed" style="display: none;">
      <!-- Empty State -->
      <div id="courses-empty" style="display: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 3rem; text-align: center;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: #94a3b8;">📚</div>
        <h3 style="font-size: 1.2rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem;">هنوز در دوره‌ای ثبت‌نام نکرده‌اید</h3>
        <p style="font-size: 0.95rem; color: #64748b; margin-bottom: 1.5rem;">
          دوره‌های آموزشی ارائه‌شده توسط متخصصین روان‌شناسی را مشاهده و ثبت‌نام کنید.
        </p>
        <a href="/courses" class="btn" style="padding: 0.65rem 1.5rem;">
          مشاهده لیست دوره‌های آموزشی
        </a>
      </div>

      <!-- Courses Grid -->
      <div id="courses-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  interface CourseEntitlement {
    id: string;
    course_id: string;
    course_slug?: string;
    course_title_snapshot: string;
    price_rials_snapshot: number;
    status: 'active' | 'revoked';
    granted_at: string;
  }

  const stateChecking = document.getElementById('state-checking');
  const stateUnauthed = document.getElementById('state-unauthed');
  const stateAuthed = document.getElementById('state-authed');
  const buyerBadge = document.getElementById('buyer-badge');
  const buyerPhoneLabel = document.getElementById('buyer-phone-label');
  const btnLogout = document.getElementById('btn-logout');

  const stepPhone = document.getElementById('login-step-phone');
  const stepVerify = document.getElementById('login-step-verify');
  const phoneInput = document.getElementById('login-phone-input') as HTMLInputElement;
  const codeInput = document.getElementById('login-code-input') as HTMLInputElement;
  const btnSendOtp = document.getElementById('btn-login-send-otp') as HTMLButtonElement;
  const btnVerifyOtp = document.getElementById('btn-login-verify-otp') as HTMLButtonElement;
  const loginMsg = document.getElementById('login-msg');

  const coursesEmpty = document.getElementById('courses-empty');
  const coursesGrid = document.getElementById('courses-grid');

  function showLoginMsg(text: string, isError = true) {
    if (!loginMsg) return;
    loginMsg.style.display = 'block';
    loginMsg.style.color = isError ? '#dc2626' : '#16a34a';
    loginMsg.textContent = text;
  }

  function formatPriceTomans(rials: number): string {
    if (rials <= 0) return 'رایگان';
    const tomans = Math.floor(rials / 10);
    return tomans.toLocaleString('fa-IR') + ' تومان';
  }

  function formatDateFa(isoString: string): string {
    try {
      const d = new Date(isoString);
      return d.toLocaleDateString('fa-IR', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    } catch {
      return isoString;
    }
  }

  async function checkBuyerSession() {
    try {
      const res = await fetch('/account/auth/me');
      if (res.ok) {
        const buyer = await res.json();
        if (stateChecking) stateChecking.style.display = 'none';
        if (stateUnauthed) stateUnauthed.style.display = 'none';
        if (stateAuthed) stateAuthed.style.display = 'block';
        if (buyerBadge) buyerBadge.style.display = 'inline-flex';
        if (buyerPhoneLabel) buyerPhoneLabel.textContent = `حساب: ${buyer.phone}`;
        await loadMyCourses();
        return;
      }
    } catch {
      // Not logged in
    }
    if (stateChecking) stateChecking.style.display = 'none';
    if (stateAuthed) stateAuthed.style.display = 'none';
    if (stateUnauthed) stateUnauthed.style.display = 'block';
    if (buyerBadge) buyerBadge.style.display = 'none';
  }

  async function loadMyCourses() {
    if (!coursesGrid || !coursesEmpty) return;
    coursesGrid.innerHTML = '';
    try {
      const res = await fetch('/account/courses');
      if (!res.ok) {
        if (res.status === 401) {
          await checkBuyerSession();
          return;
        }
        throw new Error('Failed to load courses');
      }
      const courses: CourseEntitlement[] = await res.json();
      if (!courses || courses.length === 0) {
        coursesEmpty.style.display = 'block';
        coursesGrid.style.display = 'none';
        return;
      }

      coursesEmpty.style.display = 'none';
      coursesGrid.style.display = 'grid';

      courses.forEach((item) => {
        const card = document.createElement('div');
        card.style.background = '#ffffff';
        card.style.border = '1px solid #e2e8f0';
        card.style.borderRadius = '1rem';
        card.style.padding = '1.5rem';
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
        card.style.justifyContent = 'space-between';
        card.style.boxShadow = '0 1px 3px rgba(0,0,0,0.05)';

        const isActive = item.status === 'active';
        const statusBadge = isActive
          ? `<span style="background: #dcfce7; color: #15803d; padding: 0.2rem 0.6rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">دسترسی فعال</span>`
          : `<span style="background: #fee2e2; color: #b91c1c; padding: 0.2rem 0.6rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">لغوشده / مرجوعی</span>`;

        const actionBtn = isActive
          ? `<a href="/account/courses/${encodeURIComponent(item.course_id)}" class="btn" style="text-align: center; padding: 0.6rem; font-size: 0.95rem; font-weight: 600;">
              مشاهده و پخش دوره
            </a>`
          : `<button disabled style="width: 100%; padding: 0.6rem; background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; border-radius: 0.5rem; font-size: 0.9rem; cursor: not-allowed;">
              دسترسی غیرفعال است
            </button>`;

        card.innerHTML = `
          <div>
            <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span style="font-size: 0.8rem; color: #64748b;">تاریخ ثبت: ${formatDateFa(item.granted_at)}</span>
              ${statusBadge}
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin-bottom: 0.75rem; line-height: 1.4;">
              ${item.course_title_snapshot}
            </h3>
            <div style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.25rem;">
              مبلغ پرداختی: <span style="font-weight: 600; color: #1e293b;">${formatPriceTomans(item.price_rials_snapshot)}</span>
            </div>
          </div>
          <div>
            ${actionBtn}
          </div>
        `;
        coursesGrid.appendChild(card);
      });
    } catch {
      coursesEmpty.style.display = 'block';
      coursesGrid.style.display = 'none';
    }
  }

  btnSendOtp?.addEventListener('click', async () => {
    const phone = phoneInput?.value.trim();
    if (!phone) {
      showLoginMsg('لطفاً شماره موبایل را وارد نمایید.');
      return;
    }
    btnSendOtp.disabled = true;
    btnSendOtp.textContent = 'در حال ارسال...';
    try {
      const res = await fetch('/account/auth/otp/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json();
      if (res.ok) {
        showLoginMsg('کد تأیید پیامک شد.', false);
        if (stepPhone) stepPhone.style.display = 'none';
        if (stepVerify) stepVerify.style.display = 'block';
      } else {
        showLoginMsg(data.message || 'خطا در ارسال کد تأیید.');
        btnSendOtp.disabled = false;
        btnSendOtp.textContent = 'دریافت کد تأیید ورود';
      }
    } catch {
      showLoginMsg('خطا در برقراری ارتباط با سرور.');
      btnSendOtp.disabled = false;
      btnSendOtp.textContent = 'دریافت کد تأیید ورود';
    }
  });

  btnVerifyOtp?.addEventListener('click', async () => {
    const phone = phoneInput?.value.trim();
    const code = codeInput?.value.trim();
    if (!code) {
      showLoginMsg('لطفاً کد تأیید را وارد نمایید.');
      return;
    }
    btnVerifyOtp.disabled = true;
    btnVerifyOtp.textContent = 'در حال ورود...';
    try {
      const res = await fetch('/account/auth/otp/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, code }),
      });
      const data = await res.json();
      if (res.ok) {
        showLoginMsg('ورود موفقیت‌آمیز بود.', false);
        await checkBuyerSession();
      } else {
        showLoginMsg(data.message || 'کد واردشده نامعتبر یا منقضی است.');
        btnVerifyOtp.disabled = false;
        btnVerifyOtp.textContent = 'ورود و مشاهده دوره‌ها';
      }
    } catch {
      showLoginMsg('خطا در ارتباط با سرور.');
      btnVerifyOtp.disabled = false;
      btnVerifyOtp.textContent = 'ورود و مشاهده دوره‌ها';
    }
  });

  btnLogout?.addEventListener('click', async () => {
    try {
      await fetch('/account/auth/logout', { method: 'POST' });
    } catch {
      // Ignore
    }
    window.location.reload();
  });

  checkBuyerSession();
</script>
