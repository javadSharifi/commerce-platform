---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublicSite, getApiBaseUrl } from '../../lib/site.js';
import { resolveTemplate } from '../../templates/registry.js';
import type { BlogCardVM } from '../../templates/view-models.js';
import { EmptyState } from '@psychology/ui';

// Edge CDN caching: public blog listing
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=60');

const site = await fetchPublicSite(Astro.request);
const activeTemplate = resolveTemplate(site.template_id);
const BlogCard = activeTemplate.components.BlogCard;

// Fallback sample posts for dev/preview when API is offline
const fallbackPosts = [
  {
    id: 'b1111111-1111-1111-1111-111111111111',
    title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
    slug: 'self-awareness-and-emotional-regulation',
    seo_description: 'بررسی راهکارهای علمی و روان‌شناختی جهت تقویت خودآگاهی و بهبود مهارت‌های ارتباطی در زندگی روزمره.',
    published_at: '2026-11-15T10:00:00Z',
    status: 'published',
    cover_url: null,
  },
  {
    id: 'b2222222-2222-2222-2222-222222222222',
    title: 'چگونه اضطراب عملکرد را در موقعیت‌های حساس مدیریت کنیم؟',
    slug: 'managing-performance-anxiety',
    seo_description: 'تکنیک‌های شناختی-رفتاری اثربخش برای مهار استرس و افزایش تاب‌آوری در مواجهه با چالش‌های شغلی و تحصیلی.',
    published_at: '2026-11-18T14:30:00Z',
    status: 'published',
    cover_url: null,
  },
];

let posts = fallbackPosts;

// Allow explicit empty state query parameter for testing and zero-state verification
const forceEmpty = Astro.url.searchParams.get('empty') === '1';

if (forceEmpty) {
  posts = [];
} else {
  const apiBase = getApiBaseUrl() || 'http://localhost:8080';
  const host = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host') || 'localhost:3000';

  try {
    const res = await fetch(`${apiBase}/v1/public/blog`, {
      headers: { Host: host, 'X-Forwarded-Host': host },
      signal: AbortSignal.timeout(1000),
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data)) {
        // Strictly only show published posts
        posts = data.filter((p: any) => p.status === 'published' || !p.status);
      }
    }
  } catch {
    // Graceful fallback to sample data for dev/preview
  }
}

function formatDatePersian(dateStr?: string | null) {
  if (!dateStr) return '';
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'medium',
      timeZone: 'Asia/Tehran',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}

const blogVMs: BlogCardVM[] = posts.map((post) => ({
  id: post.id,
  slug: post.slug,
  title: post.title,
  excerpt: post.seo_description,
  dateLabel: formatDatePersian(post.published_at),
  coverUrl: post.cover_url || null,
}));
---

<BaseLayout
  title={`مقالات و یادداشت‌های تخصصی | ${site.title}`}
  description="مجموعه مقالات، یادداشت‌ها و آموزش‌های معتبر روان‌شناسی و سلامت روان"
  paletteId={site.palette_id}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Header with Editorial Badge and Typography -->
    <header class="flex flex-col items-start gap-4 max-w-3xl mb-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
        یادداشت‌ها و مقالات تخصصی
      </span>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-base-content tracking-tight leading-tight">
        مقالات و یادداشت‌های تخصصی
      </h1>

      <p class="text-base-content/75 text-base sm:text-lg leading-relaxed">
        جستارهایی آرام درباره سلامت روان، روابط عاطفی، طرحواره‌های ذهنی و زیستن آگاهانه‌تر در دنیای پرشتاب امروز.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2" role="tablist" aria-label="دسته‌بندی مقالات">
        <span class="btn btn-sm btn-primary rounded-full px-4 text-xs font-medium cursor-default">
          همه نوشته‌ها
        </span>
        <a href="#relationships" class="btn btn-sm btn-ghost border border-base-300 rounded-full px-4 text-xs font-normal hover:border-primary">
          روابط عاطفی
        </a>
        <a href="#self" class="btn btn-sm btn-ghost border border-base-300 rounded-full px-4 text-xs font-normal hover:border-primary">
          خودشناسی و طرحواره
        </a>
        <a href="#anxiety" class="btn btn-sm btn-ghost border border-base-300 rounded-full px-4 text-xs font-normal hover:border-primary">
          اضطراب و استرس
        </a>
        <a href="#health" class="btn btn-sm btn-ghost border border-base-300 rounded-full px-4 text-xs font-normal hover:border-primary">
          سلامت روان
        </a>
      </div>
    </header>

    <!-- Articles Grid or Empty State -->
    {blogVMs.length === 0 ? (
      <div class="py-8">
        <EmptyState
          title="هنوز مقاله‌ای منتشر نشده است"
          description="به زودی یادداشت‌ها و مطالب آموزشی جدید در این بخش قرار خواهد گرفت."
        >
          <a href="/courses" class="btn btn-primary rounded-full">
            مشاهده دوره‌های آموزشی
          </a>
        </EmptyState>
      </div>
    ) : (
      <section aria-label="لیست مقالات">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {blogVMs.map((vm) => (
            <BlogCard {...vm} />
          ))}
        </div>
      </section>
    )}

    <!-- Consultation Banner Cross-Link -->
    <section class="mt-16 bg-base-200/60 border border-base-300 rounded-2xl p-6 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex flex-col gap-2 max-w-xl">
        <div class="flex items-center gap-2">
          <span class="badge badge-secondary badge-sm text-xs font-semibold">مشاوره حضوری و آنلاین</span>
          <span class="text-xs text-base-content/65">گفت‌وگوی امن و بدون قضاوت</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-base-content">
          نیاز به بررسی تخصصی و گفت‌وگو با درمانگر دارید؟
        </h2>
        <p class="text-sm text-base-content/75 leading-relaxed">
          برای جلسات مشاوره فردی، تنظیم هیجان یا زوج‌درمانی می‌توانید به صورت آنلاین وقت ویزیت خود را هماهنگ کنید.
        </p>
      </div>
      <a href="/booking" class="btn btn-primary rounded-full px-6 font-semibold shrink-0">
        درخواست نوبت مشاوره
      </a>
    </section>
  </div>
</BaseLayout>
