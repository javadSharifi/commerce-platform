---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCard, normalizeBlogSearch, publicBlogCache, readBlogIndex } from '../../lib/blog.js';
import { resolveTemplate } from '../../templates/registry.js';

const site = Astro.locals.site!;
const { BlogCard } = resolveTemplate(site.template_id).components;
const { posts, unavailable } = await readBlogIndex(Astro.request);
const search = Astro.url.searchParams.get('search')?.trim().slice(0, 120) ?? '';
const category = Astro.url.searchParams.get('category')?.trim() ?? '';
const query = normalizeBlogSearch(search);
const categories = [...new Set(posts.flatMap(post => post.category ? [post.category] : []))]
  .sort((a, b) => a.localeCompare(b, 'fa-IR'));
const matches = posts.filter(post => (!category || post.category === category) &&
  (!query || [post.title, post.seo_description, post.category, post.author_name].some(field =>
    field && normalizeBlogSearch(field).includes(query),
  )),
);
const feature = !search && !category ? matches.find(post => post.is_featured) : undefined;
const featured = feature && blogCard(feature);
const cards = matches.filter(post => post !== feature).map(blogCard);

function categoryLink(value: string) {
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (value) params.set('category', value);
  return params.size ? '/blog?' + params : '/blog';
}

Astro.response.headers.set('Cache-Control', Astro.url.search || unavailable ? 'private, no-store' : publicBlogCache);
---

<BaseLayout title={`مقالات و یادداشت‌های تخصصی | ${site.title}`} description={site.description}
  paletteId={site.palette_id} templateId={site.template_id} themeRadius={site.theme_radius} themeScale={site.theme_scale}>
  <header class="bg-base-200/55 px-4 py-12 text-center sm:py-16">
    <h1 class="mb-6 text-3xl font-extrabold leading-tight sm:text-5xl">مقالات و یادداشت‌های تخصصی</h1>
    <form action="/blog" method="get" role="search" class="mx-auto flex max-w-xl items-center gap-2">
      <label for="blog-search" class="sr-only">جست‌وجو در مقالات</label>
      <input id="blog-search" type="search" name="search" value={search} maxlength="120"
        class="input input-bordered min-w-0 flex-1 rounded-full" placeholder="عنوان یا موضوع مقاله" />
      {category && <input type="hidden" name="category" value={category} />}
      <button class="btn btn-primary rounded-full" type="submit">جست‌وجو</button>
    </form>
  </header>

  <div class="mx-auto max-w-7xl space-y-10 px-4 py-10 sm:px-6 lg:px-8">
    {(categories.length > 0 || category) && (
      <nav aria-label="دسته‌بندی مقالات" class="flex flex-wrap gap-2">
        <a href={categoryLink('')} aria-current={!category ? 'true' : undefined}
          class:list={['btn btn-sm rounded-full', category ? 'btn-outline' : 'btn-primary']}>همه نوشته‌ها</a>
        {categories.map(value => (
          <a href={categoryLink(value)} aria-current={category === value ? 'true' : undefined}
            class:list={['btn btn-sm rounded-full', category === value ? 'btn-primary' : 'btn-outline']}>{value}</a>
        ))}
      </nav>
    )}
    {unavailable ? (
      <p class="alert alert-warning" role="status">نمایش مقالات موقتاً در دسترس نیست.</p>
    ) : matches.length === 0 && (
      <div class="rounded-2xl bg-base-200 p-8 text-center">
        <p>{search || category ? 'مقاله‌ای با این جست‌وجو پیدا نشد.' : 'هنوز مقاله‌ای منتشر نشده است.'}</p>
        <a class="btn btn-outline btn-sm mt-4 rounded-full" href={search || category ? '/blog' : '/courses'}>
          {search || category ? 'مشاهده همه نوشته‌ها' : 'مشاهده دوره‌های آموزشی'}
        </a>
      </div>
    )}

    {featured && (
      <section id="featured-article" class="card bg-base-100 grid overflow-hidden rounded-3xl border border-base-300 sm:grid-cols-2">
        {featured.coverUrl ? (
          <img src={featured.coverUrl} alt="" class="aspect-video h-full w-full bg-base-200 object-cover" />
        ) : (
          <div aria-hidden="true" class="aspect-video w-full bg-base-200"></div>
        )}
        <div class="flex flex-col items-start justify-center gap-4 p-6 sm:p-9">
          <span class="badge badge-secondary badge-outline">مقالهٔ ویژه</span>
          <h2 class="text-2xl font-bold sm:text-3xl">
            <a class="hover:text-primary focus-visible:ring-2 focus-visible:ring-primary" href={`/blog/${featured.slug}`}>{featured.title}</a>
          </h2>
          {featured.excerpt && <p class="text-base-content/75">{featured.excerpt}</p>}
          {feature?.author_name && <p class="text-sm text-base-content/70">{feature.author_name}</p>}
        </div>
      </section>
    )}

    {cards.length > 0 && (
      <section aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="mb-5 text-2xl font-bold">{search || category ? 'نتایج جست‌وجو' : 'مقالات'}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map(card => <BlogCard {...card} />)}
        </div>
      </section>
    )}
    <a href="/booking" class="btn btn-outline rounded-full">درخواست نوبت مشاوره</a>
  </div>
</BaseLayout>
