---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublicSite } from '../../lib/site.js';
import type { ContentBlock } from '@psychology/api-client';

// Edge CDN caching: published public blog post
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=60');

const { slug } = Astro.params;
const site = await fetchPublicSite(Astro.request);
const host = Astro.request.headers.get('host') || 'localhost:3000';
const apiBase = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';

// Fallback sample post for local dev/preview
const fallbackPost = {
  id: 'b1111111-1111-1111-1111-111111111111',
  title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
  slug: 'self-awareness-and-emotional-regulation',
  seo_description: 'بررسی راهکارهای علمی و روان‌شناختی جهت تقویت خودآگاهی و بهبود مهارت‌های ارتباطی در زندگی روزمره.',
  published_at: '2026-11-15T10:00:00Z',
  content_blocks: [
    {
      type: 'heading',
      data: { level: 2, text: 'مقدمه‌ای بر هوش هیجانی و ارتباط سالم' },
    },
    {
      type: 'paragraph',
      data: {
        text: 'روابط بین‌فردی ستون فقرات کیفیت زندگی روانی انسان‌ها را تشکیل می‌دهند. پژوهش‌های متعدد نشان می‌دهند که توانایی درک و نام‌گذاری هیجانات خود (Emotional Granularity)، اولین گام در تنظیم پاسخ‌های هیجانی و جلوگیری از واکنش‌های تکانشگرانه در گفت‌وگوهای حساس است.',
      },
    },
    {
      type: 'heading',
      data: { level: 3, text: 'شنیدن پادکست آموزشی مرتبط' },
    },
    {
      type: 'audio',
      data: {
        media_id: 'm1111111-1111-1111-1111-111111111111',
        caption: 'فایل صوتی بررسی تکنیک‌های ذهن‌آگاهی و تنظیم هیجان',
        url: 'https://mock-storage.local/audio/emotion_regulation.mp3',
      },
    },
    {
      type: 'paragraph',
      data: {
        text: 'در موقعیت‌های تعارض، ایجاد یک مکث کوتاه ۳ تا ۵ ثانیه‌ای پیش از پاسخ دادن، به قشر پیش‌پیشانی مغز اجازه می‌دهد تا به ارزیابی منطقی موقعیت پرداخته و از غلبه واکنش‌های واکنشی آمیگدال جلوگیری کند.',
      },
    },
    {
      type: 'heading',
      data: { level: 3, text: 'مشاهده ویدئوی تشریح مدل هیجانی' },
    },
    {
      type: 'video',
      data: {
        media_id: 'm2222222-2222-2222-2222-222222222222',
        caption: 'ویدئوی تشریحی مکانیزم‌های عصبی هیجان در تعاملات اجتماعی',
        url: 'https://mock-storage.local/video/neurobiology_emotion.mp4',
      },
    },
  ] as ContentBlock[],
};

let post = fallbackPost;
let notFound = false;

try {
  const res = await fetch(`${apiBase}/public/blog/${encodeURIComponent(slug || '')}`, {
    headers: { Host: host },
    signal: AbortSignal.timeout(1000),
  });

  if (res.ok) {
    post = await res.json();
  } else if (slug !== fallbackPost.slug) {
    notFound = true;
  }
} catch {
  // If API unreachable and not matching fallback slug, treat as not found
  if (slug !== fallbackPost.slug) {
    notFound = true;
  }
}

if (notFound) {
  return new Response('مطلب مورد نظر یافت نشد.', { status: 404, statusText: 'Not Found' });
}

// Resolve streaming URLs for audio and video blocks that have media_id
const resolvedBlocks: { type: string; data: Record<string, any> }[] = await Promise.all(
  (post.content_blocks || []).map(async (block) => {
    const data: Record<string, any> = { ...(block.data || {}) };
    if ((block.type === 'audio' || block.type === 'video') && data.media_id) {
      try {
        const streamRes = await fetch(`${apiBase}/public/media/${data.media_id}/stream-url`, {
          headers: { Host: host },
          signal: AbortSignal.timeout(800),
        });
        if (streamRes.ok) {
          const streamData = await streamRes.json();
          data.stream_url = streamData.stream_url;
        }
      } catch {
        // Fallback to static mock url if present
      }
    }
    return { type: block.type, data };
  })
);

function formatDatePersian(dateStr?: string | null) {
  if (!dateStr) return '';
  try {
    return new Intl.DateTimeFormat('fa-IR', {
      dateStyle: 'medium',
      timeZone: 'Asia/Tehran',
    }).format(new Date(dateStr));
  } catch {
    return dateStr;
  }
}
---

<BaseLayout
  title={`${post.title} | ${site.title}`}
  description={post.seo_description}
  primaryColor={site.primary_color}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <article class="card bg-base-100 border border-base-200 rounded-box p-6 sm:p-10 shadow-xs">
      <header class="mb-8 border-b border-base-200 pb-6">
        <div class="flex justify-between items-center mb-3 text-xs text-base-content/60">
          <span>📅 تاریخ انتشار: {formatDatePersian(post.published_at)}</span>
          <a href="/blog" class="text-primary hover:underline inline-flex items-center gap-1 font-medium">
            <span>&larr;</span> بازگشت به فهرست مقالات
          </a>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content leading-tight mb-4">
          {post.title}
        </h1>
        {post.seo_description && (
          <p class="text-sm sm:text-base text-base-content/80 leading-relaxed bg-base-200/50 p-4 rounded-box border-s-4 border-primary">
            {post.seo_description}
          </p>
        )}
      </header>

      <div class="flex flex-col gap-5 text-base-content leading-relaxed text-sm sm:text-base">
        {resolvedBlocks.map((block) => {
          const data = block.data;

          if (block.type === 'paragraph') {
            return (
              <p class="whitespace-pre-line text-base-content/90 leading-relaxed">
                {data.text}
              </p>
            );
          }

          if (block.type === 'heading') {
            const level = Number(data.level) || 2;
            if (level === 2) {
              return (
                <h2 class="text-xl sm:text-2xl font-bold text-base-content mt-6 mb-2 border-b border-base-200 pb-2">
                  {data.text}
                </h2>
              );
            }
            if (level === 3) {
              return (
                <h3 class="text-lg sm:text-xl font-bold text-base-content mt-4 mb-1">
                  {data.text}
                </h3>
              );
            }
            return (
              <h4 class="text-base font-semibold text-base-content mt-3 mb-1">
                {data.text}
              </h4>
            );
          }

          if (block.type === 'image') {
            const imgSrc = (data.stream_url || data.url) as string;
            const caption = (data.caption as string) || '';
            return (
              <figure class="my-6 text-center">
                <img
                  src={imgSrc}
                  alt={caption || post.title}
                  loading="lazy"
                  class="max-w-full h-auto rounded-box border border-base-200 mx-auto"
                />
                {caption && (
                  <figcaption class="text-xs text-base-content/60 mt-2">
                    {caption}
                  </figcaption>
                )}
              </figure>
            );
          }

          if (block.type === 'audio') {
            const audioSrc = (data.stream_url || data.url) as string;
            const caption = (data.caption as string) || '';
            return (
              <div class="bg-base-200/50 border border-base-200 rounded-box p-4 my-4">
                {caption && (
                  <div class="text-sm font-semibold text-base-content mb-2 flex items-center gap-2">
                    <span>🎧</span>
                    <span>{caption}</span>
                  </div>
                )}
                <audio
                  controls
                  preload="metadata"
                  class="w-full rounded-btn"
                >
                  <source src={audioSrc} type="audio/mpeg" />
                  مرورگر شما از پخش مستقیم صوت پشتیبانی نمی‌کند.
                </audio>
              </div>
            );
          }

          if (block.type === 'video') {
            const videoSrc = (data.stream_url || data.url) as string;
            const caption = (data.caption as string) || '';
            return (
              <div class="bg-base-300 rounded-box p-3 my-4">
                <video
                  controls
                  preload="metadata"
                  playsinline
                  class="w-full max-h-96 rounded-box bg-black"
                >
                  <source src={videoSrc} type="video/mp4" />
                  مرورگر شما از پخش مستقیم ویدئو پشتیبانی نمی‌کند.
                </video>
                {caption && (
                  <div class="text-xs text-base-content/70 text-center mt-2">
                    {caption}
                  </div>
                )}
              </div>
            );
          }

          return null;
        })}
      </div>
    </article>
  </div>
</BaseLayout>
