---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogBlocks, blogCard, publicBlogCache, readBlogIndex, readBlogPost } from '../../lib/blog.js';
import { formatDate, publicImagePath } from '../../lib/home.js';
import { resolveTemplate } from '../../templates/registry.js';

const { slug } = Astro.params;
const site = Astro.locals.site!;
const { BlogCard } = resolveTemplate(site.template_id).components;
const result = await readBlogPost(Astro.request, slug ?? '');
if (!result.post) {
  const unavailable = result.status === 503;
  return new Response(unavailable ? 'نمایش مقاله موقتاً در دسترس نیست.' : 'مطلب مورد نظر یافت نشد.', {
    status: result.status, headers: { 'Cache-Control': 'private, no-store', 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const post = result.post;
const cover = publicImagePath(post.cover_media_id);
const date = formatDate(post.published_at);
const [{ blocks, hasStreams }, related] = await Promise.all([
  blogBlocks(Astro.request, post.content_blocks),
  post.category ? readBlogIndex(Astro.request) : { posts: [], unavailable: false },
]);
const relatedCards = related.posts.filter(item => item.category === post.category && item.slug !== post.slug)
  .slice(0, 3).map(blogCard);
Astro.response.headers.set('Cache-Control', hasStreams || related.unavailable ? 'private, no-store' : publicBlogCache);
---

<BaseLayout title={`${post.title} | ${site.title}`} description={post.seo_description}
  paletteId={site.palette_id} templateId={site.template_id} themeRadius={site.theme_radius} themeScale={site.theme_scale}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <nav aria-label="مسیر راهنما" class="mb-6">
      <a href="/blog" class="rounded-sm text-sm text-base-content/70 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary">
        <span aria-hidden="true">→</span> بازگشت به فهرست مقالات
      </a>
    </nav>

    <article class="card bg-base-100 rounded-3xl border border-base-200 p-5 sm:p-10">
      <header class="mx-auto mb-7 w-full max-w-3xl space-y-4">
        {post.category && (
          <a href={`/blog?category=${encodeURIComponent(post.category)}`}
            class="badge badge-primary badge-outline focus-visible:ring-2 focus-visible:ring-primary">{post.category}</a>
        )}
        <h1 class="text-3xl font-extrabold leading-tight sm:text-5xl">{post.title}</h1>
        {(post.author_name || date) && (
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/70">
            {post.author_name && <span>{post.author_name}</span>}
            {date && <time datetime={post.published_at ?? undefined}>{date}</time>}
          </div>
        )}
        {post.seo_description && <p class="text-base leading-relaxed text-base-content/80">{post.seo_description}</p>}
      </header>

      {cover ? (
        <img src={cover} alt="" class="mb-9 aspect-video max-h-[26rem] w-full rounded-2xl bg-base-200 object-cover" />
      ) : (
        <div data-blog-cover-placeholder aria-hidden="true" class="mb-9 aspect-video max-h-[26rem] w-full rounded-2xl bg-base-200"></div>
      )}

      <div class="mx-auto w-full max-w-3xl space-y-6 text-base leading-loose">
        {blocks.map(block => {
          const { type, text, level, src, caption } = block;
          if (type === 'paragraph') return <p class="whitespace-pre-line">{text}</p>;
          if (type === 'heading') {
            const Heading = level === 3 ? 'h3' : level >= 4 ? 'h4' : 'h2';
            return <Heading class="pt-3 text-xl font-bold sm:text-2xl">{text}</Heading>;
          }
          if (type === 'image') return (
            <figure>
              <img src={src} alt={caption || ''} loading="lazy" class="mx-auto max-w-full rounded-xl" />
              {caption && <figcaption class="mt-2 text-center text-sm text-base-content/65">{caption}</figcaption>}
            </figure>
          );
          if (type === 'audio') return (
            <figure class="rounded-xl bg-base-200/50 p-4">
              {caption && <figcaption class="mb-2 text-sm">{caption}</figcaption>}
              <audio controls preload="none" src={src} class="w-full"></audio>
            </figure>
          );
          return (
            <figure class="rounded-xl bg-base-200/50 p-4">
              <video controls playsinline preload="none" src={src} class="max-h-96 w-full rounded-lg"></video>
              {caption && <figcaption class="mt-2 text-sm">{caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    </article>

    {relatedCards.length > 0 && (
      <section class="mt-10" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading" class="mb-5 text-2xl font-bold">مطالب مرتبط</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCards.map(card => <BlogCard {...card} />)}
        </div>
      </section>
    )}
    <a href="/booking" class="btn btn-outline mt-8 rounded-full">درخواست نوبت مشاوره</a>
  </div>
</BaseLayout>
