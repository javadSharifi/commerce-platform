---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicSiteClient } from '../../lib/site.js';
import BookingFlow from '../../components/BookingFlow';
import type { PublicAppointmentSlot, PublicTherapistItem } from '@psychology/api-client';
import { tehranDay } from '../../lib/booking-date.js';

const site = Astro.locals.site!;
const api = publicSiteClient(Astro.request);
const today = tehranDay(new Date());
let therapists: PublicTherapistItem[] = [];
let initialSlots: PublicAppointmentSlot[] = [];
let directoryUnavailable = !api;
let slotsUnavailable = false;
if (api) {
  try {
    therapists = await api.listPublicTherapists();
    if (!Array.isArray(therapists)) throw new Error('Unexpected therapist list');
  } catch (err) {
    console.error('Public therapist list unavailable', err instanceof Error ? err.name : 'UnknownError');
    therapists = [];
    directoryUnavailable = true;
  }
  if (therapists[0]) {
    try {
      initialSlots = await api.listPublicTherapistSlots(encodeURIComponent(therapists[0].id), today);
      if (!Array.isArray(initialSlots)) throw new Error('Unexpected slot list');
    } catch (err) {
      console.error('Public appointment slots unavailable', err instanceof Error ? err.name : 'UnknownError');
      initialSlots = [];
      slotsUnavailable = true;
    }
  }
}
const firstSlot = initialSlots.find(slot => slot.therapist_id === therapists[0]?.id &&
  slot.status === 'available' && Date.parse(slot.starts_at) > Date.now());
const date = firstSlot ? tehranDay(new Date(firstSlot.starts_at)) : today;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout
  title={`رزرو نوبت مشاوره حضوری | ${site.title}`}
  description="انتخاب درمانگر و سانس حضوری و پیگیری خصوصی درخواست نوبت"
  paletteId={site.palette_id} templateId={site.template_id} themeRadius={site.theme_radius} themeScale={site.theme_scale}
>
  <header class="bg-base-200/55 px-4 py-12 text-center sm:py-16">
    <p class="mb-3 text-sm font-semibold text-primary">رزرو وقت مشاوره • محرمانه و مطمئن</p>
    <h1 class="mx-auto max-w-4xl text-3xl font-extrabold leading-tight sm:text-5xl">درخواست نوبت مشاوره و روان‌درمانی</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-base-content/75 sm:text-base">
      درمانگر و زمان جلسهٔ حضوری را انتخاب کنید. پذیرش برای تأیید درخواست با شما تماس می‌گیرد.
    </p>
  </header>
  <div class="mx-auto w-full max-w-5xl overflow-x-hidden px-4 py-8 sm:px-6 lg:max-w-7xl lg:px-8">
    {directoryUnavailable ? (
      <p class="alert alert-warning" role="status">دریافت فهرست درمانگران موقتاً ممکن نیست.</p>
    ) : therapists.length === 0 ? (
      <p class="rounded-2xl bg-base-200 p-8 text-center">در حال حاضر درمانگری برای رزرو حضوری معرفی نشده است.</p>
    ) : (
      <BookingFlow client:visible therapists={therapists} initialSlots={initialSlots} initialDate={date}
        today={today} initialSlotsUnavailable={slotsUnavailable} clinicAddress={site.address}
        clinicPhone={site.phone} officeHours={site.home_profile?.office_hours} />
    )}
  </div>
</BaseLayout>
