---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePageContent from '../components/HomePageContent.astro';
import { fetchPublicSite } from '../lib/site.js';
import { getHomeContent } from '../lib/home.js';

// Fetch published tenant settings for the current Host
const site = Astro.locals.site || (await fetchPublicSite(Astro.request));
const content = await getHomeContent(Astro.request);
Astro.response.headers.set('Cache-Control', content.unavailable
  ? 'no-store'
  : 'public, max-age=0, s-maxage=3600, stale-while-revalidate=60');
---

<BaseLayout
  title={site.title}
  description={site.description}
  paletteId={site.palette_id}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <HomePageContent site={site} templateId={site.template_id} {...content} />
</BaseLayout>
