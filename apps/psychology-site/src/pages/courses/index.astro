---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublicSite } from '../../lib/site.js';
import { resolveTemplate } from '../../templates/registry.js';
import type { CourseCardVM } from '../../templates/view-models.js';
import { EmptyState } from '@psychology/ui';

// Edge CDN caching: public courses listing
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=60');

const site = await fetchPublicSite(Astro.request);
const activeTemplate = resolveTemplate(site.template_id);
const CourseCard = activeTemplate.components.CourseCard;

// Fallback demo courses for SSR preview
const fallbackCourses = [
  {
    id: 'c-demo-1',
    title: 'دوره جامع مدیریت استرس و اضطراب فراگیر',
    slug: 'anxiety-management',
    description: 'راهنمای کاربردی و گام‌به‌گام برای شناسایی، مدیریت و کاهش اضطراب و استرس‌های روزمره با تکنیک‌های شناختی-رفتاری.',
    instructor_name: 'دکتر مریم علوی',
    price_rials: 12500000,
    status: 'published',
    lessons_count: 8,
    cover_url: null,
  },
  {
    id: 'c-demo-2',
    title: 'دوره مهارت‌های ارتباط موثر و حل تعارض',
    slug: 'communication-skills',
    description: 'آموزش اصول گفتگوی سازنده، همدلی فعال و الگوهای پایدار در روابط فردی، شغلی و عاطفی.',
    instructor_name: 'دکتر مریم علوی',
    price_rials: 9800000,
    status: 'published',
    lessons_count: 6,
    cover_url: null,
  },
];

let courses = fallbackCourses;

const apiBase = import.meta.env.INTERNAL_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
try {
  const host = Astro.request.headers.get('host') || 'localhost:3000';
  const res = await fetch(`${apiBase}/public/courses`, {
    headers: { Host: host },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data) && data.length > 0) {
      courses = data;
    }
  }
} catch {
  // Graceful fallback to demo data
}

function formatPriceTomans(rials: number): string {
  if (rials <= 0) return 'رایگان';
  const tomans = Math.floor(rials / 10);
  return tomans.toLocaleString('fa-IR') + ' تومان';
}

const courseVMs: CourseCardVM[] = courses.map((c) => ({
  id: c.id,
  slug: c.slug,
  title: c.title,
  instructorName: c.instructor_name || site.title,
  priceLabel: formatPriceTomans(c.price_rials),
  lessonsCountLabel: c.lessons_count ? `${c.lessons_count.toLocaleString('fa-IR')} جلسه` : undefined,
  coverUrl: c.cover_url || null,
}));
---

<BaseLayout
  title={`دوره‌های آموزشی تخصصی | ${site.title}`}
  description="دوره‌های تخصصی ضبط‌شده روان‌شناسی با تدریس اساتید و روان‌درمانگران مجرب"
  primaryColor={site.primary_color}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-start sm:text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content mb-3">
        دوره‌های آموزشی تخصصی
      </h1>
      <p class="text-base-content/70 text-base max-w-2xl mx-auto">
        ویدئوها و جلسات آموزشی ضبط‌شده با دسترسی دائمی، سرفصل‌های علمی و گارانتی بازگشت وجه.
      </p>
    </div>

    {courseVMs.length === 0 ? (
      <EmptyState
        title="در حال حاضر دوره‌ای منتشر نشده است"
        description="به زودی دوره‌های آموزشی جدید در این بخش قرار خواهند گرفت."
      >
        <a href="/workshops" class="btn btn-primary">
          مشاهده کارگاه‌های حضوری و آنلاین
        </a>
      </EmptyState>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {courseVMs.map((vm) => (
          <CourseCard {...vm} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
