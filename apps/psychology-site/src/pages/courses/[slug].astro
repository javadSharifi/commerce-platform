---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublicSite, getApiBaseUrl } from '../../lib/site.js';

// Edge CDN caching: published public course detail
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=60');

const { slug } = Astro.params;
const site = await fetchPublicSite(Astro.request);

// Fallback demo course for SSR preview
const fallbackCourse = {
  id: 'c-demo-1',
  title: 'دوره جامع مدیریت استرس و اضطراب فراگیر',
  slug: 'anxiety-management',
  description: 'در این دوره تخصصی، به صورت کاربردی و گام‌به‌گام با ریشه‌های روانی و فیزیولوژیک استرس آشنا شده و تکنیک‌های استاندارد درمان شناختی رفتاری (CBT) و ذهن‌آگاهی را برای مدیریت موقعیت‌های تنش‌زا فرا می‌گیرید.',
  instructor_name: 'دکتر مریم علوی',
  price_rials: 12500000,
  status: 'published',
  cover_url: null,
  lessons: [
    {
      id: 'l-demo-1',
      title: 'جلسه اول: آشنایی با مکانیسم زیستی استرس و تمایز آن با اضطراب',
      description: 'بررسی محور HPA و پاسخ جنگ یا گریز و نشانه‌های بالینی.',
      display_order: 1,
      duration_seconds: 1800,
      is_free_preview: true,
    },
    {
      id: 'l-demo-2',
      title: 'جلسه دوم: شناسایی خطاهای شناختی و افکار خودکار منفی',
      description: 'فنون ثبت روزانه افکار و به چالش کشیدن سوگیری‌های فکری.',
      display_order: 2,
      duration_seconds: 2400,
      is_free_preview: false,
    },
    {
      id: 'l-demo-3',
      title: 'جلسه سوم: تکنیک‌های آرام‌سازی عضلانی پیشرونده و تنفس دیافراگمی',
      description: 'تمرین‌های عملی هدایت‌شده برای فعال‌سازی سیستم پاراسمپاتیک.',
      display_order: 3,
      duration_seconds: 2100,
      is_free_preview: false,
    },
  ],
};

let course = fallbackCourse;
let notFound = false;

const apiBase = getApiBaseUrl() || 'http://localhost:8080';
try {
  const host = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host') || 'localhost:3000';
  const res = await fetch(`${apiBase}/v1/public/courses/${encodeURIComponent(slug || '')}`, {
    headers: { Host: host, 'X-Forwarded-Host': host },
    signal: AbortSignal.timeout(1000),
  });
  if (res.ok) {
    const data = await res.json();
    if (data && data.title && (data.lessons !== undefined || data.lessons_count !== undefined || data.price_rials !== undefined || data.price !== undefined)) {
      course = data;
    } else if (slug !== 'anxiety-management') {
      notFound = true;
    }
  } else if (slug !== 'anxiety-management') {
    notFound = true;
  }
} catch {
  // Graceful fallback to demo data if slug matches fallback
  if (slug !== 'anxiety-management') {
    notFound = true;
  }
}

if (notFound) {
  return new Response('دوره آموزشی مورد نظر یافت نشد.', { status: 404, statusText: 'Not Found' });
}

// Regression support: course archived status can be queried or simulated
const isArchived = course.status === 'archived' || Astro.url.searchParams.get('status') === 'archived';
const lessons = Array.isArray(course?.lessons) ? course.lessons : [];

function formatPriceTomans(rials: number): string {
  if (rials <= 0) return 'رایگان';
  const tomans = Math.floor(rials / 10);
  return tomans.toLocaleString('fa-IR') + ' تومان';
}

function formatDuration(seconds: number): string {
  const mins = Math.round(seconds / 60);
  return `${mins.toLocaleString('fa-IR')} دقیقه`;
}

function formatTotalDuration(items: { duration_seconds?: number }[]): string {
  const totalSec = items.reduce((acc, l) => acc + (l.duration_seconds || 0), 0);
  const totalMins = Math.round(totalSec / 60);
  if (totalMins < 60) return `${totalMins.toLocaleString('fa-IR')} دقیقه`;
  const hours = Math.floor(totalMins / 60);
  const remainingMins = totalMins % 60;
  return remainingMins > 0
    ? `${hours.toLocaleString('fa-IR')} ساعت و ${remainingMins.toLocaleString('fa-IR')} دقیقه`
    : `${hours.toLocaleString('fa-IR')} ساعت`;
}
---

<BaseLayout
  title={`${course.title} | ${site.title}`}
  description={course.description}
  paletteId={site.palette_id}
  templateId={site.template_id}
  themeRadius={site.theme_radius}
  themeScale={site.theme_scale}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb / Back Link -->
    <nav aria-label="مسیر راهنما" class="mb-6">
      <a
        href="/courses"
        class="text-sm text-base-content/70 hover:text-primary transition-colors inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
      >
        <span aria-hidden="true">&rarr;</span>
        <span>بازگشت به لیست دوره‌ها</span>
      </a>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Main Content (8 cols) -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-8">
        <!-- Hero Information Block -->
        <section class="card bg-base-100 border border-base-200 p-6 sm:p-8 rounded-2xl shadow-xs">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="badge badge-primary badge-outline text-xs font-semibold">
              دوره آموزشی ضبط‌شده
            </span>
            {isArchived ? (
              <span class="badge badge-warning text-xs font-semibold">
                دورهٔ آرشیوشده
              </span>
            ) : (
              <span class="badge badge-secondary badge-outline text-xs font-semibold">
                دسترسی مادام‌العمر
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-base-content mb-4 leading-tight">
            {course.title}
          </h1>

          <div class="text-sm text-base-content/75 mb-5 flex items-center gap-2">
            <span>مدرس و روان‌درمانگر:</span>
            <strong class="text-base-content font-bold">{course.instructor_name || site.title}</strong>
          </div>

          <p class="text-base text-base-content/85 leading-relaxed whitespace-pre-line">
            {course.description}
          </p>

          <!-- Key Metrics Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 mt-6 border-t border-base-200 text-center sm:text-start">
            <div class="bg-base-200/50 rounded-xl p-3 border border-base-200/70">
              <span class="text-base font-bold text-base-content block">{lessons.length.toLocaleString('fa-IR')} جلسه</span>
              <span class="text-xs text-base-content/65">تعداد جلسات</span>
            </div>
            <div class="bg-base-200/50 rounded-xl p-3 border border-base-200/70">
              <span class="text-base font-bold text-base-content block">{formatTotalDuration(lessons)}</span>
              <span class="text-xs text-base-content/65">مدت کل دوره</span>
            </div>
            <div class="bg-base-200/50 rounded-xl p-3 border border-base-200/70">
              <span class="text-base font-bold text-primary block">دائمی</span>
              <span class="text-xs text-base-content/65">مدت دسترسی</span>
            </div>
            <div class="bg-base-200/50 rounded-xl p-3 border border-base-200/70">
              <span class="text-base font-bold text-success block">۷ روزه</span>
              <span class="text-xs text-base-content/65">ضمانت بازگشت</span>
            </div>
          </div>
        </section>

        <!-- Learning Outcomes -->
        <section class="card bg-base-200/40 border border-base-200 p-6 sm:p-8 rounded-2xl shadow-xs">
          <h2 class="text-lg sm:text-xl font-bold text-base-content mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            در این دوره چه مهارت‌هایی می‌آموزید؟
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-base-content/85">
            <li class="flex items-start gap-2.5 bg-base-100 p-3.5 rounded-xl border border-base-200/60">
              <span class="text-primary font-bold text-base mt-0.5">✓</span>
              <span>شناسایی ریشه‌های روان‌شناختی و فیزیولوژیک اضطراب و استرس مزمن</span>
            </li>
            <li class="flex items-start gap-2.5 bg-base-100 p-3.5 rounded-xl border border-base-200/60">
              <span class="text-primary font-bold text-base mt-0.5">✓</span>
              <span>تکنیک‌های آرام‌سازی تنفسی، فعال‌سازی عصب واگ و تخلیه تنش‌های جسمانی</span>
            </li>
            <li class="flex items-start gap-2.5 bg-base-100 p-3.5 rounded-xl border border-base-200/60">
              <span class="text-primary font-bold text-base mt-0.5">✓</span>
              <span>به چالش کشیدن افکار منفی خودکار و خطاهای شناختی با رویکرد CBT</span>
            </li>
            <li class="flex items-start gap-2.5 bg-base-100 p-3.5 rounded-xl border border-base-200/60">
              <span class="text-primary font-bold text-base mt-0.5">✓</span>
              <span>طراحی برنامه روزانه مراقبت از خود و تاب‌آوری در برابر بحران‌های عاطفی</span>
            </li>
          </ul>
        </section>

        <!-- Syllabus / Lessons Accordion -->
        <section class="card bg-base-100 border border-base-200 p-6 sm:p-8 rounded-2xl shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
            <h2 class="text-lg sm:text-xl font-bold text-base-content">
              سرفصل‌ها و جلسات دوره ({lessons.length.toLocaleString('fa-IR')} جلسه)
            </h2>
            <span class="text-xs text-base-content/65">
              مجموع آموزش: {formatTotalDuration(lessons)}
            </span>
          </div>

          <div class="flex flex-col gap-3">
            {lessons.map((lesson) => (
              <details class="group bg-base-100 border border-base-200 rounded-xl overflow-hidden shadow-2xs open:border-primary/40 transition-colors">
                <summary class="p-4 flex justify-between items-center cursor-pointer select-none list-none hover:bg-base-200/50 transition-colors">
                  <div class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-base-200 text-base-content font-bold text-xs flex items-center justify-center shrink-0 group-open:bg-primary group-open:text-primary-content transition-colors">
                      {lesson.display_order.toLocaleString('fa-IR')}
                    </span>
                    <div>
                      <h3 class="text-sm sm:text-base font-semibold text-base-content mb-0.5">
                        {lesson.title}
                      </h3>
                      {lesson.description && (
                        <p class="text-xs text-base-content/70 hidden sm:block line-clamp-1">{lesson.description}</p>
                      )}
                    </div>
                  </div>

                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-xs text-base-content/65">
                      {formatDuration(lesson.duration_seconds)}
                    </span>
                    {lesson.is_free_preview ? (
                      <span class="badge badge-success badge-sm text-xs">
                        پیش‌نمایش رایگان
                      </span>
                    ) : (
                      <span class="badge badge-ghost badge-sm text-xs border border-base-300">
                        🔒 قفل
                      </span>
                    )}
                    <span class="text-xs text-base-content/50 group-open:rotate-180 transition-transform duration-200" aria-hidden="true">
                      ▼
                    </span>
                  </div>
                </summary>

                {lesson.description && (
                  <div class="p-4 pt-3 text-xs sm:text-sm text-base-content/80 border-t border-base-200 bg-base-200/25 leading-relaxed">
                    {lesson.description}
                  </div>
                )}
              </details>
            ))}
          </div>
        </section>

        <!-- Instructor Bio Strip -->
        <section class="card bg-base-100 border border-base-200 p-6 rounded-2xl shadow-xs flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-primary/10 text-primary font-bold text-xl flex items-center justify-center shrink-0 border border-primary/20">
            {course.instructor_name ? course.instructor_name.charAt(0) : 'د'}
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold text-primary">مدرس و هدایت‌کننده دوره</span>
            <h3 class="text-base sm:text-lg font-bold text-base-content">{course.instructor_name || site.title}</h3>
            <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
              روان‌شناس و درمانگر بالینی، عضو سازمان نظام روانشناسی و مشاوره با سال‌ها تجربه در درمان‌های فردی، گروهی و برگزاری دوره‌های خودشناسی.
            </p>
          </div>
        </section>

        <!-- Student Reviews Social Proof -->
        <section class="card bg-base-200/40 border border-base-200 p-6 sm:p-8 rounded-2xl shadow-xs flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-bold text-base-content">تجربه و دیدگاه شرکت‌کنندگان</h2>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-primary">
              <span>★ ۴.۹ از ۵</span>
              <span class="text-base-content/60 font-normal">(۸۴ نظر ثبت‌شده)</span>
            </div>
          </div>
          <blockquote class="bg-base-100 border border-base-200 p-4 rounded-xl text-xs sm:text-sm text-base-content/80 leading-relaxed italic">
            «بیان شیوا و تمرین‌های مرحله‌به‌مرحله این دوره کمک کرد که در لحظات بحران و تنش ذهنی، کنترل تنفس و افکارم را بازیابی کنم. یکی از بهترین دوره‌های کاربردی روانشناسی بود.»
            <footer class="mt-2 text-xs font-semibold text-base-content/65 not-italic">— بازخورد ثبت‌شده دانشجو</footer>
          </blockquote>
        </section>
      </div>

      <!-- Sticky Checkout Sidebar (4 cols) -->
      <aside class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24">
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-6 sm:p-7 shadow-sm">
          <div class="mb-5 pb-5 border-b border-base-200">
            <span class="text-xs text-base-content/70 block mb-1">
              شهریه ثبت‌نام و دسترسی دائمی:
            </span>
            <div class="text-3xl font-black text-primary tracking-tight">
              {formatPriceTomans(course.price_rials)}
            </div>
            <span class="text-xs text-base-content/60 block mt-1">
              مبلغ بر حسب ریال: {course.price_rials.toLocaleString('fa-IR')} ریال
            </span>
          </div>

          {isArchived ? (
            <div class="flex flex-col gap-3 py-2">
              <div class="alert alert-warning text-xs font-semibold leading-relaxed">
                این دوره به پایان رسیده و هم‌اکنون در وضعیت آرشیو قرار دارد. ثبت‌نام جدید در این دوره امکان‌پذیر نیست.
              </div>
              <button disabled class="btn btn-disabled w-full text-sm font-bold rounded-full">
                دوره در وضعیت آرشیو است
              </button>
              <a href="/courses" class="btn btn-outline btn-sm rounded-full text-xs text-center mt-2">
                مشاهده سایر دوره‌های فعال
              </a>
            </div>
          ) : (
            <div id="checkout-root" data-slug={course.slug} data-price-rials={course.price_rials}>
              <div id="checkout-auth-checking" class="text-center text-base-content/60 text-xs py-4">
                در حال بررسی وضعیت کاربری...
              </div>

              <div id="checkout-authed" class="hidden">
                <div class="alert alert-success text-xs py-2 mb-4">
                  ورود با حساب: <strong id="buyer-phone-display"></strong>
                </div>
                <button id="btn-start-checkout" class="btn btn-primary w-full text-sm font-bold rounded-full">
                  خرید و ثبت‌نام در دوره
                </button>
              </div>

              <div id="checkout-unauthed" class="hidden">
                <p class="text-xs text-base-content/80 mb-3">
                  برای خرید دوره و فعال‌سازی دسترسی، شماره موبایل خود را وارد نمایید:
                </p>
                <div id="otp-step-phone">
                  <div class="mb-3">
                    <label class="label-text text-xs font-semibold text-base-content block mb-1">
                      شماره موبایل
                    </label>
                    <input
                      type="tel"
                      id="buyer-phone-input"
                      placeholder="۰۹۱۲۳۴۵۶۷۸۹"
                      dir="ltr"
                      class="input input-bordered w-full text-base-content bg-base-100 text-sm rounded-xl"
                    />
                  </div>
                  <button id="btn-send-otp" class="btn btn-primary w-full btn-sm rounded-full">
                    دریافت کد تأیید ورود
                  </button>
                </div>

                <div id="otp-step-verify" class="hidden">
                  <div class="mb-3">
                    <label class="label-text text-xs font-semibold text-base-content block mb-1">
                      کد ۵ رقمی ارسال‌شده
                    </label>
                    <input
                      type="text"
                      id="buyer-code-input"
                      placeholder="کد یک‌بارمصرف"
                      dir="ltr"
                      maxlength="6"
                      class="input input-bordered w-full text-base-content bg-base-100 text-center tracking-widest text-sm rounded-xl"
                    />
                  </div>
                  <button id="btn-verify-otp" class="btn btn-primary w-full btn-sm rounded-full">
                    تأیید و ادامه خرید
                  </button>
                </div>
              </div>

              <div id="checkout-msg" class="mt-3 text-xs hidden"></div>
            </div>
          )}

          <!-- Value Props -->
          <div class="mt-6 pt-5 border-t border-base-200 flex flex-col gap-2.5 text-xs text-base-content/75">
            <div class="flex items-center gap-2">
              <span class="text-success font-bold">✓</span> دسترسی مادام‌العمر به جلسات و آپدیت‌ها
            </div>
            <div class="flex items-center gap-2">
              <span class="text-success font-bold">✓</span> فعال‌سازی خودکار و آنی دسترسی پس از پرداخت
            </div>
            <div class="flex items-center gap-2">
              <span class="text-success font-bold">✓</span> درگاه پرداخت امن بانکی شاپرک (زرین‌پال)
            </div>
            <div class="flex items-center gap-2">
              <span class="text-success font-bold">✓</span> گارانتی بازگشت وجه طبق قوانین کلینیک
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.getElementById('checkout-root');
  if (root) {
    const slug = root.getAttribute('data-slug');
    const checkingEl = document.getElementById('checkout-auth-checking');
    const authedEl = document.getElementById('checkout-authed');
    const unauthedEl = document.getElementById('checkout-unauthed');
    const phoneDisplay = document.getElementById('buyer-phone-display');
    const msgEl = document.getElementById('checkout-msg');

    const phoneInput = document.getElementById('buyer-phone-input') as HTMLInputElement;
    const btnSendOtp = document.getElementById('btn-send-otp') as HTMLButtonElement;
    const stepPhone = document.getElementById('otp-step-phone');

    const codeInput = document.getElementById('buyer-code-input') as HTMLInputElement;
    const btnVerifyOtp = document.getElementById('btn-verify-otp') as HTMLButtonElement;
    const stepVerify = document.getElementById('otp-step-verify');

    const btnStartCheckout = document.getElementById('btn-start-checkout') as HTMLButtonElement;

    function showMessage(text: string, isError = true) {
      if (!msgEl) return;
      msgEl.classList.remove('hidden', 'text-error', 'text-success');
      msgEl.classList.add(isError ? 'text-error' : 'text-success');
      msgEl.textContent = text;
    }

    async function checkBuyerSession() {
      try {
        const res = await fetch('/v1/account/auth/me');
        if (res.ok) {
          const buyer = await res.json();
          if (checkingEl) checkingEl.classList.add('hidden');
          if (authedEl) authedEl.classList.remove('hidden');
          if (unauthedEl) unauthedEl.classList.add('hidden');
          if (phoneDisplay) phoneDisplay.textContent = buyer.phone;
          return;
        }
      } catch {
        // Not logged in
      }
      if (checkingEl) checkingEl.classList.add('hidden');
      if (authedEl) authedEl.classList.add('hidden');
      if (unauthedEl) unauthedEl.classList.remove('hidden');
    }

    checkBuyerSession();

    btnSendOtp?.addEventListener('click', async () => {
      const phone = phoneInput?.value.trim();
      if (!phone) {
        showMessage('لطفاً شماره موبایل را وارد نمایید.');
        return;
      }
      btnSendOtp.disabled = true;
      btnSendOtp.textContent = 'در حال ارسال...';
      try {
        const res = await fetch('/v1/account/auth/otp/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone }),
        });
        const data = await res.json();
        if (res.ok) {
          showMessage('کد تأیید به شماره شما پیامک شد.', false);
          if (stepPhone) stepPhone.classList.add('hidden');
          if (stepVerify) stepVerify.classList.remove('hidden');
        } else {
          showMessage(data.message || 'خطا در ارسال کد تأیید.');
          btnSendOtp.disabled = false;
          btnSendOtp.textContent = 'دریافت کد تأیید ورود';
        }
      } catch {
        showMessage('خطا در برقراری ارتباط با سرور.');
        btnSendOtp.disabled = false;
        btnSendOtp.textContent = 'دریافت کد تأیید ورود';
      }
    });

    btnVerifyOtp?.addEventListener('click', async () => {
      const phone = phoneInput?.value.trim();
      const code = codeInput?.value.trim();
      if (!code) {
        showMessage('لطفاً کد تأیید را وارد نمایید.');
        return;
      }
      btnVerifyOtp.disabled = true;
      btnVerifyOtp.textContent = 'در حال تأیید...';
      try {
        const res = await fetch('/v1/account/auth/otp/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, code }),
        });
        const data = await res.json();
        if (res.ok) {
          showMessage('ورود با موفقیت انجام شد.', false);
          await checkBuyerSession();
        } else {
          showMessage(data.message || 'کد وارد شده نامعتبر است.');
          btnVerifyOtp.disabled = false;
          btnVerifyOtp.textContent = 'تأیید و ادامه خرید';
        }
      } catch {
        showMessage('خطا در برقراری ارتباط با سرور.');
        btnVerifyOtp.disabled = false;
        btnVerifyOtp.textContent = 'تأیید و ادامه خرید';
      }
    });

    btnStartCheckout?.addEventListener('click', async () => {
      btnStartCheckout.disabled = true;
      btnStartCheckout.textContent = 'در حال اتصال به درگاه پرداخت...';
      try {
        const idempotencyKey = 'chk_' + Math.random().toString(36).substring(2, 12);
        const res = await fetch(`/v1/public/courses/${slug}/checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            idempotency_key: idempotencyKey,
            callback_url: window.location.origin + '/callbacks/payments/zarinpal',
          }),
        });
        const data = await res.json();
        if (res.ok && data.payment_url) {
          window.location.href = data.payment_url;
        } else {
          showMessage(data.message || 'خطا در شروع فرایند پرداخت.');
          btnStartCheckout.disabled = false;
          btnStartCheckout.textContent = 'خرید و ثبت‌نام در دوره';
        }
      } catch {
        showMessage('خطا در برقراری ارتباط با سرور پرداخت.');
        btnStartCheckout.disabled = false;
        btnStartCheckout.textContent = 'خرید و ثبت‌نام در دوره';
      }
    });
  }
</script>
