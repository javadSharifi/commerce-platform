---
import { resolveTemplate } from '../templates/registry.js';
import type {
  HomeHeroVM,
  CourseCardVM,
  WorkshopCardVM,
  BlogCardVM,
} from '../templates/view-models.js';
import type { PublicSiteResponse } from '@psychology/api-client';
import { Button } from '@psychology/ui';

interface Props {
  site: PublicSiteResponse;
  templateId?: string;
  courses?: CourseCardVM[];
  workshops?: WorkshopCardVM[];
  articles?: BlogCardVM[];
}

const { site, templateId, courses, workshops, articles } = Astro.props;
const activeTemplate = resolveTemplate(templateId || site.template_id);
const HomeHeroComponent = activeTemplate.components.HomeHero;
const CourseCardComponent = activeTemplate.components.CourseCard;
const WorkshopCardComponent = activeTemplate.components.WorkshopCard;
const BlogCardComponent = activeTemplate.components.BlogCard;

const heroVM: HomeHeroVM = {
  badgeText: site.name || 'مرکز خدمات روان‌شناختی و مشاوره',
  title: site.title,
  description: site.description,
  primaryCta: {
    label: 'رزرو نوبت مشاوره',
    href: '/booking',
  },
  secondaryCta: {
    label: 'مشاهده دوره‌ها',
    href: '/courses',
  },
};

// Fallback demo items when rendered standalone or without explicit datasets
const demoCourses: CourseCardVM[] = [
  {
    id: 'demo-c1',
    slug: 'anxiety-management',
    title: 'دوره جامع مدیریت استرس و اضطراب فراگیر',
    instructorName: site.name || 'متخصص روان‌شناسی بالینی',
    priceLabel: '۱,۲۵۰,۰۰۰ تومان',
    lessonsCountLabel: '۸ جلسه',
    coverUrl: null,
  },
  {
    id: 'demo-c2',
    slug: 'communication-skills',
    title: 'دوره مهارت‌های ارتباط موثر و حل تعارض',
    instructorName: site.name || 'متخصص روان‌شناسی بالینی',
    priceLabel: '۹۸۰,۰۰۰ تومان',
    lessonsCountLabel: '۶ جلسه',
    coverUrl: null,
  },
];

const demoWorkshops: WorkshopCardVM[] = [
  {
    id: 'demo-w1',
    title: 'کارگاه عملی خودآگاهی و مدیریت هیجان',
    instructorName: site.name || 'متخصص روان‌شناسی بالینی',
    priceLabel: '۶۵۰,۰۰۰ تومان',
    dateLabel: '۱۵ آذر ۱۴۰۵',
    capacityLabel: 'ظرفیت باقیمانده: ۴ نفر',
    coverUrl: null,
  },
];

const demoArticles: BlogCardVM[] = [
  {
    id: 'demo-b1',
    slug: 'self-awareness-and-emotional-regulation',
    title: 'نقش خودآگاهی و تنظیم هیجان در روابط بین‌فردی',
    excerpt: 'بررسی راهکارهای علمی و روان‌شناختی جهت تقویت خودآگاهی و بهبود مهارت‌های ارتباطی در زندگی روزمره.',
    dateLabel: '۲۴ آبان ۱۴۰۵',
    coverUrl: null,
  },
];

const resolvedCourses = courses !== undefined ? courses : demoCourses;
const resolvedWorkshops = workshops !== undefined ? workshops : demoWorkshops;
const resolvedArticles = articles !== undefined ? articles : demoArticles;

const hasContactInfo = Boolean(site.phone || site.address);
---

<!-- 1. Hero Section -->
<HomeHeroComponent {...heroVM} />

<!-- 2. Core Specialty Areas (حوزه‌های خدمات و مشاوره) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="specialties-heading">
  <div class="mb-8">
    <h2 id="specialties-heading" class="text-2xl sm:text-3xl font-bold text-base-content tracking-tight">
      حوزه‌های تخصصی و خدمات
    </h2>
    <p class="text-sm sm:text-base text-base-content/70 mt-1 max-w-prose">
      ارائه خدمات تشخیصی و درمانی مبتنی بر رویکردهای شناختی-رفتاری و طرحواره‌درمانی
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="card bg-base-100 p-6 rounded-2xl border border-base-300 shadow-xs hover:border-primary/40 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-base-content mb-2">مشاوره و درمان فردی</h3>
      <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
        بهبود الگوهای رفتاری، تقویت اعتماد به نفس و خودشناسی عمیق.
      </p>
    </div>

    <div class="card bg-base-100 p-6 rounded-2xl border border-base-300 shadow-xs hover:border-primary/40 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-base-content mb-2">مدیریت اضطراب و استرس</h3>
      <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
        تکنیک‌های عملی آرام‌سازی ذهن، کاهش نشخوار فکری و مهار پانیک.
      </p>
    </div>

    <div class="card bg-base-100 p-6 rounded-2xl border border-base-300 shadow-xs hover:border-primary/40 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-base-content mb-2">زوج‌درمانی و تعارضات</h3>
      <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
        تقویت صمیمیت عاطفی، حل اختلافات بین‌فردی و گفتگوی همدلانه.
      </p>
    </div>

    <div class="card bg-base-100 p-6 rounded-2xl border border-base-300 shadow-xs hover:border-primary/40 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-base-content mb-2">توسعه و رشد فردی</h3>
      <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed">
        کشف پتانسیل‌های شخصی، هدف‌گذاری واقع‌بینانه و تاب‌آوری روانی.
      </p>
    </div>
  </div>
</section>

<!-- 3. Featured Courses Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="courses-heading">
  <div class="flex items-center justify-between gap-4 mb-8">
    <div>
      <h2 id="courses-heading" class="text-2xl sm:text-3xl font-bold text-base-content tracking-tight">
        دوره‌های آموزشی منتخب
      </h2>
      <p class="text-sm text-base-content/70 mt-1">آموزش‌های ویدیویی تخصصی برای ارتقای سلامت روان</p>
    </div>
    {resolvedCourses.length > 0 && (
      <a href="/courses" class="text-xs sm:text-sm font-semibold text-primary hover:underline shrink-0">
        مشاهده همه دوره‌ها &larr;
      </a>
    )}
  </div>

  {resolvedCourses.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {resolvedCourses.map((c) => (
        <CourseCardComponent {...c} />
      ))}
    </div>
  ) : (
    <div class="rounded-2xl p-8 bg-base-200/50 border border-base-300 text-center text-base-content/60 text-sm">
      در حال حاضر دوره‌ای برای ثبت‌نام ارائه نشده است.
    </div>
  )}
</section>

<!-- 4. Featured Workshops Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="workshops-heading">
  <div class="flex items-center justify-between gap-4 mb-8">
    <div>
      <h2 id="workshops-heading" class="text-2xl sm:text-3xl font-bold text-base-content tracking-tight">
        کارگاه‌های تخصصی
      </h2>
      <p class="text-sm text-base-content/70 mt-1">کارگاه‌های تعاملی با ظرفیت مشخص و پرسش و پاسخ</p>
    </div>
    {resolvedWorkshops.length > 0 && (
      <a href="/workshops" class="text-xs sm:text-sm font-semibold text-primary hover:underline shrink-0">
        مشاهده همه کارگاه‌ها &larr;
      </a>
    )}
  </div>

  {resolvedWorkshops.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {resolvedWorkshops.map((w) => (
        <WorkshopCardComponent {...w} />
      ))}
    </div>
  ) : (
    <div class="rounded-2xl p-8 bg-base-200/50 border border-base-300 text-center text-base-content/60 text-sm">
      در حال حاضر کارگاه فعالی برای ثبت‌نام وجود ندارد.
    </div>
  )}
</section>

<!-- 5. Featured Blog Articles Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="blog-heading">
  <div class="flex items-center justify-between gap-4 mb-8">
    <div>
      <h2 id="blog-heading" class="text-2xl sm:text-3xl font-bold text-base-content tracking-tight">
        تازه‌ترین مقالات و یادداشت‌ها
      </h2>
      <p class="text-sm text-base-content/70 mt-1">مطالب آموزشی و علمی در حوزه سلامت ذهن</p>
    </div>
    {resolvedArticles.length > 0 && (
      <a href="/blog" class="text-xs sm:text-sm font-semibold text-primary hover:underline shrink-0">
        مشاهده همه مقالات &larr;
      </a>
    )}
  </div>

  {resolvedArticles.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {resolvedArticles.map((a) => (
        <BlogCardComponent {...a} />
      ))}
    </div>
  ) : (
    <div class="rounded-2xl p-8 bg-base-200/50 border border-base-300 text-center text-base-content/60 text-sm">
      مقاله‌ای منتشر نشده است.
    </div>
  )}
</section>

<!-- 6. Booking Callout & Contact Section (فراخوان نوبت و پذیرش) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20" aria-labelledby="booking-cta-heading">
  <!-- Booking Callout Card -->
  <div class="bg-base-200/80 rounded-3xl p-8 sm:p-12 border border-base-300 flex flex-col md:flex-row items-center justify-between gap-8 mb-10">
    <div class="text-start max-w-xl">
      <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold mb-3">
        درخواست وقت مشاوره
      </span>
      <h2 id="booking-cta-heading" class="text-2xl sm:text-3xl font-extrabold text-base-content mb-3 leading-snug">
        جلسه معارفه و رزرو وقت مشاوره حضوری یا آنلاین
      </h2>
      <p class="text-sm sm:text-base text-base-content/75 leading-relaxed">
        برای انتخاب زمان مناسب و دریافت نوبت تخصصی، می‌توانید به صورت برخط سانس مدنظر خود را رزرو کنید.
      </p>
    </div>
    <div class="shrink-0 w-full sm:w-auto">
      <a href="/booking" class="block w-full sm:w-auto text-center">
        <Button variant="primary" className="btn-lg rounded-full px-8 shadow-none w-full sm:w-auto">
          رزرو نوبت مشاوره
        </Button>
      </a>
    </div>
  </div>

  <!-- Contact & Access Details (Rendered only when valid phone or address exists) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-base-100 rounded-2xl p-6 sm:p-8 border border-base-300 shadow-xs">
      <h3 class="text-base sm:text-lg font-bold text-base-content mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>اطلاعات تماس و نشانی</span>
      </h3>
      {hasContactInfo ? (
        <div class="space-y-3 text-sm text-base-content/80">
          {site.phone && (
            <p>
              تلفن تماس: <span class="font-bold text-base-content dir-ltr inline-block">{site.phone}</span>
            </p>
          )}
          {site.address && (
            <p class="leading-relaxed">
              نشانی: <span class="font-medium text-base-content">{site.address}</span>
            </p>
          )}
        </div>
      ) : (
        <p class="text-sm text-base-content/65">
          هماهنگی جلسات و نوبت‌دهی به صورت کاملاً برخط از طریق سامانه رزرو سایت انجام می‌شود.
        </p>
      )}
    </div>

    <div class="bg-base-100 rounded-2xl p-6 sm:p-8 border border-base-300 shadow-xs">
      <h3 class="text-base sm:text-lg font-bold text-base-content mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>ساعات کاری و پذیرش</span>
      </h3>
      <div class="space-y-2 text-sm text-base-content/80">
        <p>شنبه تا چهارشنبه: ۱۴:۰۰ الی ۲۰:۰۰</p>
        <p class="text-xs text-base-content/60 leading-relaxed">
          پذیرش مراجعین با تعیین وقت قبلی انجام می‌شود. برای حفظ آرامش مراجعین، لطفاً ۱۰ دقیقه پیش از موعد در مطب حضور داشته باشید.
        </p>
      </div>
    </div>
  </div>
</section>
