---
import type { PublicSiteResponse } from '@psychology/api-client';
import { Button } from '@psychology/ui';
import { publicImagePath } from '../lib/home.js';
import { resolveTemplate } from '../templates/registry.js';
import type { BlogCardVM, CourseCardVM, HomeHeroVM, WorkshopCardVM } from '../templates/view-models.js';

interface Props {
  site: PublicSiteResponse;
  templateId?: string;
  courses: CourseCardVM[];
  workshops: WorkshopCardVM[];
  articles: BlogCardVM[];
  unavailable: boolean;
}

const { site, templateId, courses, workshops, articles, unavailable } = Astro.props;
const { HomeHero, CourseCard, WorkshopCard, BlogCard } = resolveTemplate(templateId || site.template_id).components;
const profile = site.home_profile;
const specialties = profile?.specialties ?? [];
const credentials = profile?.credentials ?? [];
const hasContact = Boolean(site.phone || site.address || profile?.office_hours);

const hero: HomeHeroVM = {
  badgeText: site.name,
  title: site.title,
  description: site.description,
  portraitUrl: publicImagePath(profile?.portrait_media_id),
  portraitAlt: site.name,
  primaryCta: { label: 'رزرو نوبت مشاوره', href: '/booking' },
  secondaryCta: courses.length ? { label: 'مشاهده دوره‌ها', href: '/courses' } : undefined,
};
---

<HomeHero {...hero} />

{specialties.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="specialties-heading">
    <h2 id="specialties-heading" class="mb-8 text-2xl sm:text-3xl font-bold">حوزه‌های تخصصی</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {specialties.map(item => (
        <li class="card bg-base-100 rounded-2xl border border-base-300 p-6">
          <h3 class="text-base font-semibold">{item}</h3>
        </li>
      ))}
    </ul>
  </section>
)}

{unavailable && (
  <p class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-base-content/75">
    نمایش برخی محتواها موقتاً در دسترس نیست.
  </p>
)}

{courses.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="courses-heading">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h2 id="courses-heading" class="text-2xl sm:text-3xl font-bold">دوره‌های آموزشی</h2>
      <a class="link link-primary" href="/courses">همه دوره‌ها</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {courses.map(course => <CourseCard {...course} />)}
    </div>
  </section>
)}

{workshops.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="workshops-heading">
    <div class="rounded-3xl border border-base-300 bg-base-200 p-6 md:p-10">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h2 id="workshops-heading" class="text-2xl sm:text-3xl font-bold">کارگاه‌های پیش‌رو</h2>
        <a class="link link-primary" href="/workshops">همه کارگاه‌ها</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {workshops.map(workshop => <WorkshopCard {...workshop} />)}
      </div>
    </div>
  </section>
)}

{(profile?.introduction || credentials.length > 0) && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="about-heading">
    <div class:list={['grid items-start gap-8', profile?.introduction && credentials.length ? 'md:grid-cols-2' : '']}>
      {profile?.introduction && (
        <div>
          <h2 id="about-heading" class="mb-4 text-2xl sm:text-3xl font-bold">درباره {site.name}</h2>
          <p class="whitespace-pre-line text-base leading-loose text-base-content/75">{profile.introduction}</p>
        </div>
      )}
      {credentials.length > 0 && (
        <div class="card bg-base-100 rounded-2xl border border-base-300 p-6">
          <h2 id={profile?.introduction ? undefined : 'about-heading'} class="mb-3 text-lg font-semibold">مدارک و سوابق حرفه‌ای</h2>
          <ul class="list-disc space-y-2 ps-5 text-sm text-base-content/75">
            {credentials.map(item => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

{articles.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="blog-heading">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h2 id="blog-heading" class="text-2xl sm:text-3xl font-bold">تازه‌ترین نوشته‌ها</h2>
      <a class="link link-primary" href="/blog">همه نوشته‌ها</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map(article => <BlogCard {...article} />)}
    </div>
  </section>
)}

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16" aria-labelledby="booking-cta-heading">
  <div class="rounded-3xl bg-primary text-primary-content px-6 py-10 md:py-14 text-center">
    <h2 id="booking-cta-heading" class="mb-5 text-2xl sm:text-3xl font-bold">درخواست نوبت مشاورهٔ حضوری</h2>
    <form action="/booking" method="get">
      <Button type="submit" className="rounded-full border-0 bg-primary-content text-primary hover:bg-base-200">
        مشاهدهٔ نوبت‌ها
      </Button>
    </form>
  </div>
  {hasContact && (
    <dl class="mt-6 grid gap-5 rounded-2xl border border-base-300 bg-base-200 p-6 sm:grid-cols-3">
      {site.phone && <div><dt class="font-semibold">تلفن مطب</dt><dd class="mt-1"><bdi dir="ltr">{site.phone}</bdi></dd></div>}
      {site.address && <div><dt class="font-semibold">نشانی</dt><dd class="mt-1">{site.address}</dd></div>}
      {profile?.office_hours && (
        <div><dt class="font-semibold">ساعت کاری مطب</dt><dd class="mt-1 whitespace-pre-line">{profile.office_hours}</dd></div>
      )}
    </dl>
  )}
</section>
